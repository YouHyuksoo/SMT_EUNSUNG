 retrieve="  SELECT  'SPI'   WORKSTAGENAME ,
         ~"IQ_MACHINE_INSPECT_SPI~".~"CSTID~",   
         ~"IQ_MACHINE_INSPECT_SPI~".~"SEQ_NO~",   
         ~"IQ_MACHINE_INSPECT_SPI~".~"PID~",   
         ~"IQ_MACHINE_INSPECT_SPI~".~"RUN_NO~",   
         ~"IQ_MACHINE_INSPECT_SPI~".~"EQUIPMENTID~",   
         ~"IQ_MACHINE_INSPECT_SPI~".~"INSPECT_DATE~",  
         ~"IQ_MACHINE_INSPECT_SPI~".~"RESULT~",    
         ~"IQ_MACHINE_INSPECT_SPI~".~"DEFECT_CODE~",    
         ~"IP_PRODUCT_2D_BARCODE~".~"RUN_NO~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"MAGAZINE_NO~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"BOX_NO~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"PALLETE_NO~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"CUSTOMER_MODEL_NAME~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"MAGAZINE_DATE~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"SHIFT_CODE~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"MASK_LOT_NO~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"SQUEEZE_LOT_NO~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"SOLDER_LOT_NO~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"LONGTERM_YN~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"QC_SCAN_DATE~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"MODEL_NAME~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"LOT_QTY~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"LINE_CODE~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"RUN_DATE~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"WORKSTAGE_CODE~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"IS_PROGRESS~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"C_WORKSTAGE_CODE~"  
       
    FROM ~"IQ_MACHINE_INSPECT_SPI~",   
             ~"IP_PRODUCT_2D_BARCODE~"  
   WHERE  iq_machine_inspect_spi.pid = ip_product_2d_barcode.serial_no (+) 
       AND  ~"IQ_MACHINE_INSPECT_SPI~".~"INSPECT_DATE~"      >= :arg_dateset 
       AND  ~"IQ_MACHINE_INSPECT_SPI~".~"INSPECT_DATE~"      <   :arg_dateend   
       AND  ~"IQ_MACHINE_INSPECT_SPI~".~"LINE_CODE~"            IN ( :arg_line_code ) 
       AND  ~"IQ_MACHINE_INSPECT_SPI~".~"ORGANIZATION_ID~" =   :arg_org 

/*

UNION ALL


  SELECT 'AOI'     WORKSTAGENAME ,
         ~"IQ_MACHINE_INSPECT_AOI~".~"CSTID~",   
         ~"IQ_MACHINE_INSPECT_AOI~".~"SEQ_NO~",   
         ~"IQ_MACHINE_INSPECT_AOI~".~"PID~",   
         ~"IQ_MACHINE_INSPECT_AOI~".~"RUN_NO~",   
         ~"IQ_MACHINE_INSPECT_AOI~".~"EQUIPMENTID~",   
         ~"IQ_MACHINE_INSPECT_AOI~".~"INSPECT_DATE~",   
         ~"IQ_MACHINE_INSPECT_AOI~".~"RESULT~",    
         ~"IQ_MACHINE_INSPECT_AOI~".~"DEFECT_CODE~",    
         ~"IP_PRODUCT_2D_BARCODE~".~"RUN_NO~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"MAGAZINE_NO~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"BOX_NO~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"PALLETE_NO~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"CUSTOMER_MODEL_NAME~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"MAGAZINE_DATE~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"SHIFT_CODE~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"MASK_LOT_NO~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"SQUEEZE_LOT_NO~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"SOLDER_LOT_NO~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"LONGTERM_YN~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"QC_SCAN_DATE~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"MODEL_NAME~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"LOT_QTY~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"LINE_CODE~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"RUN_DATE~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"WORKSTAGE_CODE~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"IS_PROGRESS~",   
         ~"IP_PRODUCT_2D_BARCODE~".~"C_WORKSTAGE_CODE~"  
  
    FROM ~"IQ_MACHINE_INSPECT_AOI~",   
              ~"IP_PRODUCT_2D_BARCODE~"  
   WHERE IQ_MACHINE_INSPECT_AOI.pid = ip_product_2d_barcode.serial_no (+)
        AND ~"IQ_MACHINE_INSPECT_AOI~".~"INSPECT_DATE~"     >= :arg_dateset 
        AND ~"IQ_MACHINE_INSPECT_AOI~".~"INSPECT_DATE~"     <   :arg_dateend 
        AND ~"IQ_MACHINE_INSPECT_AOI~".~"LINE_CODE~"            IN ( :arg_line_code ) 
        AND ~"IQ_MACHINE_INSPECT_AOI~".~"ORGANIZATION_ID~" = :arg_org 

*/" arguments=(("arg_dateset", string),("arg_dateend", string),("arg_line_code", stringlist),("arg_org", number))  sort="workstagename D iq_machine_inspect_spi_inspect_date A " )
