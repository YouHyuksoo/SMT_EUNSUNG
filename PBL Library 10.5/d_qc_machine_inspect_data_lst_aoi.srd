 retrieve="  SELECT ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"CSTID~",   
         ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"SEQ_NO~",   
         ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"PID~",   
         ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"MACHINE_CODE~",   
         ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"INSPECT_DATE~",   
         ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"RESULT~",   
         ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"DEFECT_CODE~",   
         ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"ENTER_DATE~",   
         ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"ENTER_BY~",   
         ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"LAST_MODIFY_DATE~",   
         ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"LAST_MODIFY_BY~",   
         ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"ORGANIZATION_ID~",   
         ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"FILE_NAME~",   
         ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"ARRAY_NO~"  ,
         ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"RUN_NO~",
         ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"LINE_CODE~",
         ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"REVIEW_DATE~",
         ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"REVIEW_RESULT~",
         F_GET_RUN_MODEL_NAME( ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"RUN_NO~") MODEL_NAME ,
		f_get_customer_model_by_run_no( ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"RUN_NO~") CUSTOMER_MODEL_NAME,
         ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"JOB_FILE~",
         ROWIDTOCHAR(rowid)   row_pos
    FROM ~"IQ_MACHINE_INSPECT_DATA_AOI~"  
   WHERE ( ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"INSPECT_DATE~" >= TO_CHAR(TRUNC(:ARG_DATESET),'YYYY/MM/DD HH24:MI:SS' ) ) AND  
              ( ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"INSPECT_DATE~" <   TO_CHAR(TRUNC(:ARG_DATEEND)+1 ,'YYYY/MM/DD HH24:MI:SS' )) AND  
              (~"IQ_MACHINE_INSPECT_DATA_AOI~".~"PID~" like :ARG_PID  )   AND 
	     	 (NVL(~"IQ_MACHINE_INSPECT_DATA_AOI~".~"LINE_CODE~",'*') LIKE :ARG_LINE_CODE ) AND
              F_GET_RUN_MODEL_NAME( ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"RUN_NO~") LIKE :ARG_MODEL_NAME  AND
              ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"RUN_NO~"  LIKE :ARG_RUN_NO AND
             NVL( ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"RESULT~" , '*')  LIKE :ARG_RESULT AND
             NVL( ~"IQ_MACHINE_INSPECT_DATA_AOI~".~"REVIEW_RESULT~" , '*')  LIKE :ARG_REVIEW" arguments=(("ARG_DATESET", datetime),("ARG_DATEEND", datetime),("ARG_LINE_CODE", string),("ARG_PID", string),("ARG_MODEL_NAME", string),("ARG_RUN_NO", string),("arg_result", string),("arg_review", string))  sort="run_no A inspect_date A pid A " )
