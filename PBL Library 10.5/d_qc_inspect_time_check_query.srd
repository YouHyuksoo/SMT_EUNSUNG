detail(height=72 color="536870912" )
table(column=(type=datetime updatewhereclause=yes name=inspection_date dbname="iqc_inspection_time_check.inspection_date" )
 column=(type=char(20) updatewhereclause=yes name=line_code dbname="iqc_inspection_time_check.line_code" )
 column=(type=char(30) updatewhereclause=yes name=work_order_no dbname="iqc_inspection_time_check.work_order_no" )
 column=(type=char(50) updatewhereclause=yes name=inspect_group dbname="iqc_inspection_time_check.inspect_group" )
 column=(type=char(100) updatewhereclause=yes name=inspect_group_desc dbname="iqc_inspection_time_check.inspect_group_desc" )
 column=(type=number updatewhereclause=yes name=display_seq dbname="iqc_inspection_time_check.display_seq" )
 column=(type=char(100) updatewhereclause=yes name=inspection_item dbname="iqc_inspection_time_check.inspection_item" )
 column=(type=number updatewhereclause=yes name=organization_id dbname="iqc_inspection_time_check.organization_id" )
 column=(type=number updatewhereclause=yes name=inspection_value_lcl dbname="inspection_value_lcl" )
 column=(type=number updatewhereclause=yes name=inspection_value_ucl dbname="inspection_value_ucl" )
 column=(type=char(10) updatewhereclause=yes name=inspection_unit dbname="inspection_unit" )
 column=(type=number updatewhereclause=yes name=value_x dbname="value_x" )
 column=(type=char(10) updatewhereclause=yes name=result_x dbname="result_x" )
 column=(type=datetime updatewhereclause=yes name=last_modify_date_x dbname="last_modify_date_x" )
 column=(type=char(20) updatewhereclause=yes name=last_modify_by_x dbname="last_modify_by_x" )
 column=(type=number updatewhereclause=yes name=value_y dbname="value_y" )
 column=(type=char(10) updatewhereclause=yes name=result_y dbname="result_y" )
 column=(type=datetime updatewhereclause=yes name=last_modify_date_y dbname="last_modify_date_y" )
 column=(type=char(20) updatewhereclause=yes name=last_modify_by_y dbname="last_modify_by_y" )
 column=(type=number updatewhereclause=yes name=value_z dbname="value_z" )
 column=(type=char(10) updatewhereclause=yes name=result_z dbname="result_z" )
 column=(type=datetime updatewhereclause=yes name=last_modify_date_z dbname="last_modify_date_z" )
 column=(type=char(20) updatewhereclause=yes name=last_modify_by_z dbname="last_modify_by_z" )
 retrieve="    SELECT A.INSPECTION_DATE,
                A.LINE_CODE,
                A.WORK_ORDER_NO,

                A.INSPECT_GROUP,
                A.INSPECT_GROUP_DESC,
                A.INSPECTION_ITEM_SEQ                                               AS DISPLAY_SEQ,
                A.INSPECTION_ITEM,
                A.ORGANIZATION_ID,
                
                MAX(A.INSPECTION_VALUE_LCL)                                     AS INSPECTION_VALUE_LCL,
                MAX(A.INSPECTION_VALUE_UCL)                                    AS INSPECTION_VALUE_UCL,
                MAX(A.INSPECTION_UNIT)                                              AS INSPECTION_UNIT,
                
                MAX(DECODE(CHECK_TIME, 'X', A.INSPECTION_VALUE))    AS VALUE_X,
                MAX(DECODE(CHECK_TIME, 'X', A.INSPECTION_RESULT))  AS RESULT_X,
                MAX(DECODE(CHECK_TIME, 'X', A.LAST_MODIFY_DATE))   AS LAST_MODIFY_DATE_X,
                MAX(DECODE(CHECK_TIME, 'X', A.LAST_MODIFY_BY))       AS LAST_MODIFY_BY_X,

                MAX(DECODE(CHECK_TIME, 'Y', A.INSPECTION_VALUE))    AS VALUE_Y,
                MAX(DECODE(CHECK_TIME, 'Y', A.INSPECTION_RESULT))  AS RESULT_Y,
                MAX(DECODE(CHECK_TIME, 'Y', A.LAST_MODIFY_DATE))   AS LAST_MODIFY_DATE_Y,
                MAX(DECODE(CHECK_TIME, 'Y', A.LAST_MODIFY_BY))       AS LAST_MODIFY_BY_Y,
                
                MAX(DECODE(CHECK_TIME, 'Z', A.INSPECTION_VALUE))    AS VALUE_Z,
                MAX(DECODE(CHECK_TIME, 'Z', A.INSPECTION_RESULT))  AS RESULT_Z,
                MAX(DECODE(CHECK_TIME, 'Z', A.LAST_MODIFY_DATE))   AS LAST_MODIFY_DATE_Z,
                MAX(DECODE(CHECK_TIME, 'Z', A.LAST_MODIFY_BY))       AS LAST_MODIFY_BY_Z                

    FROM IQC_INSPECTION_TIME_CHECK A
 
     WHERE A.ORGANIZATION_ID          = :arg_org_id
       AND A.INSPECTION_DATE            between :arg_sdate and :arg_edate
       AND A.line_CODE                        like :arg_line_code
       AND A.INSPECT_GROUP_DESC     like :arg_model_name
       AND A.WORK_ORDER_NO            like :arg_work_order
       AND A.INSPECTION_YN               = 'Y'            

   GROUP BY  A.INSPECTION_DATE, A.LINE_CODE, A.WORK_ORDER_NO, A.INSPECT_GROUP,  A.INSPECT_GROUP_DESC, A.INSPECTION_ITEM_SEQ, A.INSPECTION_ITEM, A.ORGANIZATION_ID
   ORDER BY  A.INSPECTION_DATE, A.LINE_CODE, A.WORK_ORDER_NO, A.INSPECT_GROUP,  A.INSPECT_GROUP_DESC, A.INSPECTION_ITEM_SEQ, A.INSPECTION_ITEM, A.ORGANIZATION_ID
" arguments=(("arg_org_id", number),("arg_sdate", datetime),("arg_edate", datetime),("arg_line_code", string),("arg_model_name", string),("arg_work_order", string))  sort="inspection_date A work_order_no A display_seq A " )
group(level=1 header.height=0 trailer.height=32 by=("line_code" , "organization_id" ) header.color="536870912" trailer.color="12632256" )
