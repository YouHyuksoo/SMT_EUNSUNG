HA$PBExportHeader$d_product_assy_label_print_runcard_list.srd
release 10.5;
datawindow(units=0 timer_interval=0 color=16777215 processing=1 HTMLDW=no print.printername="" print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.canusedefaultprinter=yes print.prompt=no print.buttons=no print.preview.buttons=no print.cliptext=no print.overrideprintjob=no print.collate=yes print.preview.outline=yes hidegrayline=no grid.lines=0 )
header(height=124 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=108 color="536870912" )
table(column=(type=char(10) updatewhereclause=yes name=line_code dbname="ip_product_run_card.line_code" )
 column=(type=datetime updatewhereclause=yes name=run_date dbname="ip_product_run_card.run_date" )
 column=(type=char(100) updatewhereclause=yes name=model_name dbname="ip_product_run_card.model_name" )
 column=(type=char(30) updatewhereclause=yes key=yes name=run_no dbname="ip_product_run_card.run_no" )
 column=(type=number updatewhereclause=yes name=lot_size dbname="ip_product_run_card.lot_size" )
 column=(type=number updatewhereclause=yes name=print_qty dbname="print_qty" )
 column=(type=char(30) updatewhereclause=yes name=item_code dbname="ip_product_run_card.item_code" )
 column=(type=number updatewhereclause=yes key=yes name=organization_id dbname="ip_product_run_card.organization_id" )
 column=(type=number updatewhereclause=yes name=cart_in_qty dbname="cart_in_qty" )
 retrieve="select  line_code, 
          run_date,  
          model_name, 
          run_no, 
          lot_size,
          (
              select nvl(sum(pack_qty),0)
                from ip_product_pack_master
              where run_no            = r.run_no
                 and organization_id = r.organization_id
          )  as print_qty,
          item_code,
          organization_id,
          (
            SELECT NVL(packing_pcs_qty, 1)       //SELECT NVL(MAGAZINE_SIZE, 1) 
              FROM IP_PRODUCT_MODEL_MASTER 
            WHERE model_name     = r.model_name
                 AND organization_id = r.organization_id
                 AND rownum           = 1
          )  as cart_in_qty
  from ip_product_run_card r
 where run_date           >= :ARG_S_DATE
     and run_date          <   :ARG_E_DATE + 1
     and line_code         like :ARG_LINE_CODE
     and model_name    like :ARG_MODEL_NAME
     and run_no             like :ARG_RUN_NO
     and organization_id = :ARG_ORG_ID
     and line_code in (
                                 select line_code
                                   from ip_product_line
                                 where line_division <> 'D'
                             )
 order by line_code, run_date,  model_name

" update="ip_product_run_card" updatewhere=1 updatekeyinplace=yes arguments=(("ARG_S_DATE", datetime),("ARG_E_DATE", datetime),("ARG_LINE_CODE", string),("ARG_MODEL_NAME", string),("ARG_RUN_NO", string),("ARG_ORG_ID", number))  sort="line_code A run_date A run_no A " )
