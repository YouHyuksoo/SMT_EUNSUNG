 column=(type=char(20) updatewhereclause=yes name=line_code dbname="im_item_solder_input_hist.line_code" )
 column=(type=char(20) updatewhereclause=yes name=machine_code dbname="im_item_solder_input_hist.machine_code" )
 retrieve="  SELECT ~"H~".~"INPUT_DATE~",   
         ~"H~".~"SOLDER_LOT_NO~",   
         ~"H~".~"RUN_NO~",   
         ~"H~".~"ENTER_DATE~",   
         ~"H~".~"ENTER_BY~",   
         ~"H~".~"LAST_MODIFY_DATE~",   
         ~"H~".~"LAST_MODIFY_BY~",   
         ~"H~".~"LINE_CODE~"  ,
         ~"H~".~"MACHINE_CODE~"  
    FROM ~"IM_ITEM_SOLDER_INPUT_HIST~" ~"H~"  
   WHERE ( h.input_date >= :arg_dateset ) AND  
         ( h.input_date < :arg_dateend+1 ) AND  
         ( h.solder_lot_no like :arg_barcode )   AND 
         ( h.machine_code like :arg_machine_code ) 
" arguments=(("arg_barcode", string),("arg_dateset", datetime),("arg_dateend", datetime),("arg_machine_code", string))  sort="line_code A input_date A machine_code A " )
