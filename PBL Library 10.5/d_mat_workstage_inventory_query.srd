 column=(type=char(300) updatewhereclause=yes name=item_spec dbname="id_item.item_spec" )
 column=(type=char(3) updatewhereclause=yes name=item_uom dbname="id_item.item_uom" )
 retrieve="  SELECT   ~"IM_ITEM_WORKSTAGE_INVENTORY~".~"ITEM_CODE~" ,     
        ~"IM_ITEM_WORKSTAGE_INVENTORY~".~"ORGANIZATION_ID~" ,       
        ~"IM_ITEM_WORKSTAGE_INVENTORY~".~"INVENTORY_QTY~" ,        
        ~"IM_ITEM_WORKSTAGE_INVENTORY~".~"ENTER_DATE~" ,  
         ~"IM_ITEM_WORKSTAGE_INVENTORY~".~"ENTER_BY~" ,        
         ~"IM_ITEM_WORKSTAGE_INVENTORY~".~"LAST_MODIFY_DATE~" ,     
         ~"IM_ITEM_WORKSTAGE_INVENTORY~".~"LAST_MODIFY_BY~" ,        
         ~"ID_ITEM~".~"ITEM_NAME~" ,       
         ~"ID_ITEM~".~"ITEM_SPEC~" ,   
        ~"ID_ITEM~".~"ITEM_UOM~" 
    FROM ~"IM_ITEM_WORKSTAGE_INVENTORY~" ,           ~"ID_ITEM~"   
  WHERE ( ~"IM_ITEM_WORKSTAGE_INVENTORY~".~"ITEM_CODE~" = ~"ID_ITEM~".~"ITEM_CODE~" ) and    
      ( ~"IM_ITEM_WORKSTAGE_INVENTORY~".~"ORGANIZATION_ID~" = ~"ID_ITEM~".~"ORGANIZATION_ID~" ) and       
   ( ( ~"IM_ITEM_WORKSTAGE_INVENTORY~".~"ITEM_CODE~" like :arg_item_code ) and      
    ( ~"IM_ITEM_WORKSTAGE_INVENTORY~".~"ORGANIZATION_ID~" = :arg_org ) )  " arguments=(("arg_item_code", string),("arg_org", number))  sort="organization_id A item_code A " )
