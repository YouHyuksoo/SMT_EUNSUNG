table(column=(type=datetime updatewhereclause=yes name=check_date_start dbname="ib_smt_checkhist.check_date_start" )
 column=(type=datetime updatewhereclause=yes name=check_date_end dbname="check_date_end" )
 column=(type=char(30) updatewhereclause=yes name=lot_name dbname="ib_smt_checkhist.lot_name" )
 column=(type=char(200) updatewhereclause=yes name=partname dbname="ib_smt_checkhist.partname" )
 column=(type=char(30) updatewhereclause=yes name=line_code dbname="ib_smt_checkhist.line_code" )
 column=(type=char(100) updatewhereclause=yes name=lot_no dbname="ib_smt_checkhist.lot_no" )
 column=(type=char(10) updatewhereclause=yes name=pcb_item dbname="ib_smt_checkhist.pcb_item" )
 column=(type=char(30) updatewhereclause=yes name=location_code dbname="ib_smt_checkhist.location_code" )
 column=(type=char(10) updatewhereclause=yes name=check_type dbname="ib_smt_checkhist.check_type" )
 column=(type=char(20) updatewhereclause=yes name=trace_code dbname="ib_smt_checkhist.trace_code" )
 column=(type=char(50) updatewhereclause=yes name=vendor_lotno dbname="im_item_receipt_barcode.vendor_lotno" )
 column=(type=char(30) updatewhereclause=yes name=vendor_code dbname="im_item_receipt_barcode.vendor_code" )
 column=(type=char(1000) updatewhereclause=yes name=our_barcode_origin dbname="ib_smt_checkhist.our_barcode_origin" )
 column=(type=char(1000) updatewhereclause=yes name=supplier_barcode_origin dbname="ib_smt_checkhist.supplier_barcode_origin" )
 column=(type=datetime updatewhereclause=yes name=ccs_end_date dbname="ib_smt_checkhist.ccs_end_date" )
 retrieve="SELECT   a.check_date check_date_start,
         f_get_check_data_end (a.line_code , a.lot_name , a.partname , a.location_code , a.lot_no , a.check_date )  check_date_end,
         a.lot_name,
         a.partname,
         a.line_code,
         a.lot_no,
         a.pcb_item,
         a.location_code,
		a.check_type ,
		a.trace_code , 
		b.vendor_lotno , 
		b.vendor_code ,
		a.our_barcode_origin ,
		a.supplier_barcode_origin ,
		a.ccs_end_date
  FROM ib_smt_checkhist a  , im_item_receipt_barcode b
 WHERE a.lot_no = b.lot_no(+)
      and a.lot_no = :arg_lot_no
      and a.check_type in ( 1, 2 )
      and a.check_status = 'P'





 
