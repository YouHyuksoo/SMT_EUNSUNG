 column=(type=char(20) updatewhereclause=yes name=last_modify_by dbname="ip_product_model_master.last_modify_by" )
 column=(type=datetime updatewhereclause=yes name=last_modify_date dbname="ip_product_model_master.last_modify_date" )
 column=(type=number updatewhereclause=yes key=yes name=organization_id dbname="ip_product_model_master.organization_id" )
 retrieve="select model_name, item_code, customer_code, customer_name, last_modify_by, last_modify_date, organization_id
  from ip_product_model_master
where model_name     like :arg_model_name
   and  item_code         like :arg_item
   and organization_id  = :arg_org_id
" update="ip_product_model_master" updatewhere=0 updatekeyinplace=no arguments=(("arg_model_name", string),("arg_item", string),("arg_org_id", number))  sort="organization_id A model_name A " )
