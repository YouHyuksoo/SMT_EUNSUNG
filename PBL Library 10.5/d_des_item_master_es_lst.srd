 column=(type=char(20) update=yes updatewhereclause=yes name=enter_by dbname="id_item_es.enter_by" dbalias=".enter_by" )
 column=(type=datetime update=yes updatewhereclause=yes name=last_modify_date dbname="id_item_es.last_modify_date" dbalias=".last_modify_date" )
 column=(type=char(20) update=yes updatewhereclause=yes name=last_modify_by dbname="id_item_es.last_modify_by" dbalias=".last_modify_by" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=organization_id dbname="id_item_es.organization_id" dbalias=".organization_id" )
 retrieve="  SELECT item_code, 
              item_name, 
              es_item_type, 
              customer_code, 
              part_no, 
              item_spec, 
              enter_date, 
              enter_by, 
              last_modify_date, 
              last_modify_by, 
              organization_id
    FROM ID_ITEM_ES
  WHERE item_code        like :arg_item_code
       AND es_item_type   like :arg_item_type
       AND customer_code like :arg_customer_code
       AND organization_id =   :arg_org_id
       AND item_spec       like :arg_item_spec
" update="ID_ITEM_ES" updatewhere=0 updatekeyinplace=no arguments=(("arg_item_code", string),("arg_item_type", string),("arg_customer_code", string),("arg_org_id", number),("arg_item_spec", string)) )
