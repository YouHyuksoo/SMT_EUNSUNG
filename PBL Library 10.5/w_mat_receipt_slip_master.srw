public function integer wf_receipt_barcode (string arg_type);lvs_supplier_barcode  =sle_supplier_barcode.text
lvs_our_barcode         =sle_our_barcode.text
lvs_inventory_type = ddlb_inventory_type.getcode()
lvs_coating_date   = em_coating_date.text // $$HEX16$$a0b0dcc915d6ddc23cc75cb82000c0bc58d6200058d5ecc52000f1b45db82000$$ENDHEX$$

//========================================
//
//========================================
if lvs_inventory_type = '' or isnull(lvs_inventory_type) then 
			sle_slip_no.setfocus()
			sle_slip_no.selecttext( 1,100)
			F_MSG( "$$HEX16$$acc7e0ac20c715d674c7200020c1ddd018b4c0c920004ac558c5b5c2c8b2e4b2$$ENDHEX$$" , 'P')
			return -1
end if 
//=======================================
// 
//=======================================
	SELECT  f_get_item_code_from_barcode_s (:lvs_supplier_barcode , :lvs_supplier_code) 
	INTO :lvs_supplier_item_code
	FROM DUAL ; 
	
	IF F_SQL_CHECK() < 0 THEN 
		sle_supplier_barcode.selecttext( 1,100)	
	END IF 	 

//==================================================
//  $$HEX14$$f5ac09aec1c0200014bc54cfdcb42000a4c294ce2000b4cc6cd02000$$ENDHEX$$
//==================================================
if lvs_supplier_barcode = '' then 
	sle_supplier_barcode.setfocus()
	sle_supplier_barcode.selecttext( 1,100)
	f_play_sound("$$HEX8$$70ac98b798cc14bc54cfdcb4a4c294ce$$ENDHEX$$.wav")	
	st_status.text = F_MSG( "$$HEX19$$70ac98b798cc200014bc54cfdcb400ac2000a4c294ce18b4c0c920004ac558c5b5c2c8b2e4b2$$ENDHEX$$" , 'S')
	f_msgbox(173)
	return -1
end if 

//==================================================
// $$HEX13$$90c7acc0200014bc54cfdcb42000a4c294ce2000b4cc6cd02000$$ENDHEX$$
//==================================================
if lvs_our_barcode = '' then 
	sle_our_barcode.setfocus()
	sle_our_barcode.selecttext( 1,100)
	f_play_sound("$$HEX7$$90c7acc014bc54cfdcb4a4c294ce$$ENDHEX$$.wav")	
	st_status.text =  F_MSG("$$HEX18$$90c7acc0200014bc54cfdcb400ac2000a4c294ce18b4c0c920004ac558c5b5c2c8b2e4b2$$ENDHEX$$" , 'S')
	f_msgbox(173)
	return -1
end if 

//==================================================
//  $$HEX19$$d9b37cc7200014bc54cfdcb47cb92000a4c294ce200088d594b2c0c92000b4cc6cd020002000$$ENDHEX$$
//  
//==================================================

if cbx_ignore_sup_bcd.checked = true then 
else
		if lvs_supplier_barcode = lvs_our_barcode then 
			st_status.text = F_MSG("$$HEX19$$d9b37cc75cd5200014bc54cfdcb47cb92000a4c294ce200058d574ba200048c529b4c8b2e4b2$$ENDHEX$$" , 'S')
			f_play_sound("$$HEX9$$d9b37cc714bc54cfdcb4a4c294ce24c658b9$$ENDHEX$$.wav")
			sle_our_barcode.setfocus()
			sle_our_barcode.selecttext( 1,100)
			f_msgbox(173)
			return -1 
		end if 
end if 
//==================================================
//  $$HEX6$$88d4a9ba200054cfdcb42000$$ENDHEX$$
//==================================================
//lvi_pos1 =  pos(lvs_our_barcode , '-' , 7 ) 
//
//if  lvi_pos1 <= 0 then 
//	f_msgbox1(1175 ,lvs_our_barcode )
//	sle_our_barcode.setfocus()
//	sle_our_barcode.selecttext( 1,100)
//	return -1 
//end if 

	SELECT  f_get_item_code_from_barcode (:lvs_our_barcode) 
	INTO :lvs_item_code
	FROM DUAL ; 
	
	IF F_SQL_CHECK() < 0 THEN 
		sle_our_barcode.selecttext( 1,100)	
	END IF 	 

if  len(lvs_item_code) <= 0 then 
	f_msgbox1(1175 ,lvs_our_barcode )
	sle_our_barcode.setfocus()
	sle_our_barcode.selecttext( 1,100)
	return -1 
end if 	


if f_check_item_exists( lvs_item_code , f_t_sysdate())  <= 0 then 
	
	f_play_sound("$$HEX5$$88d4a9baf8bbf1b45db8$$ENDHEX$$.wav")
	f_msgbox(9041) //$$HEX10$$fcd3a9bac8b9a4c230d12000f8bbf1b45db82000$$ENDHEX$$
	st_status.text = lvs_item_code+' $$HEX9$$fcd3a9bac8b9a4c230d12000f8bbf1b45db8$$ENDHEX$$'
	
	sle_our_barcode.setfocus()
	sle_our_barcode.selecttext( 1,100)	
	
	return -1
end if 

//==================================================
// $$HEX6$$6fb8b8d2200088bc38d62000$$ENDHEX$$
//==================================================

	SELECT  F_GET_LOT_NO_FROM_BARCODE (:lvs_our_barcode ) 
	INTO :lvs_lot_no
	FROM DUAL ; 
	
	IF F_SQL_CHECK() < 0 THEN 
		sle_our_barcode.selecttext( 1,100)	
	END IF 	 


if lvs_lot_no = ''  then 
	st_status.text =  F_MSG("$$HEX15$$6fb8b8d288bc38d600ac20002cc614bc74b9c0c920004ac5b5c2c8b2e4b2$$ENDHEX$$" , 'S')
	
	sle_our_barcode.setfocus()
	sle_our_barcode.selecttext( 1,100)	
	f_msgbox(173)
	return -1
end if 

////==========================================
////IQC $$HEX11$$80acacc0200030ae00c920002000b4cc6cd020002000$$ENDHEX$$
