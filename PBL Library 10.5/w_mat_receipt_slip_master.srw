end event

event ue_post_open;call super::ue_post_open;/****************************************
* $$HEX15$$08c7c4b358c7d0c5200000b35cd5200004d55cb87cd3f0d2200024c115c8$$ENDHEX$$
*****************************************/
WF_SET_WINDOW_PROPERTY(this.classname())
sle_lot_no.setfocus()
st_status.text = 'Ready.'
st_status.width = dw_1.width + dw_2.width

dw_6.settransobject(sqlca)
f_set_column_dddw(dw_6)

dw_7.settransobject(sqlca)
f_set_column_dddw(dw_7)

dw_8.settransobject(sqlca)
f_set_column_dddw(dw_8)

dw_9.settransobject(sqlca)
f_set_column_dddw(dw_9)
sle_qty.enabled = false

//====================================
// $$HEX22$$acb9ecd3b8d2200000adacb9d0c52000f1b45db818b4b4c5200088c73cc774ba200014bcd4af00c9e4b22000$$ENDHEX$$
//====================================

STRING ls_syntax

ls_syntax = ''
ls_syntax	=	f_get_dataobject('REPORT', upper(THIS.CLASSNAME()) ,  string( dw_5.dataobject )	)

if	ls_syntax = '' or isnull(ls_syntax) then
	
	f_msg_mdi_help("Report Not Changed")
	
else
	
	dw_5.create(ls_syntax)
	dw_5.settransobject(sqlca)
	f_set_column_dddw(dw_5)
	f_dual_lang_change_dwtext(dw_5)
	f_msg_mdi_help("Report Changed")
	
end if	

//====================================
// $$HEX22$$acb9ecd3b8d2200000adacb9d0c52000f1b45db818b4b4c5200088c73cc774ba200014bcd4af00c9e4b22000$$ENDHEX$$
//====================================

ls_syntax = ''
ls_syntax	=	f_get_dataobject('REPORT', upper(THIS.CLASSNAME()) ,  string( dw_7.dataobject )	)

if	ls_syntax = '' or isnull(ls_syntax) then
	
	f_msg_mdi_help("Report Not Changed")
	
else
	
	dw_7.create(ls_syntax)
	dw_7.settransobject(sqlca)
	f_set_column_dddw(dw_7)
	f_dual_lang_change_dwtext(dw_7)
	f_msg_mdi_help("Report Changed")
	
end if	

//==================================
//
//==================================

if gvs_slip_process = 'N' then 

	rb_normal_slip.triggerevent( clicked!)
	rb_normal_slip.checked = true 
	
elseif gvs_slip_process = 'X' then 
	
	rb_no_slip_no_receipt.triggerevent( clicked!)
	rb_no_slip_no_receipt.checked = true 
	
elseif gvs_slip_process = 'R' then 
	
	rb_no_slip_auto_receipt.triggerevent( clicked!)
	rb_no_slip_auto_receipt.checked = true 
	
elseif gvs_slip_process = 'M' then 
	
	rb_no_slip_manual_receipt.triggerevent( clicked!)
	rb_no_slip_manual_receipt.checked = true 
	
end if 

//$$HEX10$$68d5b5c27cb7a8bc20001cbc89d52000ecc580bd$$ENDHEX$$($$HEX2$$20c731c1$$ENDHEX$$2$$HEX4$$f5aca5c7acc0a9c6$$ENDHEX$$)
if Gvs_msl_label_print = 'Y' then
   cbx_msl.checked = true
else	
   cbx_msl.checked = false
end if

if Gvs_unit_price_check_yn = 'Y' then
   cbx_check_unit_price.checked = true
else
   cbx_check_unit_price.checked = false
end if

	

end event

event ue_data_control;call super::ue_data_control;string lvs_date
double lvd_seq
Decimal  lvd_qty, lvd_packing_qty, lvd_request_qty, lvd_issue_qty
choose case gvs_ue_data_control
		
	case 'RETRIEVE'
		
			dw_1.reset()
			dw_2.reset()
			dw_1.retrieve( uo_dateset.text() , uo_dateend.text(),    ddlb_item_code.text() + '%',  sle_slip_no_condition.text+'%' , ddlb_receipt_type.getcode()+'%'  , ddlb_barcode_status.GETCODE()+'%' ,  gvi_organization_id)
			
			sle_lot_no.text = ''
			sle_lot_no.setfocus()
			st_status.text = 'Waitting'
	 
     case 'INSERT'
		
					LVL_ROW = DW_1.INSERTROW(1)
					DW_1.SCROLLTOROW(LVL_ROW)
					F_SET_SECURITY_ROW(DW_1 , LVL_ROW ,'ALL')
	
	case 'UPDATE'
		
			IF dw_1.UPDATE() < 0   or dw_2.update()  < 0 THEN 
				ROLLBACK;
				RETURN					
			ELSE
				COMMIT;
				F_MSG_MDI_HELP( "Update Complete" )//$$HEX14$$31c1f5ac01c83cc75cb8200000c8a5c7200018b4c8c5b5c2c8b2e4b2$$ENDHEX$$"
				sle_lot_no.setfocus()		 
			END IF

	case else
end choose

end event

event clicked;call super::clicked;sle_lot_no.setfocus()
end event

event resize;call super::resize;st_status.width = dw_1.width + dw_2.width
end event

