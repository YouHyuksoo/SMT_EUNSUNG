	st_status.text = F_MSG( "$$HEX4$$fcc828cc94b22000$$ENDHEX$$4$$HEX7$$90c7acb9200085c7c8b2e4b22000$$ENDHEX$$(YYWW)" ,'S')
	f_msg("$$HEX4$$fcc828cc94b22000$$ENDHEX$$4$$HEX7$$90c7acb9200085c7c8b2e4b22000$$ENDHEX$$(YYWW)" , 'P') 
	
