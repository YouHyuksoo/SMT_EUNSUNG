event modified;call super::modified;string  lvs_item_code_barcode  ,  lvs_reel_qty , lvs_totla_qty , lvs_mark
datetime lvdt_receipt_date

ivi_error =  0 
cbx_manual_slip.CHecked = false


dw_2.reset()
//=========================================================================
//
//=========================================================================
if ddlb_supplier_code.getcode() = '' or ddlb_supplier_code.getcode() = '*' or ddlb_supplier_code.getcode() = '%' then 
	
	st_status.text = F_MSG( "$$HEX11$$70ac98b798cc7cb9200020c1ddd0200058d538c194c6$$ENDHEX$$." , 'S')
	f_play_sound("$$HEX9$$70ac98b798cc7cb920c1ddd058d538c194c6$$ENDHEX$$.wav")
	
	this.text = ''	
	ddlb_supplier_code.setfocus()
	ivi_error = -1 
	return -1
end if 

lvl_receipt_sequence =    LONG(f_get_any_no( 'SEQ_RECEIPT_SLIP') )

lvs_item_code_barcode = sle_lot_no.text
lvdt_receipt_date         = f_sysdate()

if len(this.text) <0 or isnull(this.text) or sle_lot_no.text ='' then
	ivi_error = -1 
	return -1
	sle_lot_no.setfocus()
end if
//======================================================
//  $$HEX25$$6dd5a9ba6cad84bd90c77cb920000cd345c574d51cc1200018c2d9b378c7c0c9200090c7d9b378c7c0c920006cad84bd2000$$ENDHEX$$
//  $$HEX21$$18c2d9b37cc72000bdacb0c62000200084bd60d5200018c2c9b744c7200018c2d9b32000f1b45db82000$$ENDHEX$$
//======================================================
	int lvl_pos2  

     lvl_check_Pos =  pos(lvs_item_code_barcode , "+" , 7 ) 
	  
	 if lvl_check_Pos > 0 then 
		lvs_mark = "+"
		cbx_manual_slip.checked = false
	else
		lvl_check_Pos =  pos(lvs_item_code_barcode , "," , 1 ) 
		 if lvl_check_Pos > 0 then 
			lvs_mark = ","
			cbx_manual_slip.checked = true
		end if 
	 end if 


IF lvs_mark = '' OR ISNULL(lvs_mark) THEN 
		sle_lot_no.setfocus()
		sle_lot_no.selecttext( 1,100)	
		RETURN 
END IF 

//if rb_normal.checked = false and 	 lvs_mark = "+" then 
//		f_play_sound("$$HEX6$$85c7e0ac20c715d624c658b9$$ENDHEX$$.wav")	    
//		sle_lot_no.setfocus()
//		sle_lot_no.selecttext( 1,100)	
//		return 
//end if 
	 
//====================================================	 
//	 
//====================================================
     lvl_pos1 =  pos(lvs_item_code_barcode , lvs_mark , 7 ) 
	  
	if  lvl_pos1 <= 0 then 
		f_play_sound("$$HEX6$$98c7bbba1cb414bc54cfdcb4$$ENDHEX$$.wav")			
		f_msgbox1(1175 ,lvs_item_code_barcode )
		sle_lot_no.text = ''	
		sle_lot_no.setfocus()
		sle_lot_no.selecttext( 1,100)
	    ivi_error = -1 
		return -1
	end if 
	  
	lvs_item_code =   trim( mid( lvs_item_code_barcode , 1 ,   lvl_pos1  -1 ))
	
	
	if f_check_item_exists( lvs_item_code , f_t_sysdate())  < 1 then 
		
   	   f_play_sound("$$HEX6$$98c7bbba1cb414bc54cfdcb4$$ENDHEX$$.wav")		
	   f_msgbox(9041)	
	   sle_lot_no.text = ''	
	   sle_lot_no.setfocus()
	   sle_lot_no.selecttext( 1,100)		
	   ivi_error = -1 
	   return -1
	end if 

     sle_item_code.text = lvs_item_code
  
	lvl_pos2 =  pos(lvs_item_code_barcode , lvs_mark, lvl_pos1+1 ) 
	
	if  lvl_pos2 <= 0 then 
		f_play_sound("$$HEX6$$98c7bbba1cb414bc54cfdcb4$$ENDHEX$$.wav")
		f_msgbox1(1175 ,lvs_item_code_barcode )
		
		sle_item_code.text  = ''
		sle_lot_no.text = ''	
		sle_lot_no.setfocus()
		sle_lot_no.selecttext( 1,100)		
		ivi_error = -1 
		return -1
	end if 	
	
	lvs_reel_qty =    trim(mid( lvs_item_code_barcode ,  lvl_pos1+1   ,  lvl_pos2 -lvl_pos1 -1 ))
	sle_reel_qty.text = lvs_reel_qty
	
	//===================================================
	// $$HEX4$$1dcd18c2c9b72000$$ENDHEX$$
	//===================================================
	lvs_totla_qty =   trim( mid( lvs_item_code_barcode ,  lvl_pos2+1   ,  len(lvs_item_code_barcode) - lvl_pos2 ))
	
	if  long(lvs_totla_qty) <= 0 then 
		f_play_sound("$$HEX6$$98c7bbba1cb414bc54cfdcb4$$ENDHEX$$.wav")
		f_msgbox1(1175 ,lvs_item_code_barcode )
		sle_item_code.text  = ''
		sle_reel_qty.text = ''
		 sle_lot_no.text = ''	
		sle_lot_no.setfocus()		
		sle_lot_no.selecttext( 1,100)
		ivi_error = -1 
		return -1
	end if 	
	
	sle_total_qty.text = lvs_totla_qty	

//=====================================================
// $$HEX14$$30ae00c918c2c9b7200080bd69d52000ecc580bd2000b4cc6cd02000$$ENDHEX$$
//=====================================================
// long lvl_material_qty , lvl_material_qty2 , lvl_material_qty3
 
//select nvl(material_qty,0) , nvl(material_qty2 ,0) , nvl(material_qty3 ,0) 
//   into :lvl_material_qty , :lvl_material_qty2 , :lvl_material_qty3
// from id_item 
//where item_code =  :lvs_item_code
//    and organization_id = :gvi_organization_id  ;
//
//if f_sql_check() < 0 then 
//	ivi_error = -1 
//	return -1
//end if 

wf_set_material_qty() 

//======================================================
//  $$HEX9$$15c818c22000ecc580bd2000b4cc6cd02000$$ENDHEX$$
//  $$HEX22$$15c818c200ac200044c5c8b274ba200090c7d9b33cc75cb8200018c2d9b385c7e0ac20003dcc1dd3c5c52000$$ENDHEX$$
//======================================================
 if mod(  Long(lvs_totla_qty) , long(lvs_reel_qty) ) > 0 then 
	cbx_manual_slip.checked = true 		
ELSE
	//===========================================
	// $$HEX5$$e8b204c718c2c9b72000$$ENDHEX$$
	//===========================================
	sle_unit_qty.text = string( Long(lvs_totla_qty) / long(lvs_reel_qty) )
	cbx_manual_slip.CHecked = false
end if 

sle_material_qty1.text =string( lvl_material_qty)
sle_material_qty2.text =string( lvl_material_qty2)
sle_material_qty3.text =string( lvl_material_qty3)	
//======================================================
//  $$HEX23$$30ae00c9200018c2c9b7fcac2000c0d2b4b9bdacb0c6200018c2d9b3200085c725b820003dcc200024c608d52000$$ENDHEX$$
//  $$HEX10$$ecc5ecb71cac2000b4b9200074c774ba1cc12000$$ENDHEX$$
//======================================================
if cbx_check_material_qty.checked = true then 
	if long(sle_unit_qty.text) <> lvl_material_qty and  long(sle_unit_qty.text) <> lvl_material_qty2 and long(sle_unit_qty.text) <> lvl_material_qty3 and  long(lvs_reel_qty) <> 1  then 
		cbx_manual_slip.checked = true
	end if 
end if 
//====================================================	 
//	 $$HEX19$$18c2d9b37cc7bdacb0c6200084bd60d518c2c9b7200085c725b820003dcc20001dd3c5c52000$$ENDHEX$$
//====================================================	 
if cbx_manual_slip.checked = true then 

		 ivl_divide_qty = {0}
		 openwithparm (w_mat_slip_manual_qty_popup ,lvs_totla_qty )   
		 
		 if  Upperbound(ivl_divide_qty) = 0  then		
			st_status.text = F_MSG( "Divide Qty Invalid" ,'S')
			sle_lot_no.text = ''
			sle_lot_no.setfocus()
			sle_lot_no.selecttext( 1,100)		
			sle_slip_no.text = ''
			ivi_error = -1 
			return -1
		elseif Upperbound(ivl_divide_qty) = 1 and ivl_divide_qty[1] = 0 then 
			st_status.text = F_MSG( "Divide Qty Invalid" , 'S')
			sle_lot_no.text = ''
			sle_lot_no.setfocus()
			sle_lot_no.selecttext( 1,100)		
			sle_slip_no.text = ''
			ivi_error = -1 
			return -1			
		end if 
		
end if 

sle_slip_no.text = ''
sle_slip_no.setfocus()

end event

type sle_slip_no from so_singlelineedit within w_mat_receipt_slip_master
integer x = 475
integer y = 616
integer width = 928
integer height = 100
integer taborder = 70
boolean bringtotop = true
integer textsize = -10
long backcolor = 16777215
textcase textcase = upper!
end type

event modified;call super::modified;int lvi_Pos
long lvl_return_qty
string LVS_SYS_WEEK, lvs_material_qty, lvs_item_supplier, lvs_choose_supplier

//================================================
//
//================================================
if this.text = '' or isnull(this.text) then 
		sle_slip_no.setfocus( )
		ivi_error = -1 
		return 
else
	lvs_slip_no_origin = this.text
	lvs_inventory_type = ddlb_inventory_type.getcode() // $$HEX9$$acc7e0ac200020c715d6200091c5b0c02000$$ENDHEX$$/ $$HEX3$$d8c00cd52000$$ENDHEX$$
end if 

//================================================
//$$HEX12$$15c8c1c001c878c72000acc2bdb9200078c785acb0c62000$$ENDHEX$$
//================================================
if rb_normal_slip.checked = true then 
		wf_ok_slip_receipt()		
		return 
end if 
	
//==================================================
// $$HEX18$$04c85cd4c6c574c7200098ccacb9200058d594b2bdacb0c6ccb92000e4b4b4c534c62000$$ENDHEX$$
//==================================================
     lvs_supplier_barcode = this.text
//=================================================
//
//=================================================
 
		
				lvs_slip_no = lvs_slip_no_origin
				lvs_supplier = ddlb_supplier_code.getcode()
				lvs_supplier_barcode = ''
			     lvs_supplier_barcode = trim(lvs_slip_no_origin )
				
				lvs_item_code = ''
				lvl_material_qty = 0 
				lvl_material_qty2 = 0  
				lvl_material_qty3 = 0 
	
				sle_material_qty1.text = ''
				sle_material_qty2.text = ''
				sle_material_qty3.text = '' 				
				
				//==================================================
				// $$HEX7$$f5ac09aec1c02000b4cc6cd02000$$ENDHEX$$
				//==================================================
				if lvs_supplier = '%' then
					F_MSG('Supplier Code Check' ,'S') 
					ddlb_supplier_code.setfocus()
					this.text = ''
					sle_supplier_lot_no.text =''
					sle_origin_supplier_code.text = ''
					ivi_error = -1 
					return 
				end if 
				//==================================================
				
				if  len(lvs_slip_no_origin) < 5 then 
					this.text = '' 
					sle_supplier_lot_no.text =''
					sle_origin_supplier_code.text = ''
					F_MSG(  "Barcode Invalid" , 'P' )
					return 
				end if 

				//=======================================
				// 
				// $$HEX16$$14bc54cfdcb47cb9200084bd74d5200074d51cc1200088d4a9ba98ccacb92000$$ENDHEX$$
				//=======================================
				   
						SELECT  F_GET_ITEM_CODE_FROM_BARCODE_S (:lvs_supplier_barcode , :lvs_supplier_code )
						INTO :lvs_supplier_item_code 
						FROM DUAL ; 
						
						IF F_SQL_CHECK() < 0 THEN 
							this.text = ''	
							sle_supplier_lot_no.text =''
							sle_origin_supplier_code.text = ''
						END IF 	 
						
					//===============================================
					// $$HEX25$$f5ac09aec1c0200088d488bc20003cc75cb8200070c88cd6200074d51cc120005ccd85c8200088d488bc2000e8cd9ccd2000$$ENDHEX$$
					//===============================================

						lvs_item_class = '' 
						
						SELECT ITEM_CODE , item_class , auto_receipt_yn, material_qty, NVL(supplier_code, '*')
						   INTO :lvs_item_code	, :lvs_item_class , :lvs_auto_receipt_yn, :lvs_material_qty, :lvs_item_supplier
					 	 FROM ID_ITEM 
						WHERE ITEM_CODE = :lvs_supplier_item_code 
						     AND ORGANIZATION_ID = :GVI_ORGANIZATION_ID ;	
				
						IF F_SQL_CHECK() < 0 THEN 
								sle_lot_no.text = ''	
								sle_item_code.text = ''
								this.text = ''
								sle_supplier_lot_no.text =''
								sle_origin_supplier_code.text = ''
								sle_slip_no.setfocus()
								ivi_error = -1 
								return  
						END IF 	
						
						
						// $$HEX30$$20c1ddd05cd52000f5ac09aec1c0fcac200088d4a9ba58c72000fcc870ac98b720c174c72000d9b37cc774d57cc52000ccb920009ccd25b800aca5b2$$ENDHEX$$
						
						IF ( lvs_supplier <> lvs_item_supplier ) then
							
					          F_MSG(  "$$HEX26$$20c1ddd05cd52000f5ac09aeacc040c62000a4c294ce200088d4a9ba2000fcc870ac98b720c174c72000e4b285b9c8b2e4b22000$$ENDHEX$$=> " + lvs_supplier + ' / ' + lvs_item_supplier , 'P' )
						     sle_slip_no.setfocus()
					          return 
								 
						END IF

						//===============================================
						// $$HEX25$$f5ac09aec1c0200088d488bc20003cc75cb8200070c88cd6200074d51cc120005ccd85c8200088d488bc2000e8cd9ccd2000$$ENDHEX$$
						//===============================================
						sle_item_code.text = lvs_item_code	
						//================================================
						if f_check_item_exists( lvs_item_code , f_t_sysdate())  < 1 then 
							f_play_sound("$$HEX6$$98c7bbba1cb414bc54cfdcb4$$ENDHEX$$.wav")		
							f_msgbox(9041)	
							sle_lot_no.text = ''	
							this.text = ''
							sle_item_code.text = ''
							sle_supplier_lot_no.text =''
							sle_origin_supplier_code.text = ''
							sle_slip_no.setfocus()
							ivi_error = -1 
							return 
						end if 

					//==========================================
					// PCB $$HEX6$$ecc580bd200055d678c72000$$ENDHEX$$
					//==========================================
					
					  if lvs_item_class = 'PCB'  then 
				
						         sle_week.text = ''
								sle_week.setfocus()
								
					elseif   lvs_item_class = 'RANKLED'  then 
				
						         sle_rankled.text = ''
								sle_rankled.setfocus()
						
					else
						
							//	SELECT TO_CHAR( SYSDATE , 'YYWW')
							//	  INTO :LVS_SYS_WEEK 
							//	  FROM DUAL ;
								  
							//	  sle_week.text = LVS_SYS_WEEK 
							   	  // em_creator_qty.setfocus( )
                            
								  sle_week.text = ''
							      sle_week.setfocus()
					end if 				
					
					
					
					//======================================
					//
					//======================================

					
					//======================================
					// $$HEX18$$85c7e0ac18c2c9b744c7200090c7d9b33cc75cb8200024c115c858d594b2bdacb0c62000$$ENDHEX$$
					//======================================					
					if cbx_check_material_qty.checked = true then 	
						
									SELECT  material_qty , material_qty2 , material_qty3 
									INTO :lvl_material_qty , :lvl_material_qty2  ,:lvl_material_qty3
									FROM ID_ITEM 
									WHERE  ITEM_CODE =:lvs_supplier_item_code
									   AND ORGANIZATION_ID = :GVI_ORGANIZATION_ID ;	
							
									IF F_SQL_CHECK() < 0 THEN 
											sle_lot_no.text = ''	
											sle_item_code.text = ''
											this.text = ''
											sle_supplier_lot_no.text =''
											sle_origin_supplier_code.text = ''
											sle_slip_no.setfocus()
											ivi_error = -1 
											return  
									END IF 		
												
										sle_material_qty1.text =string( lvl_material_qty)
										sle_material_qty2.text =string( lvl_material_qty2)
										sle_material_qty3.text =string( lvl_material_qty3)	
			
										if lvl_material_qty <> 0 and  lvl_material_qty2 = 0 and lvl_material_qty3 = 0  then 
											
											em_creator_qty.setfocus( )
											em_creator_qty.text = string(lvl_material_qty) 
											
										//	em_creator_qty.triggerevent(modified!)
										//  $$HEX6$$85c7e0ac200098ccacb92000$$ENDHEX$$
										//	wf_no_slip_receipt()
										//	sle_slip_no.setfocus( )
											return 

										//=====================================
										// $$HEX23$$18c2c9b774c7200050b41cac74c7c1c0200088c73cc774ba200020c1ddd02000200058d58cac20005cd5e4b22000$$ENDHEX$$
										//=====================================
										elseif  lvl_material_qty <> 0 and  lvl_material_qty2 <> 0 then 
			
												openwithparm( w_mat_new_item_set_msl_location_popup ,  lvs_item_code ) 
												if long(message.stringparm) > 0  then 
													em_creator_qty.setfocus( )
													em_creator_qty.text =message.stringparm
													//===================================
													// $$HEX6$$85c7e0ac200098ccacb92000$$ENDHEX$$
													//===================================
										   	     // em_creator_qty.triggerevent(modified!)
												//	wf_no_slip_receipt()
												//	sle_slip_no.setfocus( )
													return 
												end if 
										end if 
					else
						
						sle_unit_qty.text = lvs_material_qty
										
					end if 
end event

event getfocus;call super::getfocus;st_status.text = f_msg("$$HEX12$$acc2bdb988bc38d67cb92000a4c294ce200058d538c194c6$$ENDHEX$$" , 'S' )
f_play_sound("$$HEX6$$acc2bdb988bc38d6a4c294ce$$ENDHEX$$.wav")
end event

