//		end if 
//END IF 

//==================================================
//  $$HEX6$$85c7e0ac200018c2c9b72000$$ENDHEX$$
//==================================================

	SELECT  TO_NUMBER( F_GET_LOT_QTY_FROM_BARCODE (:lvs_our_barcode ) )
	INTO :lvl_receipt_qty
	FROM DUAL ; 
	
	
	IF F_SQL_CHECK() < 0 THEN 
		sle_our_barcode.selecttext( 1,100)	
	END IF 	 


if lvl_receipt_qty <=0 then 
	
	f_play_sound("$$HEX4$$18c2c9b724c658b9$$ENDHEX$$.wav")	
	st_status.text = F_MSG( "$$HEX15$$85c7e0ac18c2c9b774c720002cc614bc74b9c0c920004ac5b5c2c8b2e4b2$$ENDHEX$$"	 , 'S')
	sle_our_barcode.setfocus()
	sle_our_barcode.selecttext( 1,100)	
	f_msgbox(173)
	return -1
end if 

//=========================================================
//  $$HEX21$$f5ac09aec1c0200014bc54cfdcb4200040c6200090c7acc0200088d4a9ba54cfdcb4200044be50ad2000$$ENDHEX$$
//=========================================================

//				 SELECT ITEM_CODE 
//					  INTO :lvs_itemcode_me
//					 FROM ID_ITEM 
//				 WHERE ITEM_CODE = :lvs_supplier_item_code 
//						 AND ORGANIZATION_ID = :GVI_ORGANIZATION_ID ;	
//                   
//				lvi_pos_check = pos( lvs_itemcode_me ,  lvs_item_code , 1 ) 


		lvi_pos_check = pos( lvs_supplier_item_code ,  lvs_item_code , 1 ) 

	
				if lvi_pos_check <= 0 then 
						f_play_sound("$$HEX5$$90c7acc788bd7cc758ce$$ENDHEX$$.wav")
						st_status.text = F_MSG("$$HEX16$$fcd3a9ba88bc38d600ac20007cc758ce200058d5c0c920004ac5b5c2c8b2e4b2$$ENDHEX$$" , 'S')
						sle_supplier_barcode.text = ''
						sle_our_barcode.text  = ''
						sle_supplier_barcode.setfocus()
						f_msgbox(173)
						return -1
				end if 
//=========================================================
//  $$HEX11$$85c7e0ac200098ccacb9200004d55cb838c1a4c22000$$ENDHEX$$
//=========================================================

lvl_receipt_lot_no         = LONG(f_get_any_no( 'RECEIPT_LOT_NO') )
lvs_line_type                = f_get_line_type_from_item( lvs_item_code )
lvs_supplier_lot_no       = sle_supplier_lot_no.text
lvs_origin_supplier_code= sle_origin_supplier_code.text



//==================================================
// $$HEX12$$74c7f8bb74c8acc7200058d594b2c0c92000b4cc6cd02000$$ENDHEX$$
//==================================================

SELECT RECEIPT_SLIP_NO, 
            NVL(SUPPLIER_CODE ,'*'), 
		   NVL(RECEIPT_COMPARE_YN , 'N')  , 
            NVL(RECEIPT_TYPE,'N') , 
		   FROM_SUPPLIER_CODE ,
		   MANUFACTURE_DATE,
		   MANUFACTURE_WEEK
			
   INTO :LVS_SLIP_NO , :lvs_supplier_code , :LVS_RECEIPT_COMPARE_YN  , :LVS_RECEIPT_TYPE , :LVS_FROM_SUPPLIER_CODE ,
	       :LVDT_MANUFACTURE_DATE ,
		   :LVS_MANUFACTURE_WEEK
  FROM IM_ITEM_RECEIPT_BARCODE
 WHERE ITEM_CODE = :LVS_ITEM_CODE
     AND LOT_NO = :LVS_LOT_NO
      AND ORGANIZATION_ID = :GVI_ORGANIZATION_ID ;

IF F_SQL_CHECK() < 0 THEN 
	sle_our_barcode.setfocus( )
	sle_our_barcode.text = ''	
	st_status.text = LVS_OUR_BARCODE+ F_MSG(' SLIP $$HEX15$$a4c294ce200074c725b8d0c5200024c658b900ac200088c7b5c2c8b2e4b2$$ENDHEX$$', 'S')
	
//	if cbx_show_error_msg.checked = true then 
		f_msgbox(173)
//	end if 	
	return -1 
END IF 

IF LVS_MANUFACTURE_WEEK = '' OR ISNULL(LVS_MANUFACTURE_WEEK) THEN 
	LVS_MANUFACTURE_WEEK = SLE_WEEK.TEXT  // $$HEX3$$fcc828cc2000$$ENDHEX$$
END IF 

if  LVS_SLIP_NO = ''  then	
	
	f_play_sound("$$HEX6$$acc2bdb974c725b8c6c54cc7$$ENDHEX$$.wav")	
	st_status.text = LVS_OUR_BARCODE+ F_MSG(' SLIP $$HEX11$$a4c294ce200074c725b874c72000c6c5b5c2c8b2e4b2$$ENDHEX$$', 'S')
	sle_our_barcode.text = ''
	sle_supplier_lot_no.text = ''
	sle_origin_supplier_code.text = ''
	sle_our_barcode.setfocus( )

//	if cbx_show_error_msg.checked = true then 
		f_msgbox(173)
//	end if 	
	
	return -1
end if 

if LVS_RECEIPT_COMPARE_YN = 'Y'  then
	f_play_sound("$$HEX5$$74c7f8bb74c8acc768d5$$ENDHEX$$.wav")
	st_status.text =  F_MSG('$$HEX11$$74c7f8bb200085c7e0ac200018b4c8c5b5c2c8b2e4b2$$ENDHEX$$', 'S')
	sle_our_barcode.setfocus( )
	sle_our_barcode.text = ''
	sle_supplier_lot_no.text = ''
	sle_origin_supplier_code.text = ''
	
	//if cbx_show_error_msg.checked = true then 
		f_msgbox(173)
//	end if 	
	
	return -1
	
end if 

//====================================================
// $$HEX13$$85c7e0ac200044c6ccb820000cd598b7f8ad200024c115c82000$$ENDHEX$$
//====================================================
	UPDATE IM_ITEM_RECEIPT_BARCODE
         SET RECEIPT_COMPARE_YN = 'Y' ,
				RECEIPT_COMPARE_DATE = SYSDATE  , 
				RECEIPT_COMPARE_BY = :GVS_USER_ID , 
				SUPPLIER_BARCODE = :lvs_supplier_barcode ,
				RETURN_YN = 'N' ,
				RETURN_DATE = NULL ,
				VENDOR_LOTNO = :lvs_supplier_lot_no,
				VENDOR_CODE  = :lvs_origin_supplier_code
     WHERE  ITEM_CODE = :LVS_ITEM_CODE
          AND LOT_NO = :lvs_lot_no
          AND ORGANIZATION_ID = :GVI_ORganization_id ;
			 
     if f_sql_check() <  0 then 
		sle_our_barcode.setfocus()
		sle_our_barcode.selecttext( 1,100)
		return -1 
	end if 
	
	if cbx_check_unit_price.checked = true then 
	
			lvd_unit_price = f_get_item_unit_price_confirm(lvs_supplier_code,lvs_item_code , lvs_line_type , f_t_sysdate())
			
			if isnull(lvd_unit_price)   then
				f_msgbox1( 9086 , lvs_item_code )
				sle_our_barcode.setfocus()
				sle_our_barcode.selecttext( 1,100)				
				return -1
			end if
	else
	 	lvd_unit_price = 1 // f_get_item_unit_price_confirm(lvs_supplier_code,lvs_item_code , lvs_line_type , f_t_sysdate())
	end if ;
		
		
			lvl_receipt_sequence = F_GET_SEQUENCE('SEQ_MAT_RECEIPT')
			
			INSERT INTO IM_ITEM_RECEIPT  
							( RECEIPT_SEQUENCE,   
							  RECEIPT_DATE,   
							  ORGANIZATION_ID,   
							  LOCATION_CODE,   
							  DELIVERY,   
							  RECEIPT_DEFICIT,   
							  LINE_TYPE,   
							  RECEIPT_QTY,   
							  MATERIAL_COST,   
							  UNIT_PRICE,   
							  MATERIAL_COST_AMT,   
							  ENTER_DATE,   
							  INVOICE_NO,   
							  RECEIPT_AMT,   
							  ENTER_BY,   
							  EXCHANGE_RATE,   
							  FOREIGN_RECEIPT_AMT,   
							  SUPPLIER_CODE,   
							  LAST_MODIFY_DATE,   
							  LAST_MODIFY_BY,   
							  CONFIRM_YN,   
							  CONFIRM_DATE,   
							  RECEIPT_TYPE,   
							  MFS,   
							  ARRIVAL_DATE,   
							  ARRIVAL_SEQ_NO,   
							  VIRTUAL_RECEIPT_YN,   
							  COMMENTS,   
							  WORK_ORDER_NO,   
							  CURRENCY,   
							  BARCODE,   
							  RECEIPT_STATUS,   
							  ITEM_CODE,   
							  MATERIAL_MFS,   
							  INTERFACE_YN,   
							  INTERFACE_DATE,   
							  RECEIPT_LOT_NO,   
							  RECEIPT_EXPENSE_COST,   
							  INCIDENTAL_EXPENSE_CODE,   
							  INTERFACE_WORK_NO,   
							  TARIFF_RATE,   
							  TARIFF_AMT,   
							  ORDER_NO,   
							  ORIGIN_MFS,   
							  ORIGIN_SUPPLIER_CODE,   
							  ORDER_TYPE,   
							  CONFIRM_BY,   
							  SUBCONTRACT_INVOICE_NO,   
							  INVOICE_OPEN_YN,   
							  INVOICE_OPEN_SEQUENCE,   
							  CLOSE_YN,   
							  CLOSE_DATE,
							  FROM_SUPPLIER_CODE ,
							  MANUFACTURE_WEEK ,
							  INVENTORY_TYPE ,
							  PCB_COATING_DATE ,
							  MANUFACTURE_DATE)  
							  
					 VALUES( :lvl_receipt_sequence ,      //RECEIPT_SEQUENCE,   
							  TRUNC(SYSDATE),      //RECEIPT_DATE,   
							  1,      //ORGANIZATION_ID,   
							   'M01',      //LOCATION_CODE,   
							  1,      //DELIVERY,   
							  1,      //RECEIPT_DEFICIT,   
							  :lvs_line_type ,      //LINE_TYPE,   
							  :lvl_receipt_qty ,      //RECEIPT_QTY,   
							  0,      //MATERIAL_COST,   
							  :lvd_unit_price ,      //UNIT_PRICE,   
							  0,      //MATERIAL_COST_AMT,   
							  sysdate,      //ENTER_DATE,   
							  :lvs_slip_no ,      //INVOICE_NO,   
							  :lvl_receipt_qty * :lvd_unit_price,      //RECEIPT_AMT,   
							  :GVS_USER_ID ,      //ENTER_BY,   
							  1,      //EXCHANGE_RATE,   
							  0,      //FOREIGN_RECEIPT_AMT,   
							  :LVS_SUPPLIER_CODE ,      //SUPPLIER_CODE,   
							  SYSDATE,      //LAST_MODIFY_DATE,   
							  :GVS_USER_ID ,      //LAST_MODIFY_BY,   
							  'N',      //CONFIRM_YN,   
							  TRUNC(SYSDATE),      //CONFIRM_DATE,   
							  :LVS_RECEIPT_TYPE,      //RECEIPT_TYPE,   
							  :lvs_supplier_lot_no,      //MFS,   
							  NULL,      //ARRIVAL_DATE,   
							  0,      //ARRIVAL_SEQ_NO,   
							  'N',      //VIRTUAL_RECEIPT_YN,   
							  '*',      //COMMENTS,   
							  NULL,      //WORK_ORDER_NO,   
							  'WON',      //CURRENCY,   
							  :LVS_OUR_BARCODE,      //BARCODE,   
							  'N',      //RECEIPT_STATUS,   
							  :LVS_ITEM_CODE ,      //ITEM_CODE,   
							 :lvs_lot_no,      //MATERIAL_MFS,   
							  'N',      //INTERFACE_YN,   
							  NULL,      //INTERFACE_DATE,   
							  :LVL_RECEIPT_LOT_NO ,      //RECEIPT_LOT_NO,   
							  0,      //RECEIPT_EXPENSE_COST,   
							  '*',      //INCIDENTAL_EXPENSE_CODE,   
							  NULL,      //INTERFACE_WORK_NO,   
							  0,      //TARIFF_RATE,   
							  0,      //TARIFF_AMT,   
							  0,      //ORDER_NO,   
							  :lvs_supplier_barcode,      //ORIGIN_MFS,   
							  :lvs_origin_supplier_code ,      //ORIGIN_SUPPLIER_CODE,   
							  'M',      //ORDER_TYPE,   
							  :gvs_user_id,      //CONFIRM_BY,   
							  NULL,      //SUBCONTRACT_INVOICE_NO,   
							  'N',      //INVOICE_OPEN_YN,   
							  0,      //INVOICE_OPEN_SEQUENCE,   
							  'N',      //CLOSE_YN,   
							  NULL ,
							  :LVS_FROM_SUPPLIER_CODE,
							  :LVS_MANUFACTURE_WEEK,
							  :LVS_INVENTORY_TYPE,
							  TO_DATE(:LVS_COATING_DATE, 'YYYY-MM-DD'),
							  :LVDT_MANUFACTURE_DATE 
							 )      //CLOSE_DATE
						  ;
						 
			 if  f_sql_check() < 0 then
				f_play_sound("$$HEX4$$00c8a5c7e4c228d3$$ENDHEX$$.wav")
				st_status.text = F_MSG('$$HEX18$$85c7e0ac98ccacb9200011c9200024c658b900ac20001cbcddc0200088d5b5c2c8b2e4b2$$ENDHEX$$' , 'S')
				sle_supplier_barcode.text=''
				sle_our_barcode.text=''
				sle_slip_no.text = ''
				sle_lot_no.text = ''
				em_creator_qty.text = ''
				sle_our_barcode.text = ''
				sle_supplier_lot_no.text = ''
				sle_origin_supplier_code.text = ''
				sle_supplier_barcode.setfocus()
				
				//if cbx_show_error_msg.checked = true then 
					f_msgbox(173)
				//end if 				
				
				return -1
			end if
			
//commit; $$HEX7$$15bcd0c51cc12000e4ce0bbc2000$$ENDHEX$$

//==============================================
//
//==============================================

	lvl_row = dw_4.insertrow(1)
	dw_4.object.origin_mfs[lvl_row] = lvs_supplier_barcode
	dw_4.object.item_code[lvl_row] = lvs_item_code
	dw_4.object.receipt_qty[lvl_row] = lvl_receipt_qty
	dw_4.object.material_mfs[lvl_row] = lvs_lot_no
//==============================================
//
//==============================================
f_play_sound("$$HEX4$$00c8a5c731c1f5ac$$ENDHEX$$.wav")
st_status.text = F_MSG( '$$HEX10$$15c8c1c098ccacb9200018b4c8c5b5c2c8b2e4b2$$ENDHEX$$' ,'S')
sle_supplier_lot_no.text = ''
sle_origin_supplier_code.text = ''
sle_our_barcode.text = ''
sle_supplier_barcode.text = ''
sle_slip_no.text = ''
sle_lot_no.text = ''
sle_reel_qty.text = ''
em_creator_qty.text = ''


if cbx_single_receipt.checked = true then 	
	sle_slip_no.setfocus()
end if

return  1

end function

public subroutine wf_ok_slip_receipt ();//===================================
//$$HEX22$$15c8c1c001c878c7200004c85cd45cb8200098ccacb958d594b22000bdacb0c6ccb92000e4b4b4c534c62000$$ENDHEX$$
//$$HEX24$$39d6dcc2200004c85cd488bc38d6d0c5200088d4a9ba44c72000a4c294ce200088d544c74cae10bd2000b4cc6cd02000$$ENDHEX$$
//===================================
lvl_check_Pos =  pos( sle_slip_no.text , "+" , 1 ) 

if lvl_check_Pos > 0 then 
	
	sle_slip_no.setfocus( )
	sle_slip_no.text = ''
	sle_supplier_lot_no.text =''
	sle_origin_supplier_code.text = ''
	st_status.text = F_MSG( "$$HEX16$$04c85cd4200088bc38d6200000ac200098c7bbba200018b4c8c5b5c2c8b2e4b2$$ENDHEX$$" , 'S')
	ivi_error = -1 
	return 
end if 
	
lvl_check_Pos =  pos( sle_slip_no.text , "," , 1 ) 

//	//==================================================
//	// $$HEX12$$d8c5c0c920009ccde0ac200074c725b8200070c88cd62000$$ENDHEX$$
//	//==================================================
//	
//	dw_3.retrieve( sle_slip_no.text )
//	if dw_3.rowcount() < 1 then 
//		F_PLAY_SOUND("scanfailed.wav")
//	end if 
	
	//==================================================
	//
	//==================================================
	
	if f_check_slip_exists( sle_slip_no.text)  > 0 then
		st_status.text = "NG"
		f_play_sound( "Eixst.wav")
		f_msgbox1(813 , sle_slip_no.text) 
		sle_lot_no.text = ''
		sle_supplier_lot_no.text =''
		sle_origin_supplier_code.text = ''
		sle_lot_no.setfocus()
		ivi_error = -1 
		return 
	end if 
	
	//==================================================
	// $$HEX13$$acc2bdb9200015c8f4bc7cb92000ddc031c120005cd5e4b22000$$ENDHEX$$.
	//==================================================
	LVL_ROW = 0 
	f_insert()
	
	LVDB_SLIP_RCV_SEQ  = F_GET_SEQUENCE('SEQ_RECEIPT_SLIP')
	
	dw_1.object.receipt_date[LVL_ROW]         = f_t_sysdate()
	dw_1.object.receipt_sequence[LVL_ROW] = LVDB_SLIP_RCV_SEQ
	dw_1.object.item_code[LVL_ROW]            = sle_item_code.text
	dw_1.object.reel_qty[LVL_ROW]               = long(sle_reel_qty.text)
	dw_1.object.receipt_unit_qty[LVL_ROW]    = long(sle_unit_qty.text)
	dw_1.object.receipt_sum_qty[LVL_ROW]   = long(sle_total_qty.text)
	dw_1.object.receipt_barcode[LVL_ROW]    = sle_lot_no.text  //$$HEX15$$acc2bdb9d0c51cc12000a4c294ce5cd5200015c8f4bc200088d4a9ba2000$$ENDHEX$$+ $$HEX2$$b4b92000$$ENDHEX$$+ $$HEX4$$1dcd18c2c9b72000$$ENDHEX$$
	dw_1.object.receipt_slip_no[LVL_ROW]     = sle_slip_no.text
	dw_1.object.receipt_status[LVL_ROW]       = 'N'
	dw_1.object.supplier_code[LVL_ROW]         = ddlb_supplier_code.getcode()
	dw_1.object.from_supplier_code[LVL_ROW] = ddlb_supplier_code.getcode()
	//=================================================
	//
	//=================================================
	
	lvs_receipt_type = 'N'
	dw_1.object.receipt_type[LVL_ROW]       = lvs_receipt_type
	lvs_eco_item_yn = 'N'
	dw_1.object.eco_item_yn[lvl_row] = lvs_eco_item_yn
	
//	//==================================================
//	// $$HEX9$$d8c5c0c920009ccde0ac200070c88cd62000$$ENDHEX$$
//	//==================================================
//	dw_3.retrieve( sle_slip_no.text )
	
	if cbx_manual_slip.checked = true then 
		LVL_LOOP = UPPERBOUND(ivl_divide_qty)  
	ELSE
		LVL_LOOP = long(sle_reel_qty.text)
	END IF 
	
	//=================================================
	//
	//=================================================
	if cbx_manual_slip.checked =false and ( sle_unit_qty.text = '' or isnull(sle_unit_qty.text)) then
		st_status.text = F_MSG( "$$HEX15$$e8b204c7200018c2c9b774c7200098c7bbba200018b4c8c5b5c2c8b2e4b2$$ENDHEX$$" ,'S')
		sle_slip_no.text = ''
		sle_supplier_lot_no.text =''
		sle_origin_supplier_code.text = ''
		ivi_error = -1 
		return 
	end if 
	
	//==================================================
	// $$HEX20$$acc2bdb9200014bc54cfdcb42000c8b9a4c230d1200015c8f4bc7cb92000ddc031c120005cd5e4b2$$ENDHEX$$
	//==================================================
	lvl_row = 0 
	i  = 0 
	do
			 i++
			LVL_ROW = DW_2.INSERTROW(1)
			DW_2.SCROLLTOROW(LVL_ROW)
			F_SET_SECURITY_ROW(DW_2 , LVL_ROW ,'ALL')
			
			lvdb_receipt_lot_no = F_GET_SEQUENCE('SEQ_MATERIAL_BARCODE')
			lvs_receipt_lot_no = F_YMD_SYSDATE()+STRING(lvdb_receipt_lot_no)
			
			dw_2.object.scan_date[LVL_ROW]            =  f_sysdate()
			dw_2.object.item_code[LVL_ROW]            = sle_item_code.text //$$HEX5$$fcd3a9ba54cfdcb42000$$ENDHEX$$
			dw_2.object.lot_no[LVL_ROW]                  = lvs_receipt_lot_no  //$$HEX5$$6fb8b8d288bc38d62000$$ENDHEX$$
			
			dw_2.object.origin_lot_no[LVL_ROW]                  = lvs_receipt_lot_no  //$$HEX5$$6fb8b8d288bc38d62000$$ENDHEX$$
	
			dw_2.object.receipt_slip_no[LVL_ROW]     = sle_slip_no.text
			dw_2.object.receipt_compare_yn[lvl_row] = 'N' //$$HEX5$$44be50ad44c6ccb82000$$ENDHEX$$
			dw_2.object.barcode_status[lvl_row] = 'N' //$$HEX7$$44be50ad44c6ccb8200009000900$$ENDHEX$$
			dw_2.object.holding_yn[lvl_row] = 'N' //$$HEX6$$40d629b544c6ccb820000900$$ENDHEX$$
			dw_2.object.lot_divide_yn[lvl_row] = 'N' //$$HEX5$$6fb8b8d284bd60d52000$$ENDHEX$$
			dw_2.object.inventory_type[lvl_row] = lvs_inventory_type //$$HEX5$$6fb8b8d284bd60d52000$$ENDHEX$$
			
			
			if cbx_manual_slip.checked = true then 
				dw_2.object.scan_qty[LVL_ROW]              = ivl_divide_qty[i]
				dw_2.object.item_barcode[LVL_ROW]       = sle_item_code.text+"-"+lvs_receipt_lot_no+"-"+string( ivl_divide_qty[i])// $$HEX9$$5ccd85c814bc54cfdcb42000090009000900$$ENDHEX$$
			else
				dw_2.object.scan_qty[LVL_ROW]              = long(sle_unit_qty.text)
				dw_2.object.item_barcode[LVL_ROW]       = sle_item_code.text+"-"+lvs_receipt_lot_no+"-"+sle_unit_qty.text // $$HEX9$$5ccd85c814bc54cfdcb42000090009000900$$ENDHEX$$
			end if 
			
			  dw_2.object.receipt_type[lvl_row]             = lvs_receipt_type //$$HEX5$$85c7e0ac20c715d62000$$ENDHEX$$
			  dw_2.object.supplier_code[LVL_ROW]       =  ddlb_supplier_code.getcode()
			  
	loop until i = LVL_LOOP 
	
	//===================================================
	//
	//===================================================
	IF dw_1.UPDATE() < 0   or  dw_2.UPDATE() < 0   THEN
		ROLLBACK;
		SLE_LOT_NO.TEXT = ''
		SLE_LOT_NO.SETFOCus( )
		f_play_sound("scanfailed.wav")
		sle_slip_no.text = ''
		sle_supplier_lot_no.text =''
		sle_origin_supplier_code.text = ''
		ivi_error = -1 
		RETURN					
	ELSE
		COMMIT;
		F_MSG_MDI_HELP( "Update Complete" )//$$HEX14$$31c1f5ac01c83cc75cb8200000c8a5c7200018b4c8c5b5c2c8b2e4b2$$ENDHEX$$"
		f_play_sound("kittingok.wav")	
	END IF 
	
	st_status.text = "OK"
	
if cbx_auto_print.checked = true then 
	pb_print.triggerevent(clicked!)
end if 
	
sle_lot_no.text = ''
sle_slip_no.text = ''
sle_item_code.text = ''
sle_reel_qty.text = ''
sle_total_qty.text = ''
sle_unit_qty.text = ''
sle_supplier_lot_no.text =''
sle_origin_supplier_code.text = ''
sle_lot_no.setfocus( )
end subroutine

public function integer wf_set_material_qty ();
//=====================================================
// $$HEX14$$30ae00c918c2c9b7200080bd69d52000ecc580bd2000b4cc6cd02000$$ENDHEX$$
//=====================================================
lvl_material_qty = 0 ; lvl_material_qty2 = 0 ; lvl_material_qty3 = 0 ;

select nvl(material_qty,0) , nvl(material_qty2 ,0) , nvl(material_qty3 ,0) 
   into :lvl_material_qty , :lvl_material_qty2 , :lvl_material_qty3
  from id_item 
where item_code        =  :lvs_item_code
    and organization_id = :gvi_organization_id  ;

if f_sql_check() < 0 then 
	ivi_error = -1 
	return -1
end if 


if lvl_material_qty <> 0 and lvl_material_qty2 = 0  and lvl_material_qty3 = 0 then 
	return lvl_material_qty
elseif lvl_material_qty <> 0 and lvl_material_qty2 <>  0  then 
	return -1 
else
	return 0 
end if 

end function

private subroutine wf_no_slip_receipt ();//==================================================
//  $$HEX12$$5ccd85c8200094cd9ccd1cb4200088d4a9ba54cfdcb42000$$ENDHEX$$
//==================================================
sle_item_code.text = lvs_item_code
//=================================================
//
//=================================================
if cbx_manual_slip.checked =false and ( sle_unit_qty.text = '' or isnull(sle_unit_qty.text)) then
	 sle_unit_qty.text ='1'
end if 

//==================================================
//  SLIP INSERT 
//  $$HEX14$$acc2bdb974c725b844c7200090c7d9b33cc75cb82000ddc031c12000$$ENDHEX$$
//==================================================
LVL_ROW = 0 
f_insert()
LVDB_SLIP_RCV_SEQ  = F_GET_SEQUENCE('SEQ_RECEIPT_SLIP')

dw_1.object.receipt_date[LVL_ROW]         = f_t_sysdate()
dw_1.object.receipt_sequence[LVL_ROW] = LVDB_SLIP_RCV_SEQ
dw_1.object.item_code[LVL_ROW]            = sle_item_code.text
dw_1.object.reel_qty[LVL_ROW]               = LVL_LOOP
dw_1.object.receipt_unit_qty[LVL_ROW]    = long(sle_unit_qty.text)
dw_1.object.receipt_sum_qty[LVL_ROW]   = long(sle_total_qty.text)
dw_1.object.receipt_barcode[LVL_ROW]    = lvs_supplier_barcode // sle_lot_no.text
dw_1.object.receipt_slip_no[LVL_ROW]     =  STRING(f_t_sysdate(),'YYMMDD')+STRING(LVDB_SLIP_RCV_SEQ)
dw_1.object.receipt_status[LVL_ROW]       = 'N'
dw_1.object.supplier_code[LVL_ROW]         = ddlb_supplier_code.getcode()
dw_1.object.from_supplier_code[LVL_ROW] = ddlb_supplier_code.getcode()

//=================================================
//
//=================================================

lvs_receipt_type = 'N'
dw_1.object.receipt_type[LVL_ROW]       = lvs_receipt_type

//=================================================

//==================================================
//
//==================================================
lvl_row = 0 
i = 0 
do
	 i++
	LVL_ROW = DW_2.INSERTROW(1)
	DW_2.SCROLLTOROW(LVL_ROW)
	F_SET_SECURITY_ROW(DW_2 , LVL_ROW ,'ALL')
	
	lvdb_receipt_lot_no = F_GET_SEQUENCE('SEQ_MATERIAL_BARCODE')
	lvs_receipt_lot_no   =F_YMD_SYSDATE()+STRING(lvdb_receipt_lot_no)// STRING(F_T_SYSDATE(),'YYMMDD')+STRING(lvdb_receipt_lot_no)
	
	dw_2.object.scan_date[LVL_ROW]            =  f_sysdate()
	dw_2.object.item_code[LVL_ROW]            = sle_item_code.text //$$HEX5$$fcd3a9ba54cfdcb42000$$ENDHEX$$
	dw_2.object.lot_no[LVL_ROW]                  = lvs_receipt_lot_no  //$$HEX5$$6fb8b8d288bc38d62000$$ENDHEX$$
	dw_2.object.lot_divide_yn[LVL_ROW]                  = 'N'  //$$HEX5$$6fb8b8d288bc38d62000$$ENDHEX$$
	
	dw_2.object.origin_lot_no[LVL_ROW]        = lvs_receipt_lot_no  //$$HEX5$$6fb8b8d288bc38d62000$$ENDHEX$$

	dw_2.object.receipt_slip_no[LVL_ROW]     = STRING(f_t_sysdate(),'YYMMDD')+STRING(LVDB_SLIP_RCV_SEQ)
	dw_2.object.receipt_compare_yn[lvl_row] = 'N' //$$HEX5$$44be50ad44c6ccb82000$$ENDHEX$$
	dw_2.object.barcode_status[lvl_row] = 'N' //$$HEX7$$44be50ad44c6ccb8200009000900$$ENDHEX$$
	dw_2.object.holding_yn[lvl_row] = 'N' //$$HEX7$$40d629b544c6ccb8200009000900$$ENDHEX$$
		dw_2.object.inventory_type[lvl_row] = lvs_inventory_type //$$HEX6$$40d629b544c6ccb820000900$$ENDHEX$$
	
	if cbx_manual_slip.checked = true then 
		dw_2.object.scan_qty[LVL_ROW]              = ivl_divide_qty[i]
		dw_2.object.item_barcode[LVL_ROW]       = sle_item_code.text+"-"+lvs_receipt_lot_no+"-"+string( ivl_divide_qty[i])// $$HEX8$$5ccd85c814bc54cfdcb4200009000900$$ENDHEX$$
		lvs_our_barcode = sle_item_code.text+"-"+lvs_receipt_lot_no+"-"+string( ivl_divide_qty[i])// $$HEX6$$5ccd85c814bc54cfdcb42000$$ENDHEX$$
	else
		dw_2.object.scan_qty[LVL_ROW]              = long(sle_unit_qty.text)
		dw_2.object.item_barcode[LVL_ROW]       = sle_item_code.text+"-"+lvs_receipt_lot_no+"-"+sle_unit_qty.text // $$HEX9$$5ccd85c814bc54cfdcb42000090009000900$$ENDHEX$$
		lvs_our_barcode = sle_item_code.text+"-"+lvs_receipt_lot_no+"-"+sle_unit_qty.text
	end if 
	
	  dw_2.object.receipt_type[lvl_row]             = lvs_receipt_type //$$HEX5$$85c7e0ac20c715d62000$$ENDHEX$$
	  dw_2.object.supplier_code[LVL_ROW]       = ddlb_supplier_code.getcode()
	  
	  lvs_manufacture_week = sle_week.text
	  dw_2.object.manufacture_week[LVL_ROW]  = lvs_manufacture_week
	  
	  
	  //==================================
	  // $$HEX16$$1cc870c82000fcc828cc5cb8200080bd30d120007cc790c72000c0bc58d62000$$ENDHEX$$
	  //==================================
	     
		  select  TRUNC( TO_DATE( '20'||SUBSTR( :lvs_manufacture_week , 1,2)||'0104' , 'YYYYMMDD'),'IW') + (TO_NUMBER(SUBSTR(:lvs_manufacture_week , 3,4)) -1) * 7 
	        into :lvdt_manufacture_date
		   from dual   ;
	  
			IF F_SQL_CHECK() < 0 THEN 
				RETURN 
			END IF 
	  //==================================
	  
	  dw_2.object.manufacture_date[LVL_ROW] = lvdt_manufacture_date
	  dw_2.object.pcb_coating_date[LVL_ROW]  =  DATE( EM_COATING_DATE.TEXT)
	  
	  if ( lvs_item_class = 'RANKLED' ) then
	       dw_2.object.led_rank_info[LVL_ROW]  = sle_rankled.text
	  end if
	  
loop until  i = lvl_loop   //1 // lvl_loop 

//===================================================
//
//===================================================
IF dw_1.UPDATE() < 0   or  dw_2.UPDATE() < 0   THEN
	ROLLBACK;
	sle_slip_no.TEXT   = ''
	sle_item_code.text = ''
	sle_supplier_lot_no.text =''
	sle_origin_supplier_code.text = ''
	sle_slip_no.SETFOCus( )
	f_play_sound("scanfailed.wav")
	ivi_error = -1 
	RETURN					
ELSE

	F_MSG_MDI_HELP( "Update Complete" )//$$HEX14$$31c1f5ac01c83cc75cb8200000c8a5c7200018b4c8c5b5c2c8b2e4b2$$ENDHEX$$"
	f_play_sound("kittingok.wav")
	//================================
	// $$HEX5$$90c7d9b39ccd25b82000$$ENDHEX$$
	//================================
	if cbx_auto_print.checked = true then
	   pb_print.triggerevent(clicked!)
	end if 
END IF 

//========================================
// direct $$HEX4$$85c7e0ac74ba2000$$ENDHEX$$
// $$HEX16$$30b55cb82000a4c294ce44c720001bbcc0c920004ac5e0ac200098ccacb92000$$ENDHEX$$
//========================================
if  rb_no_slip_auto_receipt.checked = true then 
		//====================================
		//  $$HEX8$$90c7d9b385c7e0ac200098ccacb92000$$ENDHEX$$
		//====================================
		sle_supplier_barcode.setfocus()
		sle_supplier_barcode.text = sle_slip_no.text // $$HEX26$$acc2bdb9d0c51cc12000a4c294ce5cd52000c5c5b4cc20006fb8b8d2200014bc54cfdcb420007cb92000acc0a9c65cd5e4b22000$$ENDHEX$$. 20170731 yhs
	    sle_supplier_lot_no.text =    wf_lot_substring( sle_slip_no.text ) // 20 $$HEX14$$90c7acb9200080bd30d120006fb8b8d25cb8200078c7ddc220002000$$ENDHEX$$20170731 yhs
	//	sle_supplier_barcode.text = lvs_our_barcode + 'S'   // $$HEX4$$c9b94cc720002000$$ENDHEX$$20170731 yhs
		sle_our_barcode.text        = lvs_our_barcode 
		
		//=====================================
		// $$HEX10$$e4b274c709b8b8d2200085c7e0ac200074ba2000$$ENDHEX$$
		//=====================================
		if wf_receipt_barcode('N') < 0 then 
			
					st_status.text = "NG"
					ROLLBACK ;
		else
					st_status.text = "OK"
					COMMIT ;
		end if 
		
		//=====================================
		//
		//=====================================
		
		sle_item_code.text = ''
		sle_reel_qty.text = '0'
		sle_total_qty.text = ''
		sle_unit_qty.text = ''
		em_creator_qty.text = ''
		sle_slip_no.text = '' 
		sle_supplier_lot_no.text =''
		sle_origin_supplier_code.text = ''
		sle_slip_no.setfocus( )
		

elseif rb_no_slip_manual_receipt.checked  = true then 
		//$$HEX15$$54d674bad0c51cc12000a4c294ce20001bbc44c51cc1200098ccacb92000$$ENDHEX$$
     	sle_supplier_barcode.setfocus( )
		COMMIT;	
else
					st_status.text = "OK"
					sle_item_code.text = ''
					sle_reel_qty.text = '0'
					sle_total_qty.text = ''
					sle_unit_qty.text = ''
					em_creator_qty.text = ''
					sle_slip_no.text = '' 
					sle_supplier_lot_no.text =''
					sle_origin_supplier_code.text = ''
					sle_slip_no.setfocus( )

				COMMIT;

end if 




end subroutine

public function string wf_lot_substring (string arg_barcode);return   Trim( mid(  arg_barcode  , 20 , 100 )) 
end function

