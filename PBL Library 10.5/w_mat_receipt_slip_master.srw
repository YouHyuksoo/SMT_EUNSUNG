type em_creator_qty from editmask within w_mat_receipt_slip_master
integer x = 2811
integer y = 616
integer width = 357
integer height = 100
integer taborder = 30
boolean bringtotop = true
integer textsize = -10
integer weight = 400
fontcharset fontcharset = ansi!
fontpitch fontpitch = variable!
fontfamily fontfamily = swiss!
string facename = "Tahoma"
long textcolor = 33554432
long backcolor = 16777215
boolean enabled = false
alignment alignment = right!
textcase textcase = upper!
borderstyle borderstyle = stylelowered!
maskdatatype maskdatatype = stringmask!
end type

event modified;int     lvi_Pos
string lvs_qty , lvs_total_qty

//========================================
//  
//========================================
sle_reel_qty.text = string(1)
lvs_qty = this.text

//=========================================
//$$HEX11$$e4b2dcc25cd588bc200018c2c9b7d0c51cc120000900$$ENDHEX$$Q $$HEX5$$7cb920001cc870ac2000$$ENDHEX$$
//=========================================
if mid( upper(lvs_qty) , 1,1 ) = 'Q' then 

	sle_total_qty.text = string(long(trim(mid(lvs_qty , 2, 10))))
	sle_unit_qty.text  = string(long(trim(mid( lvs_qty , 2, 10))))
	
elseif lvs_qty ='' or  isnull(lvs_qty) then 
	
	//	F_MSG('$$HEX11$$18c2c9b744c7200055d678c7200058d538c194c62000$$ENDHEX$$CHECK QTY' , 'P') 
//		sle_slip_no.text = '' 
//		sle_supplier_lot_no.text =''
//		sle_origin_supplier_code.text = ''
//		sle_slip_no.setfocus()
		ivi_error = -1 
		return 	
else
	
	sle_total_qty.text = string(long( this.text))
	
end if 

//==========================================
//
//==========================================

if lvs_item_class = 'PCB'   and  (  sle_week.text = '' or isnull(sle_week.text) or   em_coating_date.text = '0000-00-00' OR em_coating_date.text = '' or isnull(em_coating_date.text)   )  then 
	  
	     em_coating_date.text = ''
		f_msg("PCB $$HEX6$$1cc870c82000fcc828cc2000$$ENDHEX$$/ $$HEX12$$54cf05d37cc790c77cb9200085c725b858d538c194c62000$$ENDHEX$$( $$HEX5$$85c725b815d6ddc22000$$ENDHEX$$: YYYYMMDD )" , 'P') 
		sle_week.setfocus()
		return -1
	
	
end if 


if lvs_item_class = 'RANKLED'   and  (  sle_rankled.text = '' or isnull(sle_rankled.text)  )  then 

		f_msg("LED $$HEX10$$adb76cd07cb9200085c725b8200058d538c194c6$$ENDHEX$$" , 'P') 
		sle_rankled.setfocus()
		return -1
		
elseif lvs_item_class = 'RANKLED'   and  (  sle_rankled.text <>  ''   ) then 
	
	
			string lvs_rankled
			int lvi_count
			lvs_rankled = sle_rankled.text
			
			select count(*) into :lvi_count 
			from im_item_rank_master 
			where rank = :lvs_rankled 
			and rownum = 1 ;
			
			if f_sql_check() < 0 then 
				this.text = ''
				return 
			end if 
			
			
			if lvi_count <= 0 then 
			
				f_msg("$$HEX19$$f8bbf1b45db82000adb76cd0200085c7c8b2e4b2200085c7e0ac200088bd00ac69d5c8b2e4b2$$ENDHEX$$" , "P")
				sle_slip_no.text = ''
				this.text = ''
				sle_slip_no.setfocus()
				return 
			end if 

end if 
//====================================================	 
//	 $$HEX19$$18c2d9b37cc7bdacb0c6200084bd60d518c2c9b7200085c725b820003dcc20001dd3c5c52000$$ENDHEX$$
//====================================================	 

 sle_total_qty.text = string(long(this.text))
 lvs_total_qty = sle_total_qty.text
		  

//========================================
//
//========================================


if  cbx_manual_slip.checked = true  then 
				
				
		 ivl_divide_qty = {0}
		 GST_RETURN.GVS_RETURN[1] = sle_unit_qty.text
		 openwithparm (w_mat_slip_manual_qty_popup ,lvs_total_qty )   
		 
		 if  Upperbound(ivl_divide_qty) = 0  then		
			st_status.text = F_MSG( "Divide Qty Invalid" ,'S')
			sle_lot_no.text = ''
			sle_lot_no.setfocus()
			sle_lot_no.selecttext( 1,100)		
			sle_slip_no.text = ''
			ivi_error = -1 
			return -1
		elseif Upperbound(ivl_divide_qty) = 1 and ivl_divide_qty[1] = 0 then 
			st_status.text = F_MSG( "Divide Qty Invalid" , 'S')
			sle_lot_no.text = ''
			sle_lot_no.setfocus()
			sle_lot_no.selecttext( 1,100)		
			sle_slip_no.text = ''
			ivi_error = -1 
			return -1		
		else
			LVL_LOOP = UPPERBOUND(ivl_divide_qty)  
		end if       
		
		sle_reel_qty.text  = string(LVL_LOOP)	
			
else
	
	LVL_LOOP = 1

	sle_reel_qty.text  = string(LVL_LOOP)		
	sle_unit_qty.text  = string(long(this.text ))
	
end if 

//====================================================	
// $$HEX16$$88d4a9bac8b9a4c230d1d0c5200090c7d9b3200085c7e0ac200098ccacb92000$$ENDHEX$$auto_receipt_yn=y $$HEX13$$78c7bdacb0c6200090c7d9b3200085c7e0ac98ccacb920000900$$ENDHEX$$
//====================================================	
wf_no_slip_receipt()







end event

