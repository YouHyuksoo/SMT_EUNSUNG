type sle_our_barcode_return from so_singlelineedit within w_mat_other_issue_barcode_master
integer x = 4142
integer y = 840
integer width = 859
integer height = 84
integer taborder = 50
boolean bringtotop = true
long backcolor = 16777215
textcase textcase = upper!
end type

event getfocus;call super::getfocus;this.selecttext(1,100)
st_status.text = f_msg_st1(126 ,f_get_dual_lang_text( gvs_language , "ITEM CODE") ) 
end event

event modified;call super::modified;
string LVS_reel_destroy_yn, lvs_chamber_type

LVS_reel_destroy_yn = 'N'

LVS_ERROR_CHECK = ''
LVS_OUR_BARCODE_return = THIS.TEXT
SLE_LINE_CODE.TEXT  = ''
LVS_LINE_CODE = ''
LVS_LOT_NO = '' 
LVS_SLIP_NO = ''
LVS_ISSUE_COMPARE_YN = ''
LVS_ISSUE_RETURN_YN = ''
LVS_LABEL_TYPE = ''

////=======================================
//// $$HEX11$$00cf3cd554cf200090c7acc778c72000bdacb0c62000$$ENDHEX$$
////=======================================
// IF MID (UPPER (LVS_OUR_BARCODE_return), 1, 1) = '['    THEN
//         SELECT  f_get_item_code_from_barcode (:LVS_OUR_BARCODE_return)|| '-' || f_get_lot_no_from_barcode (:LVS_OUR_BARCODE_return) || '-' || f_get_lot_qty_from_barcode (:LVS_OUR_BARCODE_return)
//		    INTO :LVS_OUR_BARCODE_return
//	       FROM DUAL ; 
//		
//		IF F_SQL_CHECK() < 0 THEN 
//			sle_our_barcode_return.SETFOCUS( )
//			sle_our_barcode_return.TEXT = ''
//				
//		END IF 	 
//END IF 
//
//================================================
//
//================================================
IF LEN(LVS_OUR_BARCODE_return) < 7  THEN 

            F_MSGBOX1(1175 ,LVS_OUR_BARCODE_return )
					sle_our_barcode_return.SETFOCUS( )
					sle_our_barcode_return.TEXT = ''
            LVS_ERROR_CHECK = 'ERROR'
            RETURN -1 
END IF 

LVDB_RECEIPT_LOT_NO = F_GET_SEQUENCE('SEQ_MATERIAL_BARCODE')

        //============================================
        //  $$HEX6$$88d4a9ba200054cfdcb42000$$ENDHEX$$7 $$HEX13$$88bc30ca200074c7c4d6200080bd30d120003ecc94b2e4b22000$$ENDHEX$$
	   // $$HEX4$$88d4a9bad0c52000$$ENDHEX$$- $$HEX15$$00ac2000ecd368d51cb4200090c7acc700ac200088c73cc7c0bb5cb82000$$ENDHEX$$
        //============================================
//        LVI_POS1 =  POS(LVS_OUR_BARCODE_return, '-' , 7 ) 
//
//        IF  LVI_POS1 <= 0 THEN 
//            LVS_ITEM_CODE = TRIM( MID( LVS_OUR_BARCODE_return , 1 , 100 ))
//        ELSE
//            //=================================================
//            //
//            //=================================================
//            LVS_ITEM_CODE = TRIM( MID( LVS_OUR_BARCODE_return , 1 ,  LVI_POS1 -1 ))        
//        END IF 

			SELECT  f_get_item_code_from_barcode(:LVS_OUR_BARCODE_return) 
			INTO :lvs_item_code
			FROM DUAL ; 
			
			IF F_SQL_CHECK() < 0 THEN 
				sle_our_barcode.selecttext( 1,100)	
			END IF 	 
//		
//		if  len(lvs_item_code) <= 0 then 
//			f_msgbox1(1175 ,lvs_our_barcode )
//			sle_our_barcode.setfocus()
//			sle_our_barcode.selecttext( 1,100)
//			return -1 
//		end if 	


        IF F_CHECK_ITEM_EXISTS( LVS_ITEM_CODE , F_T_SYSDATE())  <= 0 THEN 
                F_PLAY_SOUND("$$HEX5$$88d4a9baf8bbf1b45db8$$ENDHEX$$.WAV")	  
                F_MSGBOX(9041) //$$HEX10$$fcd3a9bac8b9a4c230d12000f8bbf1b45db82000$$ENDHEX$$
                ST_STATUS.TEXT =F_MSG_ST(9041)
				sle_our_barcode_return.SETFOCUS( )
				sle_our_barcode_return.TEXT = ''
                LVS_ERROR_CHECK = 'ERROR'
                RETURN -1
        END IF 

        //==================================================
        // $$HEX6$$6fb8b8d2200088bc38d62000$$ENDHEX$$
        //==================================================
//        LVI_POS2 =  POS(LVS_OUR_BARCODE_return , '-' , LVI_POS1+1 ) 
//        
//        IF  LVI_POS1 > 0 AND LVI_POS2 <= 0 THEN 
//                LVS_LOT_NO = TRIM( MID( LVS_OUR_BARCODE_return , LVI_POS1+1 ,   100))
//        ELSEIF LVI_POS1 > 0 AND LVI_POS2 > 0 THEN 
//                LVS_LOT_NO = TRIM( MID( LVS_OUR_BARCODE_return , LVI_POS1+1 ,   LVI_POS2 - LVI_POS1 -1 ))
//        ELSE
//                 LVS_LOT_NO = STRING(F_T_SYSDATE(),'YYMMDD')+STRING(LVDB_RECEIPT_LOT_NO,'00000')
//        END IF 

			SELECT  F_GET_LOT_NO_FROM_BARCODE (:LVS_OUR_BARCODE_return ) 
			INTO :lvs_lot_no
			FROM DUAL ; 
			
			IF F_SQL_CHECK() < 0 THEN 
				sle_our_barcode.selecttext( 1,100)	
			END IF 	 
		
				  IF LVS_LOT_NO = ''  THEN 
						
						ST_STATUS.TEXT = "$$HEX15$$6fb8b8d288bc38d600ac20002cc614bc74b9c0c920004ac5b5c2c8b2e4b2$$ENDHEX$$"
					sle_our_barcode_return.SETFOCUS( )
					sle_our_barcode_return.TEXT = ''
						LVS_ERROR_CHECK = 'ERROR'
						RETURN -1
						
				  END IF     


//====================================================
// $$HEX11$$6fb8b8d200ac200088c73cc774ba200070c88cd62000$$ENDHEX$$
// 8 $$HEX6$$90c7acb9200074c7c1c02000$$ENDHEX$$
//====================================================

IF LVS_LOT_NO <>  '' THEN
        
					SELECT RECEIPT_SLIP_NO,
								NVL(SUPPLIER_CODE ,'*') , 
								NVL(ISSUE_COMPARE_YN , 'N')  ,
								NVL(ISSUE_RETURN_YN , 'N') ,
								NVL(WORKSTAGE_CODE , '*') ,
								NVL(LABEL_TYPE,'N') ,
								DECODE( NVL(NEW_SCAN_QTY,0)  , 0 , SCAN_QTY , NEW_SCAN_QTY ) SCAN_QTY ,
								INVENTORY_TYPE,
								NVL(reel_destroy_yn,'N')
								
				     	INTO :LVS_SLIP_NO , 
								:LVS_SUPPLIER_CODE , 
							  :LVS_ISSUE_COMPARE_YN ,
							  :LVS_ISSUE_RETURN_YN,
							  :LVS_WORKSTAGE_CODE,
							  :LVS_LABEL_TYPE ,
							  :LVL_NEW_SCAN_QTY ,
							  :LVS_INVENTORY_TYPE,
							  :LVS_reel_destroy_yn
							  
				 FROM IM_ITEM_RECEIPT_BARCODE
			    WHERE ITEM_CODE          = :LVS_ITEM_CODE
					 AND LOT_NO               = :LVS_LOT_NO
					 AND ORGANIZATION_ID = :GVI_ORGANIZATION_ID ;
			  
			  IF F_SQL_CHECK() < 0 THEN 
					ST_STATUS.TEXT = "$$HEX13$$14bc54cfdcb4200074c725b8200070c88cd611c9200024c658b9$$ENDHEX$$"
					sle_our_barcode_return.SETFOCUS( )
					sle_our_barcode_return.TEXT = ''
					LVS_ERROR_CHECK = 'ERROR'
					RETURN 
			  END IF 
			  
			  IF LVS_reel_destroy_yn <> 'N'  THEN 
								
				  ST_STATUS.TEXT = "$$HEX14$$74c7f8bb2000d0d330ae1cb420007cb7a8bc200085c7c8b2e4b22000$$ENDHEX$$" + ' => ' + LVS_reel_destroy_yn
				  messagebox('$$HEX2$$bdace0ac$$ENDHEX$$', '$$HEX13$$74c7f8bb2000d0d330ae1cb420007cb7a8bc200085c7c8b2e4b2$$ENDHEX$$, $$HEX6$$55d678c7200058d538c194c6$$ENDHEX$$!!' + ' => ' + LVS_reel_destroy_yn )
				
                    LVS_ERROR_CHECK = 'ERROR'
				  sle_our_barcode_return.TEXT = ''
				  sle_our_barcode_return.SETFOCUS( )
				
                    RETURN -1
					 
                END IF 			  
	
END IF 

//================================================
//  $$HEX3$$a0bc74c7b9d0$$ENDHEX$$, $$HEX3$$1cc8b4c268d5$$ENDHEX$$, $$HEX8$$c4c9f5acecd3a5c7200011c978c7c0c9$$ENDHEX$$.. $$HEX2$$55d678c7$$ENDHEX$$
//================================================


select  count(*), decode( max(chamber_type), 'B', '$$HEX3$$a0bc74c7b9d0$$ENDHEX$$', 'V', '$$HEX4$$c4c9f5acecd3a5c7$$ENDHEX$$', 'D', '$$HEX3$$1cc8b5c268d5$$ENDHEX$$', max(chamber_type) )
   into :lvl_count, :lvs_chamber_type
 from im_item_baking_master
where lot_no = :LVS_LOT_NO
   and input_scan_date is not null
   and output_scan_date is null;
  
 if ( lvl_count > 0 ) then

				  ST_STATUS.TEXT = lvs_chamber_type + " $$HEX12$$04c758ced0c5200085c7e0ac200011c985c7c8b2e4b22000$$ENDHEX$$" 
				  messagebox('$$HEX2$$bdace0ac$$ENDHEX$$', lvs_chamber_type + " $$HEX12$$04c758ced0c5200085c7e0ac200011c985c7c8b2e4b22000$$ENDHEX$$"  )
				
                    LVS_ERROR_CHECK = 'ERROR'
				  sle_our_barcode_return.TEXT = ''
				  sle_our_barcode_return.SETFOCUS( )
				
                    RETURN -1
						  
end if
  

//================================================
// $$HEX13$$74c760b8200014bc54cfdcb4200094c7c9b7200018c2c9b72000$$ENDHEX$$
//================================================
SLE_SCAN_QTY.TEXT = STRING(LVL_NEW_SCAN_QTY) 

//================================================
// $$HEX6$$04d6a5c7200018bc88d42000$$ENDHEX$$
//================================================

IF  RB_MASS_RETURN.CHECKED  = TRUE  AND  ( LVS_LABEL_TYPE   ='N'  OR LVS_LABEL_TYPE = '' OR ISNULL(LVS_LABEL_TYPE) ) THEN 

        //$$HEX5$$88bdc9b774c774ba2000$$ENDHEX$$
        IF CBX_BAD_YN.CHECKED = TRUE THEN 
            LVS_LOCATION_CODE = 'M02' //$$HEX7$$88bdc9b720003dcce0ac5cb82000$$ENDHEX$$
            LVS_LINE_CODE  = '28' //$$HEX5$$04d6a5c788bdc9b72000$$ENDHEX$$
        ELSE
            LVS_LOCATION_CODE = 'M01' //$$HEX12$$91c588d43dcce0ac5cb82000200009002000200020002000$$ENDHEX$$
            //$$HEX24$$18bca9b02000a1c794b220007cb778c740c72000e4c21cc820009ccde0ac18b4c8c558b320007cb778c7d0c51cc12000$$ENDHEX$$
        END IF 
        
        LVS_LABEL_TYPE = 'N'
//====================================================		  
//$$HEX9$$acb9fcbc91c588d420000900090020002000$$ENDHEX$$
//====================================================	
ELSEIF  RB_MASS_RETURN.CHECKED  = TRUE  AND  LVS_LABEL_TYPE   ='R'  THEN 

        //$$HEX5$$88bdc9b774c774ba2000$$ENDHEX$$
        IF CBX_BAD_YN.CHECKED = TRUE THEN 
            LVS_LOCATION_CODE = 'M02' //$$HEX7$$88bdc9b720003dcce0ac5cb82000$$ENDHEX$$
            LVS_LINE_CODE  = '28' //$$HEX5$$04d6a5c788bdc9b72000$$ENDHEX$$
        ELSE
            LVS_LOCATION_CODE = 'M06' //$$HEX12$$91c588d43dcce0ac5cb82000200009002000200020002000$$ENDHEX$$
            //$$HEX24$$18bca9b02000a1c794b220007cb778c740c72000e4c21cc820009ccde0ac18b4c8c558b320007cb778c7d0c51cc12000$$ENDHEX$$
        END IF 
        
        LVS_LABEL_TYPE = 'R'
		  
//====================================================		  
//$$HEX9$$8cbc6cd0200091c588d40900090020002000$$ENDHEX$$
//====================================================	
ELSEIF  RB_MASS_RETURN.CHECKED  = TRUE  AND  LVS_LABEL_TYPE   ='B'  THEN 

        //$$HEX5$$88bdc9b774c774ba2000$$ENDHEX$$
        IF CBX_BAD_YN.CHECKED = TRUE THEN 
            LVS_LOCATION_CODE = 'M02' //$$HEX7$$88bdc9b720003dcce0ac5cb82000$$ENDHEX$$
        ELSE
            LVS_LOCATION_CODE = 'M05'   //$$HEX17$$8cbc6cd091c588d4200020003dcce0ac5cb820002000200009002000200020002000$$ENDHEX$$
            //$$HEX24$$18bca9b02000a1c794b220007cb778c740c72000e4c21cc820009ccde0ac18b4c8c558b320007cb778c7d0c51cc12000$$ENDHEX$$
        END IF 
        
       LVS_LABEL_TYPE = 'B'    
		 
//      sle_return_qty.TEXT = STRING( F_GET_NEW_SCAN_QTY ( LVS_ITEM_CODE , LVS_LOT_NO ) )

//=================================================================================
//
//=================================================================================
//ELSEIF  RB_BULK.CHECKED = TRUE  AND  ( LVS_LABEL_TYPE   ='B'  OR LVS_LABEL_TYPE = '' OR ISNULL(LVS_LABEL_TYPE) )  THEN 
//    
