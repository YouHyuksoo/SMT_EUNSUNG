//=====================================================
// PCB COATING  $$HEX6$$5cb8c1c92000b4cc6cd02000$$ENDHEX$$
//=====================================================

if cbx_pcb_coating_check.checked = true then
	
	IF LVS_ITEM_CLASS = 'PCB' then 
		
	              // PCB $$HEX9$$54cf05d320007cc790c72000b4cc6cd02000$$ENDHEX$$
			 SELECT F_CHECK_PCB_COATING_DATE ( :LVS_ITEM_CODE , :LVDT_PCB_COATING_DATE , :GVI_ORGANIZATION_ID ) 
				INTO :LVS_PCB_COATING_DATE_OK_YN
			   FROM DUAL ;		
				
				IF LVS_PCB_COATING_DATE_OK_YN = 'Y' THEN 
					
				ELSE
					ST_STATUS.TEXT = LVS_ITEM_CODE+" "+ STRING(LVDT_PCB_COATING_DATE) 
					F_MSG("PCB $$HEX22$$54cf05d37cc790c700ac200030ae00c944c7200008cdfcac200088d5b5c2c8b2e4b220009ccde0ac88bd00ac$$ENDHEX$$" ,  "P")
					sle_our_barcode.text = ''
					sle_our_barcode.setfocus()
					return -1 					
				END IF 
				
	END IF
	
end if
	
//=====================================================
// $$HEX12$$20c185c7200020c19ccd20005cb8c1c92000b4cc6cd02000$$ENDHEX$$
//=====================================================	

LVI_FIFO_COUNT  = 0 ;

if cbx_material_fifo_yn.checked = true then 
	
	//PCB $$HEX9$$74ba2000fcc828cc5cb8200044be50ad2000$$ENDHEX$$
	
	IF (LVS_ITEM_CLASS = 'PCB') then 
		
	     SELECT COUNT(*)
		   INTO :LVI_FIFO_COUNT 
	       FROM IM_ITEM_RECEIPT_BARCODE
	     WHERE ITEM_CODE                           = :LVS_ITEM_CODE
			AND RECEIPT_COMPARE_YN           = 'Y'
			AND NVL(ISSUE_COMPARE_YN ,'N') = 'N'
			AND ORGANIZATION_ID                  = :GVI_ORGANIZATION_ID
			AND LOT_NO <> :lvs_lot_no
			AND MANUFACTURE_WEEK            < :lvs_manufacture_week // TO_CHAR( SYSDATE - 30  , 'YYWW') 
			AND INVENTORY_TYPE                   = :LVS_INVENTORY_TYPE
			AND NVL(LABEL_TYPE , 'N')             = 'N'
			AND LOT_NO IN ( SELECT MATERIAL_MFS FROM IM_ITEM_INVENTORY WHERE ITEM_CODE = :LVS_ITEM_CODE AND LOCATION_CODE = 'M01' AND INVENTORY_QTY > 0 )
			AND not (BAKING_START_DATE is not null and BAKING_END_DATE is null)  // $$HEX11$$a0bc74c7b9d0200085c7e0acc1c0dcd020001cc878c6$$ENDHEX$$
			AND ROWNUM =1 ;	
			
          IF (LVI_FIFO_COUNT > 0) THEN 
		      lvs_message =  '$$HEX18$$20c185c720c19ccd200048c51cb4200090c7acc700ac200074c8acc7200069d5c8b2e4b2$$ENDHEX$$.' 
		  END IF	
		
	ELSE
			
		// $$HEX6$$a4c294ce88d4a9ba58c72000$$ENDHEX$$MOQ $$HEX7$$18c2c9b744c720006cad5cd5e4b2$$ENDHEX$$
		
		select  nvl(material_qty,0)
		   into :lvl_moq_qty
           from id_item
         where item_code = :LVS_ITEM_CODE
		    and rownum = 1;
			 
		IF (F_SQL_CHECK() < 0) THEN 
		     sle_our_barcode.text = ''
		     sle_our_barcode.setfocus()
		     return -1 
		END IF 			 
		
		// $$HEX18$$a4c294ce5cd5200014bc54cfdcb458c72000a5c785c718c2c9b744c720006cad5cd5e4b2$$ENDHEX$$
		
	     select nvl(scan_qty,0)
		   into :lvl_scan_barcode_qty
           from IM_ITEM_RECEIPT_BARCODE
         where lot_no = :lvs_lot_no
		    and rownum = 1;	 
			 
		IF (F_SQL_CHECK() < 0) THEN 
		     sle_our_barcode.text = ''
		     sle_our_barcode.setfocus()
		     return -1 
		END IF 			 
			 
	   // scan qty $$HEX2$$00ac2000$$ENDHEX$$MOQ $$HEX15$$f4bce4b2200091c740c774ba200094c7c9b714bc54cfdcb42000f8bce4b2$$ENDHEX$$
        // $$HEX7$$94c7c9b714bc54cfdcb474ba2000$$ENDHEX$$FIFO $$HEX3$$55d678c72000$$ENDHEX$$SKIP, $$HEX2$$e8b22000$$ENDHEX$$MOQ > 0	
		
		IF ( (lvl_moq_qty > lvl_scan_barcode_qty) and (lvl_moq_qty > 0) ) THEN                             // Scan $$HEX11$$90c7acc700ac200094c7c9b778c7c0c9200055d678c7$$ENDHEX$$
			
		       SELECT COUNT(*)
		   	      INTO :LVI_FIFO_COUNT 
		   	      FROM IM_ITEM_RECEIPT_BARCODE
		         WHERE ITEM_CODE                           = :LVS_ITEM_CODE
				   AND TRUNC(MANUFACTURE_DATE)  <  TRUNC( :LVDT_RECEIPT_COMPARE_DATE )  // Scan $$HEX22$$90c7acc7f4bce4b220001cc870c87cc790c7f4bce4b2200060be78b98cac200088c794b2c0c9200055d678c7$$ENDHEX$$
		   	       AND RECEIPT_COMPARE_YN            = 'Y'
		   	       AND NVL(ISSUE_COMPARE_YN ,'N')  = 'N'
				   AND NVL(REEL_DESTROY_YN,'N')     = 'N'
		   	       AND ORGANIZATION_ID                   = :GVI_ORGANIZATION_ID
				   AND LOT_NO                                  <> :lvs_lot_no
		   	       AND ( (SCAN_QTY  < :lvl_moq_qty)  and (:lvl_moq_qty > 0) )                                 // $$HEX6$$94c7c9b7d0c5200000b374d5$$ENDHEX$$
		   	       AND INVENTORY_TYPE                    = :LVS_INVENTORY_TYPE
		   	       AND NVL(LABEL_TYPE , 'N')              = 'N'
		   	       AND LOT_NO IN ( SELECT MATERIAL_MFS FROM IM_ITEM_INVENTORY WHERE ITEM_CODE = :LVS_ITEM_CODE AND LOCATION_CODE = 'M01' AND INVENTORY_QTY > 0 )
		   	       AND not (BAKING_START_DATE is not null and BAKING_END_DATE is null)  // $$HEX11$$a0bc74c7b9d0200085c7e0acc1c0dcd020001cc878c6$$ENDHEX$$
				  AND ROWNUM                                = 1; 
						 
		   	       IF (F_SQL_CHECK() < 0) THEN 
		   		        sle_our_barcode.text = ''
		   		        sle_our_barcode.setfocus()
		   		        return -1 
		   	       END IF 	
		   				
		   	       IF (LVI_FIFO_COUNT > 0) THEN
		   		        lvs_message = 'MOQ $$HEX30$$f4bce4b2200091c73cc774ba1cc12000a4c294ce90c7acc7f4bce4b2200060be78b920001cc870c87cc790c700ac200074c8acc7200069d5c8b2e4b2$$ENDHEX$$.' 
		   	       END IF						 
					
	    ELSE
			
				// $$HEX15$$94c7c9b714bc54cfdcb400ac200074c8acc758d594b2c0c9200055d678c7$$ENDHEX$$, $$HEX2$$e8b22000$$ENDHEX$$MOQ > 0	
				
		   	    SELECT COUNT(*)
		   	        INTO :LVI_FIFO_COUNT 
		   	      FROM IM_ITEM_RECEIPT_BARCODE
		         WHERE ITEM_CODE                             = :LVS_ITEM_CODE
		   	         AND RECEIPT_COMPARE_YN            = 'Y'
		   	         AND NVL(ISSUE_COMPARE_YN ,'N')  = 'N'
				     AND NVL(REEL_DESTROY_YN,'N')     = 'N'
		   	         AND ORGANIZATION_ID                   = :GVI_ORGANIZATION_ID
				     AND ( (SCAN_QTY < :lvl_moq_qty)  and (:lvl_moq_qty > 0) )          // $$HEX19$$74d5f9b2200088d4a9bad0c5200094c7c9b774c7200074c8acc758d594b2c0c9200055d678c7$$ENDHEX$$
		   	         AND INVENTORY_TYPE                    = :LVS_INVENTORY_TYPE
		   	         AND NVL(LABEL_TYPE , 'N')              = 'N'
		   	         AND LOT_NO IN ( SELECT MATERIAL_MFS FROM IM_ITEM_INVENTORY WHERE ITEM_CODE = :LVS_ITEM_CODE AND LOCATION_CODE = 'M01' AND INVENTORY_QTY > 0 )
		   	         AND not (BAKING_START_DATE is not null and BAKING_END_DATE is null)  // $$HEX11$$a0bc74c7b9d0200085c7e0acc1c0dcd020001cc878c6$$ENDHEX$$
					AND ROWNUM                                = 1; 
						 
			    IF (LVI_FIFO_COUNT > 0) THEN
		   		     lvs_message = 'MOQ $$HEX16$$f4bce4b2200091c740c7200090c7acc700ac200074c8acc7200069d5c8b2e4b2$$ENDHEX$$.' 
			   ELSE 
						 
		   	          SELECT COUNT(*)
		   	              INTO :LVI_FIFO_COUNT 
		   	             FROM IM_ITEM_RECEIPT_BARCODE
		               WHERE ITEM_CODE                             = :LVS_ITEM_CODE
		   	               AND TRUNC(MANUFACTURE_DATE)  <  TRUNC(:LVDT_RECEIPT_COMPARE_DATE )   // Scan $$HEX22$$90c7acc72000f4bce4b2200060be78b98cac20001cc870c87cc790c700ac200088c794b2c0c9200055d678c7$$ENDHEX$$
		   	               AND RECEIPT_COMPARE_YN            = 'Y'
		   	               AND NVL(ISSUE_COMPARE_YN ,'N')  = 'N'
				           AND NVL(REEL_DESTROY_YN,'N')     = 'N'
		   	               AND ORGANIZATION_ID                   = :GVI_ORGANIZATION_ID
		   	               AND LOT_NO                                  <> :lvs_lot_no
		   	               AND INVENTORY_TYPE                    = :LVS_INVENTORY_TYPE
		   	               AND NVL(LABEL_TYPE , 'N')              = 'N'
		   	               AND LOT_NO IN ( SELECT MATERIAL_MFS FROM IM_ITEM_INVENTORY WHERE ITEM_CODE = :LVS_ITEM_CODE AND LOCATION_CODE = 'M01' AND INVENTORY_QTY > 0 )
		   	               AND not (BAKING_START_DATE is not null and BAKING_END_DATE is null)  // $$HEX11$$a0bc74c7b9d0200085c7e0acc1c0dcd020001cc878c6$$ENDHEX$$
						  AND ROWNUM                                = 1 ;
		   				
		   	           IF (F_SQL_CHECK() < 0) THEN 
		   		            sle_our_barcode.text = ''
		   		            sle_our_barcode.setfocus()
		   		            return -1 
		   	           END IF 	
		   				
		   	           IF (LVI_FIFO_COUNT > 0) THEN
		   		            lvs_message = '$$HEX18$$20c185c720c19ccd200048c51cb4200090c7acc700ac200074c8acc7200069d5c8b2e4b2$$ENDHEX$$.' 
		   	           END IF
					 
				END IF		 
								
		END IF 
				
    END IF
	        
	if (lvi_fifo_count > 0) then 
		
	   dw_6.retrieve( LVS_ITEM_CODE , lvs_lot_no , LVDT_RECEIPT_COMPARE_DATE ,LVS_INVENTORY_TYPE   )
	
	   f_play_sound("$$HEX4$$20c185c720c19ccd$$ENDHEX$$.wav")
	   F_MSG( 'FIFO Found : ' + lvs_message , 'P' )
	   st_status.text = F_MSG( lvs_message, 'S')  //$$HEX8$$485165514851fa5120001995ef8b2000$$ENDHEX$$:
		
	   sle_our_barcode.setfocus( )
	   sle_our_barcode.text = ''
			
	   return -1
			
	end if
	
end if 

//=====================================================
// $$HEX8$$90c730aeacc7e0ac2000b4cc6cd02000$$ENDHEX$$( $$HEX8$$5ccd85c885c7e0ac7cc790c700ac2000$$ENDHEX$$1$$HEX11$$44b1c0c99cb0bdacb0c620009ccde0ac200048c568d5$$ENDHEX$$)
//=====================================================	
if cbx_long_term_inventory.checked = true then 
	
	 SELECT COUNT(*)
	    INTO :lvl_cnt 
       FROM IM_ITEM_INVENTORY
     WHERE LAST_RECEIPT_DATE > ADD_MONTHS(TO_DATE(SYSDATE), - 12)
          AND ITEM_CODE LIKE :LVS_ITEM_CODE
          AND MATERIAL_MFS LIKE :LVS_LOT_NO
          AND ORGANIZATION_ID = :GVI_ORGANIZATION_ID; 
		
    IF F_SQL_CHECK() < 0 THEN 
	   sle_our_barcode.text = ''
	   sle_our_barcode.setfocus()
	   return -1 
	END IF 
	
	if lvl_cnt  = 0 OR ISNULL(lvl_cnt) then 
	  // f_play_sound("Eixst.wav")
	    F_MSG( '$$HEX4$$a5c730aeacc7e0ac$$ENDHEX$$(12$$HEX2$$1cacd4c6$$ENDHEX$$)$$HEX13$$94b220009ccde0ac200060d5200018c22000c6c5b5c2c8b2e4b2$$ENDHEX$$.~r~n$$HEX21$$9ccde0ac7cb92000d0c658d5dcc274ba200035c658c1200020c1ddd044c7200074d51cc858d538c194c6$$ENDHEX$$' , 'P')
	   st_status.text = F_MSG( '$$HEX4$$a5c730aeacc7e0ac$$ENDHEX$$(12$$HEX2$$1cacd4c6$$ENDHEX$$)$$HEX13$$94b220009ccde0ac200060d5200018c22000c6c5b5c2c8b2e4b2$$ENDHEX$$.' , 'S')
	   sle_our_barcode.setfocus( )
	   sle_our_barcode.text = ''
	   return -1
	end if 
	
end if 

