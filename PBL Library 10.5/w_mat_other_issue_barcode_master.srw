end event

event modified;call super::modified;string LVS_PCB_ITEM , LVS_FEEDER_SHAFT , LVS_PRODUCTION_TYPE

DW_1.RESET()
LVS_LINE_CODE = this.getcode( )

SELECT DISTINCT SMT_MODEL_NAME  , PCB_ITEM , FEEDER_SHAFT 
    INTO :LVS_MODEL_NAME  , :LVS_PCB_ITEM  , :LVS_FEEDER_SHAFT
   FROM IB_PRODUCT_PLANDATA  
 WHERE LINE_CODE = :LVS_LINE_CODE 
     AND ACTIVE_YN = 'Y'
     AND ORGANIZATION_ID = :GVI_ORGANIZATION_ID ;

 IF F_SQL_CHECK() < 0 THEN
	RETURN 
END IF 

SELECT MAX(WORKSTAGE_CODE)
   INTO :LVS_WORKSTAGE_CODE 
 FROM IP_PRODUCT_WORKSTAGE 
WHERE WORKSTAGE_TYPE = 'S' 
     AND ORGANIZATION_ID = :GVI_ORGANIZATION_ID ;

 IF F_SQL_CHECK() < 0 THEN
	RETURN 
END IF 

//=======================================
// $$HEX5$$ddc0b0c0d0c51cc12000$$ENDHEX$$PDA $$HEX12$$5cb8200020c1ddd05cd52000ddc0b0c0200020c715d62000$$ENDHEX$$( $$HEX3$$91c5b0c02000$$ENDHEX$$, $$HEX3$$d8c00cd52000$$ENDHEX$$) $$HEX8$$44c7200070c88cd620005cd5e4b22000$$ENDHEX$$
//=======================================

SELECT PRODUCTION_TYPE INTO :LVS_PRODUCTION_TYPE 
 FROM IP_PRODUCT_LINE 
 WHERE LINE_CODE = :LVS_LINE_CODE 
   AND ORGANIZATION_ID = :GVI_ORGANIZATION_ID ;
	
 IF F_SQL_CHECK() < 0 THEN
	RETURN 
END IF 	

if  isnull(LVS_PRODUCTION_TYPE) or LVS_PRODUCTION_TYPE = '' or LVS_PRODUCTION_TYPE = '*' THEN 
//	ddlb_inventory_type.enabled = true 
	ddlb_inventory_type.selectitem(  LVS_PRODUCTION_TYPE , 1)
	ddlb_inventory_type.triggerevent( selectionchanged!)
else
//	ddlb_inventory_type.enabled = false 
	ddlb_inventory_type.selectitem(  LVS_PRODUCTION_TYPE , 1)
	ddlb_inventory_type.triggerevent( selectionchanged!)	
end  if 


ddlb_workstage_code.setfocus()
ddlb_workstage_code.text = LVS_WORKSTAGE_CODE 

sle_model_suffix.text = lvs_model_name
sle_model_suffix.triggerevent( modified! )

ddlb_top_bottom.selectitem( LVS_PCB_ITEM ,1)
ddlb_top_bottom.triggerevent( selectionchanged! )
 
dw_1.setfilter("")
dw_1.filter( )

if rb_request.checked = true then 
	f_retrieve()
end if 

end event

