// $$HEX7$$40c731c1200074c7fcc804d628c5$$ENDHEX$$
// fifo unlock $$HEX21$$84bcbcd244c72000b5d174d5200074d51cc8dcc22000c4ac8dc1200020c7c0c918b438ae200094c6adcc$$ENDHEX$$
// 2023/01/05 SHS
//======================================
// if Gvs_material_fifo_yn = 'Y' then 
//	cbx_material_fifo_yn.checked = true
// end if 

f_play_sound("Kittingok.wav")
st_status.text = 'OK'

IF lvs_suppliercode_compare = 'N' THEN  
	if Gvs_material_issue_compare_yn = 'Y' then 
		
		IF ( cbx_supplier_clear.checked = TRUE ) THEN   // Clear box $$HEX2$$00ac2000$$ENDHEX$$check-in $$HEX4$$78c7bdacb0c62000$$ENDHEX$$clear $$HEX2$$5cd5e4b2$$ENDHEX$$
		
		      sle_supplier_barcode.text = ''
			  sle_our_barcode.text = ''
	      	  dw_6.reset()
		       sle_supplier_barcode.setfocus()
			 
		ELSE
			
		      sle_our_barcode.text = ''
		      dw_6.reset()
		      sle_our_barcode.setfocus()			
			
		END IF
		
	else
		
		sle_our_barcode.text = ''
		dw_6.reset()
		sle_our_barcode.setfocus()
		
	end if 
	
ELSE
	
	sle_our_barcode.text = ''
	dw_6.reset()
	sle_our_barcode.setfocus()
	
END IF
end function

public function integer wf_issue_plan_query (string arg_type);long lvl_session_id  , lvl_bom_level
decimal lvf_plan_order_remain_qty , lvf_actual_qty


	lvs_line_code   = ddlb_line_code.getcode( ) 
	lvs_item_code  = ddlb_model_name.getitem( ) 
	
	//======================================
	//
	//======================================
	lvl_session_id = f_bom_query_prc(lvs_item_code, f_t_sysdate())
	
	lvs_workstage_code = ddlb_workstage_code.getcode()		
	
	if lvl_session_id < 1 then 
		F_MSG_MDI_HELP(F_MSG_ST1( 9051 , lvs_item_code ))
		dw_5.reset()
		rollback; 
	else 
		
	
		lvs_top_bot = ddlb_top_bottom.GETCODE()
		lvl_bom_level = 1000
		
		if arg_type = 'P' then  //$$HEX3$$98ccacb92000$$ENDHEX$$
		        
			     lvs_top_bot = '%'
				  
				  ddlb_top_bottom.selectitem( lvs_top_bot ,1)
				  
				dw_5.retrieve(lvl_session_id, lvf_plan_order_remain_qty , lvf_actual_qty ,  lvl_bom_level , lvs_line_code ,  lvs_workstage_code ,lvs_top_bot ,  gvi_organization_id)
				F_SET_REPLACE_ITEM_4_ISSUE_BOM_QUERY( dw_5 )
				dw_5.RESETUPDATE()
		end if 
	end if 
	
return 0
end function

public function integer wf_smt_bom_query (string arg_type);string lvs_include_yn 

if cbx_include_inventory.checked = true then 
   lvs_include_yn = 'Y'
else
   lvs_include_yn = 'N'
end if 
	
if arg_type  = 'P' then 
		
	dw_1.retrieve( ddlb_smt_model_name.getcode( ) , f_t_sysdate() ,  ddlb_line_code.getcode( ) , ddlb_top_bottom.getcode() , '%' ,  long(em_plan_qty.text)  , lvs_include_yn , gvi_organization_id ) 
	
	if dw_1.rowcount( ) < 1 then 
		f_play_sound("$$HEX8$$3cd554b308b874c744c5c3c6c6c54cc7$$ENDHEX$$.wav")
		Messagebox("Notify" , ddlb_smt_model_name.getcode( ) +"   "+ ddlb_line_code.getcode( ) + " Feeder Layout Not Found" )
		ddlb_smt_model_name.setfocus()
	end if 
	
else
	
	dw_4.retrieve( ddlb_smt_model_name.getcode(), f_t_sysdate() , ddlb_line_code.getcode( ) , '%' , ddlb_top_bottom.getcode(), GVI_ORGANIZATION_ID )
	
	if dw_4.rowcount( ) < 1 then 
		f_play_sound("$$HEX8$$3cd554b308b874c744c5c3c6c6c54cc7$$ENDHEX$$.wav")
		Messagebox("Notify" , ddlb_smt_model_name.getcode( ) +"   "+ ddlb_line_code.getcode( ) + " Feeder Layout Not Found" )
		ddlb_smt_model_name.setfocus() 
	end if 
//==================================================
//
//==================================================	
	
end if 

return 0
end function

