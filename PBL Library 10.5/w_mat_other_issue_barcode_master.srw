//						  FROM ID_ITEM
//						WHERE  WHERE PART_NO = :lvs_supplier_barcode  ; 
					
					lvs_supplier_barcode =  sle_supplier_barcode.text
					
                        SELECT  f_get_item_code_from_barcode (:lvs_supplier_barcode)
		                  INTO :lvs_supplier_item_code
	                     FROM DUAL ; 
		
		               IF ( F_SQL_CHECK() < 0 ) THEN 
			            	 sle_supplier_barcode.selecttext( 1,100)	
		               END IF 	
						
					lvi_pos_check = pos( lvs_supplier_item_code ,  lvs_compare_item_code , 1 ) 
					
					if lvi_pos_check <= 0 then 
						
							f_play_sound("scanfailed.wav")
							
	//						if cbx_show_message.checked = true then 
								   F_MSG( "$$HEX16$$fcd3a9ba88bc38d600ac20007cc758ce200058d5c0c920004ac5b5c2c8b2e4b2$$ENDHEX$$" , 'S')
	//						 end if 
								 
							st_status.text = F_MSG( "$$HEX16$$fcd3a9ba88bc38d600ac20007cc758ce200058d5c0c920004ac5b5c2c8b2e4b2$$ENDHEX$$" , 'S')
							sle_our_barcode.text  = ''
							sle_our_barcode.setfocus()
							return -1
							
