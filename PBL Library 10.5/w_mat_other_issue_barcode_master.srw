//==================================================
// $$HEX12$$74c7f8bb74c8acc7200058d594b2c0c92000b4cc6cd02000$$ENDHEX$$
//==================================================
LVS_SLIP_NO  = '' 
lvs_supplier_code = '' 
LVS_ISSUE_COMPARE_YN = ''
LVS_RECEIPT_COMPARE_YN = ''
LVS_LABEL_TYPE  = ''
LVL_MSL_PASSED_TIME = 0 

SELECT RECEIPT_SLIP_NO, 
            NVL(SUPPLIER_CODE ,'*'),
            NVL(ISSUE_COMPARE_YN , 'N') ,
		   NVL(RECEIPT_COMPARE_YN , 'N') ,
		   NVL(LABEL_TYPE , 'N') ,
		   NVL( MANUFACTURE_DATE , RECEIPT_COMPARE_DATE ) ,
		   F_GET_MSL_PASSED_TIME(ITEM_BARCODE),   //NVL(MSL_PASSED_TIME,0),	
		   SCAN_QTY  // DECODE ( NVL(NEW_SCAN_QTY,0)  , 0 , SCAN_QTY , NEW_SCAN_QTY ) 	
   INTO :LVS_SLIP_NO , 
	       :lvs_supplier_code , 
		  :LVS_ISSUE_COMPARE_YN,
		  :LVS_RECEIPT_COMPARE_YN,
		  :LVS_LABEL_TYPE ,
		  :LVDT_RECEIPT_COMPARE_DATE ,
		  :LVL_MSL_PASSED_TIME,
		  :lvl_issue_qty
  FROM IM_ITEM_RECEIPT_BARCODE
 WHERE LOT_NO      = :LVS_LOT_NO
     AND  ITEM_CODE = :LVS_ITEM_CODE
      AND ORGANIZATION_ID = :GVI_ORGANIZATION_ID ;

IF F_SQL_CHECK() < 0 THEN 
	sle_our_barcode.text = ''
	sle_our_barcode.setfocus()
	RETURN -1
END IF 

if  LVS_SLIP_NO = '' OR ISNULL(LVS_SLIP_NO)  then
		f_play_sound("$$HEX6$$acc2bdb974c725b8c6c54cc7$$ENDHEX$$.wav")	
//		if cbx_show_message.checked = true then 
			 F_MSG( 'SLIP Scan Not Found : Slip $$HEX7$$a4c294ce200074c725b8c6c54cc7$$ENDHEX$$' , 'P' )
//		 end if 		
		
		st_status.text = F_MSG( 'Slip $$HEX7$$a4c294ce200074c725b8c6c54cc7$$ENDHEX$$'  , 'S') // '$$HEX5$$204f68797e620d4e3052$$ENDHEX$$
		sle_our_barcode.text = ''
		sle_our_barcode.setfocus()
		return -1
end if 

//==================================================
//  $$HEX5$$18c2c9b72000b4cc6cd0$$ENDHEX$$
//==================================================
if lvl_issue_qty <=0 then 
	
	f_play_sound("scanfailed.wav")		
	 F_MSG( "$$HEX15$$9ccde0ac18c2c9b774c720002cc614bc74b9c0c920004ac5b5c2c8b2e4b2$$ENDHEX$$" , 'P')
	st_status.text = F_MSG( "$$HEX15$$9ccde0ac18c2c9b774c720002cc614bc74b9c0c920004ac5b5c2c8b2e4b2$$ENDHEX$$"	 ,'S')

	sle_our_barcode.text = ''
	sle_our_barcode.setfocus()
	return -1
end if 

//======================================================
//
