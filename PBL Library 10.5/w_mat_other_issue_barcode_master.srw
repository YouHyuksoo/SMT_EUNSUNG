string lvs_error_check, lvs_msl_level , LVS_MODEL_NAME , LVS_ITEM_CLASS , LVS_INVENTORY_TYPE = 'P' , lvs_manufacture_week


end variables

forward prototypes
public function integer wf_issue_barcode (string arg_type)
public function integer wf_issue_plan_query (string arg_type)
public function integer wf_smt_bom_query (string arg_type)
end prototypes

public function integer wf_issue_barcode (string arg_type);long lvl_cnt, lvl_reurn_count, lvl_moq_qty, lvl_scan_barcode_qty
string lvs_supplier_item_code , LVS_PCB_COATING_DATE_OK_YN, lvs_message

// lvs_suppliercode_compare = 'Y' $$HEX31$$78c72000bdacb0c694b2200070ac98b798cc200014bc54cfdcb444c6200090c7acc014bc54cfdcb47cb9200044be50ad58d594b220007cc718bc5cb8c1c9$$ENDHEX$$
// 'N' $$HEX23$$78c72000bdacb0c694b2200070ac98b798cc200014bc54cfdcb47cb9200044be50ad58d5c0c920004ac594b2e4b2$$ENDHEX$$..$$HEX2$$04d6acc7$$ENDHEX$$(2016$$HEX1$$44b1$$ENDHEX$$03$$HEX1$$d4c6$$ENDHEX$$)$$HEX5$$94b2200020c731c12000$$ENDHEX$$1$$HEX5$$f5aca5c720007cc7e0c2$$ENDHEX$$(11$$HEX2$$7cb778c7$$ENDHEX$$) $$HEX15$$9ccde0acdcc22000acc0a9c658d530ae200004c774d52000ccb9ecb42000$$ENDHEX$$

IF lvs_suppliercode_compare = 'N' THEN  
		//==============================================
		//  $$HEX10$$e4c27cb7a8bc200029bcddc2200074c774ba2000$$ENDHEX$$
		//==============================================
		if arg_type = 'N' then 
			lvs_supplier_barcode  = sle_supplier_barcode.text
			lvs_our_barcode         = sle_our_barcode.text
		else
			  //$$HEX9$$08c604c814bc54cfdcb494b2200088d4a9ba$$ENDHEX$$+$$HEX9$$6fb8b8d220005cb8ccb920006cad31c12000$$ENDHEX$$
			lvs_supplier_barcode  =sle_supplier_barcode.text
			lvs_our_barcode = sle_our_barcode.text+"-"+sle_qty.text
		end if 
		
		//=======================================
		// 
		//=======================================

				 SELECT  f_get_prepare_supplier_barcode (:lvs_supplier_barcode)
					  INTO :lvs_supplier_barcode
					 FROM DUAL ; 
				
				IF F_SQL_CHECK() < 0 THEN 
						sle_supplier_barcode.selecttext( 1,100)	
				END IF 	 
	
		//=======================================
		// 
		//=======================================
	
				
			 SELECT  f_get_prepare_barcode (:lvs_our_barcode)
					  INTO :lvs_our_barcode
					 FROM DUAL ; 
				
				IF F_SQL_CHECK() < 0 THEN 
						sle_supplier_barcode.selecttext( 1,100)	
				END IF 	 
	
		
		if   gvs_material_issue_compare_yn = 'Y' and  lvs_supplier_barcode = '' then 
			sle_supplier_barcode.setfocus()
			sle_supplier_barcode.selecttext( 1,100)
			return -1 
		end if 
		
		if lvs_our_barcode = '' then 
			sle_our_barcode.setfocus()
			sle_our_barcode.selecttext( 1,100)
			return -1 
		end if 
ELSE
	    //==============================================
		//  $$HEX10$$e4c27cb7a8bc200029bcddc2200074c774ba2000$$ENDHEX$$
		//==============================================
		if arg_type = 'N' then 
			lvs_our_barcode = sle_our_barcode.text
		else
			lvs_our_barcode = sle_our_barcode.text+"-"+sle_qty.text
		end if 
		
		 SELECT  f_get_prepare_barcode (:lvs_our_barcode)
	  	  INTO :lvs_our_barcode
		 FROM DUAL ; 
				
		 IF F_SQL_CHECK() < 0 THEN 
				sle_supplier_barcode.selecttext( 1,100)	
		 END IF 	 
			
		if lvs_our_barcode = '' then 
			sle_our_barcode.setfocus()
			sle_our_barcode.selecttext( 1,100)
			return -1 
		end if 
END IF

//=====================================================================
//
//=====================================================================
if ddlb_line_code.getcode( ) = '%' or ddlb_line_code.getcode( ) = '' or ddlb_line_code.getcode( ) = '*' then
	f_msgbox1(111 , "Line")
	st_status.text = f_msg_st1(111 , "Line")
	sle_our_barcode.selecttext( 1,100)	
	ddlb_line_code.setfocus()
	return -1
end if 

if ddlb_workstage_code.getcode( ) = '%' or ddlb_workstage_code.getcode( ) = '' or ddlb_workstage_code.getcode( ) = '*' then
	f_msgbox1(111 , "Workstage")
	st_status.text = f_msg_st1(111 , "Workstage")
	sle_our_barcode.selecttext( 1,100)	
	ddlb_line_code.setfocus()
	return -1
end if 

//=====================================================================
//
//=====================================================================
IF lvs_suppliercode_compare = 'N' THEN  
	if Gvs_material_issue_compare_yn = 'Y' then 
		
			if lvs_supplier_barcode = lvs_our_barcode then 
				
				f_play_sound("scanfailed.wav")	
				  f_msgbox(198)
				st_status.text =  f_msg_st( 198) // "$$HEX19$$d9b37cc75cd5200014bc54cfdcb47cb92000a4c294ce200058d574ba200048c529b4c8b2e4b2$$ENDHEX$$"
				
				sle_our_barcode.text = ''
				sle_supplier_barcode.text = ''
				sle_supplier_barcode.setfocus()
				return -1 
			end if 
	end if 
END IF

lvs_line_code = ddlb_line_code.getcode( )
lvs_workstage_code = ddlb_workstage_code.getcode()
lvs_inventory_type = ddlb_inventory_type.getcode()

//$$HEX3$$18c215c82000$$ENDHEX$$2016.05.12 ZETHANI 
if rb_issue_plan.checked = true then //$$HEX15$$c4d6f5ac15c820007cc74cb52000a8ba78b3200000ac38c824c630ae2000$$ENDHEX$$
    LVS_MODEL_NAME = ddlb_model_name.GETcode( )
else                                               //$$HEX4$$f8ad78c694b22000$$ENDHEX$$smt $$HEX8$$a8ba78b3200000ac38c824c630ae2000$$ENDHEX$$
   LVS_MODEL_NAME = ddlb_SMT_model_name.GETcode( )
end if 

//==================================================
//  $$HEX6$$88d4a9ba200054cfdcb42000$$ENDHEX$$
//  - $$HEX15$$6cad84bd90c700ac2000c6c53cc774ba200024c658b9200098ccacb92000$$ENDHEX$$
//==================================================

//lvi_pos1 =  pos(lvs_our_barcode , '-' , 7 ) 
//
//if  lvi_pos1 <= 0 then 
//	
//	f_msgbox1(1175 ,lvs_our_barcode )
//	sle_our_barcode.text = ''
//	sle_our_barcode.setfocus()
//	return -1 
//	
//end if 
//
//lvs_item_code = trim( mid( lvs_our_barcode , 1 ,  lvi_pos1 -1 ))


	SELECT  f_get_item_code_from_barcode (:lvs_our_barcode) 
	INTO :lvs_item_code
	FROM DUAL ; 
	
	IF F_SQL_CHECK() < 0 THEN 
		sle_our_barcode.selecttext( 1,100)	
	END IF 	 
	
	if  lvs_item_code = '' then 
		
		f_play_sound("$$HEX5$$88d4a9baf8bbf1b45db8$$ENDHEX$$.wav")
		f_msgbox1(1175 ,lvs_our_barcode )
		sle_our_barcode.setfocus()
		sle_our_barcode.selecttext( 1,100)
		return -1 
end if 


//====================================================
// $$HEX15$$fcc8e0ac1dac200054cfdcb400ac2000f4bc6cc278c72000bdacb0c62000$$ENDHEX$$AND $$HEX8$$6cad7cb7a8bc78c72000bdacb0c62000$$ENDHEX$$R, D $$HEX2$$1cc870ac$$ENDHEX$$-- $$HEX6$$88d4a9ba200044be50addcc2$$ENDHEX$$, bom$$HEX6$$44be50addcc22000acc0a9c6$$ENDHEX$$
//====================================================
  select  SUPPLIER_CODE , ITEM_CLASS
     into :lvs_suppliercode , :LVS_ITEM_CLASS
   from id_item
 where item_code = :lvs_item_code
     and organization_id = :gvi_organization_id  ;
	  
if f_sql_check() < 0 then 
	sle_supplier_barcode.text = ''
	sle_our_barcode.text = ''
	sle_our_barcode.setfocus()
	RETURN -1
end if 	  


lvs_compare_item_code = lvs_item_code

if f_check_item_exists( lvs_item_code , f_t_sysdate())  <= 0 then 
	f_play_sound("scanfailed.wav")	
	f_msgbox(9041) //$$HEX10$$fcd3a9bac8b9a4c230d12000f8bbf1b45db82000$$ENDHEX$$
	st_status.text =f_msg_st(9041)
	sle_our_barcode.text = ''
	sle_our_barcode.setfocus()
	return -1
end if 


//=========================================================
//  $$HEX11$$9ccde0ac200098ccacb9200004d55cb838c1a4c22000$$ENDHEX$$
//=========================================================

lvs_line_type = f_get_line_type_from_item( lvs_item_code )

//==========================================
// 4m $$HEX8$$c0bcbdac200088d42000b4cc6cd02000$$ENDHEX$$
//==========================================
select eco_check_yn , eco_check_comments 
   into :lvs_eco_check_yn , :lvs_eco_check_comments 
  from id_item
 where item_code = :lvs_item_code
     and organization_id = :gvi_organization_id  ;
	  
	if f_sql_check() < 0 then 
		sle_supplier_barcode.text = ''
		sle_our_barcode.text = ''
		sle_our_barcode.setfocus()
		RETURN -1
	end if 

if lvs_eco_check_yn = 'Y' then 
	//f_play_sound("scanfailed.wav")
	f_play_sound("$$HEX5$$ecd3e0c5c0bcbdac88d4$$ENDHEX$$.wav")
	Gst_return.gvs_return[1] = lvs_eco_check_comments
	openwithparm(w_item_eco_notify_image_popup , lvs_item_code ) 
end if 

//==================================================
// $$HEX9$$acc7e0ac200040d629b52000b4cc6cd02000$$ENDHEX$$
//==================================================
if f_check_item_inventory_hold_yn( lvs_item_code , 'M01' ) ='Y' then 
	//f_play_sound("scanfailed.wav")
	f_play_sound("$$HEX5$$40d629b51cb490c7acc7$$ENDHEX$$.wav")
//	if cbx_show_message.checked = true then 
	   F_MSG("Holding Material : $$HEX13$$04c8b4cc200040d629b51cb4200090c7acc7200085c7c8b2e4b2$$ENDHEX$$. " , 'P')
//	 end if 
	
	st_status.text = F_MSG( "Holding Material : $$HEX13$$04c8b4cc200040d629b51cb4200090c7acc7200085c7c8b2e4b2$$ENDHEX$$." , 'S')
	sle_our_barcode.text = ''
	sle_our_barcode.setfocus()
	return -1
end if 

