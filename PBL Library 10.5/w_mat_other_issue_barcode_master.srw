event selectionchanged;call super::selectionchanged;String lvl_division, lvs_linecd
ddlb_workstage_code.setfocus()


lvs_linecd =  this.getcode()

sle_supplier_barcode.enabled = true
lvs_suppliercode_compare = 'N'
