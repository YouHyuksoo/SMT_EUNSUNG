			//$$HEX18$$3cba00c8200011b619ac40c7200018b174c7200088c794b2c0c920003ecc94b2e4b22000$$ENDHEX$$
			ll_row = dw_3.find ( "( item_code='" + lvs_item_code +"' ) and ( item_barcode = '"+lvs_our_barcode+"')"  , 1, dw_3.rowcount())
			if ll_row > 0 then 
				
				f_play_sound("Eixst.wav")
				F_MSG(  "Already  Scan : $$HEX14$$74c7f8bb2000a4c294ce20005cd5200090c7acc7200085c7c8b2e4b2$$ENDHEX$$" , 'P')
				st_status.text = F_MSG("$$HEX14$$74c7f8bb2000a4c294ce20005cd5200090c7acc7200085c7c8b2e4b2$$ENDHEX$$",'S')  //$$HEX6$$f25dcf7e6b62cf63864e2000$$ENDHEX$$: 
	
				sle_our_barcode.text = ''
				sle_our_barcode.setfocus()
				return -1
			end if 
			
			//$$HEX16$$b4cc6cd048c51cb420008cac2000200088c794b2c0c920003ecc94b2e4b22000$$ENDHEX$$
