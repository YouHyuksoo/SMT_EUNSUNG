IF  LVS_LABEL_TYPE  =  'R'  THEN 
	lvs_location_code = 'M06' //$$HEX11$$acb98cbc00aca5b2200000b330ae20003dcce0ac2000$$ENDHEX$$
ELSEIF LVS_LABEL_TYPE  = 'B' THEN
	lvs_location_code = 'M05' // $$HEX5$$8cbc6cd03dcce0ac2000$$ENDHEX$$
ELSE	
	lvs_location_code = 'M01'  //$$HEX5$$91c5b0c03dcce0ac2000$$ENDHEX$$
END IF 

//=======================================================
//
//=======================================================

if LVS_RECEIPT_COMPARE_YN = 'N'  then 
	
		f_play_sound("$$HEX6$$acc2bdb974c725b8c6c54cc7$$ENDHEX$$.wav")	
		
//		if cbx_show_message.checked = true then 
			  F_MSG(  '$$HEX7$$85c7e0ac74c725b82000c6c54cc7$$ENDHEX$$' , 'P' )
//		 end if 		
		 
		st_status.text =  F_MSG('$$HEX8$$85c7e0ac200074c725b82000c6c54cc7$$ENDHEX$$' , 'S') //$$HEX8$$6551935e655c86537e620d4e30522000$$ENDHEX$$:
		sle_supplier_barcode.text = ''
		sle_our_barcode.text = ''
		sle_supplier_barcode.setfocus()
		return -1	
	
end if 

//===================================================
//
//===================================================
if LVS_ISSUE_COMPARE_YN = 'Y'  then
	f_play_sound("Eixst.wav")
     F_MSG( '$$HEX11$$74c7f8bb20009ccde0ac200018b4c8c5b5c2c8b2e4b2$$ENDHEX$$' , 'P' )
	st_status.text =  F_MSG('$$HEX11$$74c7f8bb20009ccde0ac200018b4c8c5b5c2c8b2e4b2$$ENDHEX$$' ,'S') //$$HEX5$$f25dcf7efa51935e864e$$ENDHEX$$: 
	
	sle_our_barcode.setfocus( )
	sle_our_barcode.text = ''
