type variables
string ivs_preview_yn = 'N' , lvs_eco_check_yn , lvs_eco_check_comments 
string lvs_mfs ,   lvs_supplier_barcode , lvs_our_barcode , lvs_our_barcode_return ,  lvs_lot_no , lvs_item_code  , lvs_slip_no ,LVS_RECEIPT_COMPARE_YN ,  LVS_ISSUE_COMPARE_YN
string  lvs_line_type , LVS_SUPPLIER_CODE , lvs_line_code  , lvs_workstage_code , lvs_top_bot , LVS_LABEL_TYPE , lvs_location_code , lvs_feeder_location_code
