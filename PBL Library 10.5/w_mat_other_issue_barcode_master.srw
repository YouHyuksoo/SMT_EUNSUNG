//									//  openwithparm(w_com_message_popup,  f_msg_st(9112)+"~r~n " + " - VENDOR CODE : "+lvs_vendor_code+" ~r~n " + " - VENDOR LOT : "+lvs_vendor_lot+" ~r~n ")
//							end if     
//			
//			 end if
//			 
// end if


//==========================================
//IQC $$HEX11$$80acacc0200030ae00c920002000b4cc6cd020002000$$ENDHEX$$
//==========================================

STRING LVS_INSPECT_RULE

 SELECT MIN(INSPECT_RULE ) INTO :LVS_INSPECT_RULE
  FROM IM_ITEM_MASTER 
 WHERE ITEM_CODE = :LVS_ITEM_CODE
    AND ORGANIZATION_ID = :GVI_ORGANIZATION_ID ;
	 
IF F_SQL_CHECK() < 0 THEN 
	sle_our_barcode.selecttext( 1,100)	
END IF 	  
	 
IF 	 LVS_INSPECT_RULE = 'P' THEN 
	 CBX_IQC_CHECK.CHECKED = FALSE
ELSE
	 CBX_IQC_CHECK.CHECKED = TRUE
END IF 




//=====================================================================
// $$HEX23$$a0bc74c7b9d0200010b694b2200020001cc8b5c285c7e0ac2000c1c0dcd078c7c0c9200055d678c72000c4d62000$$ENDHEX$$NG
//=====================================================================

	   select max(f_get_machine_name( chamber_code )), count(*)
          into :lvs_machine_name, :lvi_row_count
        from im_item_baking_master
       where item_barcode like :lvs_scan_barcode
          and output_scan_date is null;
        
            
       IF ( lvi_row_count > 0 ) THEN

             f_play_sound("scanfailed.wav")   
             messagebox('Notice',  lvs_machine_name + '$$HEX13$$d0c52000f8bb9ccde0ac20001cb4200090c7acc785c7c8b2e4b2$$ENDHEX$$.')   // $$HEX13$$f8bb9ccde0ac20001cb4200090c7acc7200085c7c8b2e4b22000$$ENDHEX$$!!
   
	        sle_our_barcode.text = ''
            sle_supplier_barcode.text = ''
            sle_supplier_barcode.setfocus()
            return

       END IF;     
		 
//=====================================================================
		 
 
SELECT location_code , inventory_type , pcb_coating_date , manufacture_week
   INTO :lvs_location_code , :lvs_inventory_type , :lvdt_pcb_coating_date , :lvs_manufacture_week
  FROM IM_ITEM_INVENTORY   
 WHERE MATERIAL_MFS = :lvs_lot_no
     AND ORGANIZATION_ID = 1 ;
   
if f_sql_check() < 0 then 
   return 
end if 

IF lvs_location_code = 'M02'  then
      
    f_play_sound("scanfailed.wav")   
    messagebox('notice', f_msg_st(9113))   // $$HEX18$$88bdc9b788d43cc75cb82000f1b45db820001cb4200090c7acc7200085c7c8b2e4b22000$$ENDHEX$$!!
     //st_status.text = f_msg_st(9113)   
     
     sle_our_barcode.text = ''
     sle_supplier_barcode.text = ''
     sle_supplier_barcode.setfocus()
     return
   END IF




//==========================================
// IQC 
//==========================================

IF CBX_IQC_CHECK.CHECKED = TRUE THEN 
		INT LVI_IQC_CHECK = 0 
		
		SELECT COUNT(*) INTO :LVI_IQC_CHECK
		 FROM im_item_receipt_barcode
		WHERE LOT_NO = :LVS_LOT_NO
		    AND INSPECT_RESULT = 'P'
			AND ORGANIZATION_ID = :GVI_ORGANIZATION_ID ;
			  
			IF F_SQL_CHECK() < 0 THEN 
					sle_our_barcode.selecttext( 1,100)	
			END IF 	 
		
		if LVI_IQC_CHECK = 0  then 
			st_status.text =F_MSG( "IQC $$HEX19$$88bd69d5a9ac200074c770ac98b0200010d315c8200074c725b874c72000c6c5b5c2c8b2e4b2$$ENDHEX$$", 'S') 
			F_MSG( "IQC $$HEX19$$88bd69d5a9ac200074c770ac98b0200010d315c8200074c725b874c72000c6c5b5c2c8b2e4b2$$ENDHEX$$", 'P') 
			sle_our_barcode.setfocus()
			sle_our_barcode.selecttext( 1,100)	
			return -1
		end if 
END IF 


//=====================================================================
// $$HEX12$$88bdc9b72000acc7e0ac200078c7c0c92000b4cc6cd02000$$ENDHEX$$
//=====================================================================
 
SELECT location_code , inventory_type , pcb_coating_date , manufacture_week
   INTO :lvs_location_code , :lvs_inventory_type , :lvdt_pcb_coating_date , :lvs_manufacture_week
  FROM IM_ITEM_INVENTORY   
 WHERE MATERIAL_MFS = :lvs_lot_no
     AND ORGANIZATION_ID = 1 ;
   
if f_sql_check() < 0 then 
   return 
end if 

IF lvs_location_code = 'M02'  then
      
    f_play_sound("scanfailed.wav")   
    messagebox('notice', f_msg_st(9113))   // $$HEX18$$88bdc9b788d43cc75cb82000f1b45db820001cb4200090c7acc7200085c7c8b2e4b22000$$ENDHEX$$!!
     //st_status.text = f_msg_st(9113)   
     
     sle_our_barcode.text = ''
     sle_supplier_barcode.text = ''
     sle_supplier_barcode.setfocus()
     return
   END IF

// $$HEX19$$acc7e0ac94b22000d8c00cd5200074c7e0ac2000ddc0b0c040c7200091c5b0c074c774ba2000$$ENDHEX$$
IF lvs_inventory_type ='S' and   ddlb_inventory_type.getcode() = 'P' THEN 
	
	f_msg( "$$HEX24$$ddc0b0c0200020c715d6fcac2000acc7e0ac200020c715d674c720007cc758ce200058d5c0c920004ac5b5c2c8b2e4b2$$ENDHEX$$" , "P" )
     sle_our_barcode.text = ''
     sle_supplier_barcode.text = ''
     sle_supplier_barcode.setfocus()	
	RETURN 
END IF 

IF lvs_inventory_type ='P' and   ddlb_inventory_type.getcode() = 'S' THEN 
	
	f_msg( "$$HEX24$$ddc0b0c0200020c715d6fcac2000acc7e0ac200020c715d674c720007cc758ce200058d5c0c920004ac5b5c2c8b2e4b2$$ENDHEX$$" , "P" )
     sle_our_barcode.text = ''
     sle_supplier_barcode.text = ''
     sle_supplier_barcode.setfocus()	
	RETURN 
END IF 

//$$HEX24$$acc7e0ac94b22000d8c00cd578c770b32000ddc0b0c0200020c715d640c7200020c1ddd0200048c588d544c74cb52000$$ENDHEX$$
IF lvs_inventory_type ='S' and   ( ddlb_inventory_type.getcode()  = '' or  ddlb_inventory_type.getcode() <> 'S' ) THEN 
	
	f_msg( "$$HEX5$$ddc0b0c0200020c715d6$$ENDHEX$$($$HEX4$$4cc518c2c6c54cc7$$ENDHEX$$) $$HEX19$$fcac2000acc7e0ac200020c715d674c720007cc758ce200058d5c0c920004ac5b5c2c8b2e4b2$$ENDHEX$$" , "P" )
     sle_our_barcode.text = ''
     sle_supplier_barcode.text = ''
     sle_supplier_barcode.setfocus()	
	RETURN 
END IF 



//========================================
//
//========================================
   wf_issue_barcode('N')


end event

event getfocus;call super::getfocus;

//=====================================================================
//  $$HEX7$$d0c690c7acc720007cb7a8bc2000$$ENDHEX$$check
//=====================================================================

if cbx_no_barcode.checked = FALSE then
	
   if sle_supplier_barcode.text = '' then
		
 	  f_msgbox1(111 , "$$HEX7$$70ac98b798cc200014bc54cfdcb4$$ENDHEX$$")
      st_status.text = f_msg_st1(111 , "$$HEX7$$70ac98b798cc200014bc54cfdcb4$$ENDHEX$$")
      sle_our_barcode.text = ''
      sle_supplier_barcode.setfocus()
	
	  return
	
   end if
	
end if
end event

