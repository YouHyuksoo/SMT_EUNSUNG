	if Gvs_material_issue_compare_yn = 'Y' then 
	
				lvi_pos_check = pos( lvs_supplier_barcode ,  lvs_compare_item_code , 1 ) 
				
				if lvi_pos_check <= 0 then 
					
//						 SELECT ITEM_CODE
