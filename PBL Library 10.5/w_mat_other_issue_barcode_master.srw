event clicked;call super::clicked;openwithparm(w_pln_smd_plan_popup , string(ddlb_line_code.getcode()) )

if gst_return.gvb_return = true then 
	sle_mfs.text = MESSAGE.STRINGPARM 
	ddlb_inventory_type.selectitem(  gst_return.gvs_return[10] , 1)
	ddlb_inventory_type.triggerevent( selectionchanged!)
else
end if 
end event

