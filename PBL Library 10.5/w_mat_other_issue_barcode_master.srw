			IF ll_row <= 0 THEN 
				
				f_play_sound( "scanfailed.wav")
				st_status.text = F_MSG( "Request Not Found : $$HEX14$$e0c2adcc2000d0c52000c6c594b2200090c7acc7200085c7c8b2e4b2$$ENDHEX$$" , 'S' )
				F_MSG("Request Not Found : $$HEX14$$e0c2adcc2000d0c52000c6c594b2200090c7acc7200085c7c8b2e4b2$$ENDHEX$$" , 'P' )
		
				sle_our_barcode.text = ''
				sle_our_barcode.setfocus()
