//=========================================================
//
//=========================================================
IF cbx_msl_time_check.checked = True THEN 
 
     //============================================
     // MSL$$HEX6$$90c7acc7ecc580bdb4cc6cd0$$ENDHEX$$--MSL$$HEX16$$20c7a8d6dcc204ac35c658c1200020c1ddd0200088d544c72000bdacb0c62000$$ENDHEX$$MSL$$HEX9$$90c7acc778c7bdacb0c6ccb92000b4cc6cd0$$ENDHEX$$
     //============================================
     SELECT NVL(msl_level, '0')
        INTO :lvs_msl_level
      FROM  id_item
     WHERE item_code = :lvs_item_code
         AND organization_id = :gvi_organization_id  ;
	  
	IF F_SQL_CHECK() < 0 THEN 
		sle_our_barcode.text = ''
		sle_our_barcode.setfocus()
		return -1 
	END IF 		 
	
	IF  lvs_msl_level > '2'  THEN
		SELECT NVL(f_get_mat_msl_max_time( :lvs_item_code) ,0)
			 INTO :LVL_MAX_MSL_TIME 
			FROM DUAL ;
		  
		 IF F_SQL_CHECK() < 0 THEN 
		
				sle_our_barcode.text = ''
				sle_our_barcode.setfocus()
				return -1 
		END IF 		 
		
		 IF LVL_MAX_MSL_TIME >= LVL_MSL_PASSED_TIME	 THEN	
				
				st_status.text = "$$HEX5$$20c7a8d6dcc204ac2000$$ENDHEX$$"+ STRING( long(LVL_MAX_MSL_TIME - LVL_MSL_PASSED_TIME) ) +" $$HEX5$$a8b058c5b5c2c8b2e4b2$$ENDHEX$$"
		 
		ELSE
		
				f_play_sound("scanfailed.wav")
				
				st_status.text =F_MSG( "MSL TIME Over : $$HEX12$$20c7a8d6dcc204ac200008cdfcac20009ccde0ac88bd00ac$$ENDHEX$$" , 'S')
				F_MSG("MSL TIME Over : $$HEX12$$20c7a8d6dcc204ac200008cdfcac20009ccde0ac88bd00ac$$ENDHEX$$" , 'P' )
		
				sle_our_barcode.text = ''
				sle_our_barcode.setfocus()
				return -1						
		
		END IF 
		
	END IF
	
END IF
//=========================================================
// $$HEX9$$18c285ba2000fcc830ae200000adacb92000$$ENDHEX$$
//=========================================================
if  cbx_life_cycle_check.checked = true then
	
	  select nvl( life_cycle , 365) 
	     into :lvl_life_cycle 
	   from id_item 
      where item_code = :lvs_item_code 
		  and organization_id = :gvi_organization_id ;
		  
	 IF F_SQL_CHECK() < 0 THEN 
	
			sle_our_barcode.text = ''
			sle_our_barcode.setfocus()
			return -1 
	END IF 			  

	select trunc(sysdate - nvl(last_receipt_date, enter_date) ,0) 
	  into :lvl_life_cycle_passed
	 from im_item_inventory 
	where item_code = :lvs_item_code
	   and material_mfs = :lvs_lot_no
	   and organization_id = :gvi_organization_id ;
		
	 IF F_SQL_CHECK() < 0 THEN 
		
			sle_our_barcode.text = ''
			sle_our_barcode.setfocus()
			return -1 
	END IF 	

	 IF lvl_life_cycle_passed > lvl_life_cycle	 THEN	
			st_status.text = "$$HEX5$$20c7a8d6dcc204ac2000$$ENDHEX$$"+ STRING( long( lvl_life_cycle - lvl_life_cycle_passed ) ) +" $$HEX5$$a8b058c5b5c2c8b2e4b2$$ENDHEX$$"
	ELSE
	
			f_play_sound("scanfailed.wav")
			st_status.text = F_MSG( "Life Cycle Over : $$HEX13$$18c285ba2000fcc830ae200008cdfcac20009ccde0ac88bd00ac$$ENDHEX$$" , 'S')
			F_MSG("$$HEX6$$55d678c7200058d538c194c6$$ENDHEX$$" , 'P' )

			sle_our_barcode.text = ''
			sle_our_barcode.setfocus()
			return -1						
	END IF 
end if 

//====================================================
// $$HEX13$$9ccde0ac200044c6ccb820000cd598b7f8ad200024c115c82000$$ENDHEX$$
//====================================================
	UPDATE IM_ITEM_RECEIPT_BARCODE
	      SET  ISSUE_COMPARE_YN = 'Y' ,
			     ISSUE_COMPARE_DATE = SYSDATE  , 
				ISSUE_COMPARE_BY = :GVS_USER_ID ,
				ISSUE_RETURN_YN = 'N' ,
				LINE_CODE = :LVS_LINE_CODE ,
		         FEEDING_MODEL = :LVS_MODEL_NAME,
				WORKSTAGE_CODE = :LVS_WORKSTAGE_CODE ,
				LOCATION_CODE = :LVS_FEEDER_LOCATION_CODE ,
				FEEDING_YN = 'N' ,
				FEEDING_DATE = NULL 
	  WHERE  LOT_NO = :lvs_lot_no
       	  AND  ITEM_CODE = :LVS_ITEM_CODE
	       AND ORGANIZATION_ID = :GVI_ORganization_id ;
			 
     if f_sql_check() <  0 then 
			sle_supplier_barcode.text = ''
			sle_our_barcode.text = ''
			sle_supplier_barcode.setfocus()
		return -1 
	end if 
	
	LVS_MFS = sle_mfs.text

			   INSERT INTO IM_ITEM_ISSUE  
						         ( ITEM_CODE,   
						           ISSUE_DATE,   
						           ISSUE_SEQUENCE,   
						           ORGANIZATION_ID,   
						           MFS,   
						           LOCATION_CODE,   
						           ITEM_TYPE,   
						           LINE_CODE,   
						           WORKSTAGE_CODE,   
						           ISSUE_DEFICIT,   
						           ISSUE_QTY,   
						           ISSUE_STATUS,   
						           ISSUE_AMT,   
						           ISSUE_ACCOUNT,   
						           LINE_TYPE,   
						           COMMENTS,   
						           ISSUE_PRICE,   
						           VIRTUAL_RECEIPT_YN,   
						           ISSUE_TYPE,   
						           SUPPLIER_CODE,   
						           WORK_ORDER_NO,   
						           ENTER_DATE,   
						           ENTER_BY,   
						           LAST_MODIFY_DATE,   
						           LAST_MODIFY_BY,   
						           MACHINE_CODE,   
						           INVOICE_NO,   
						           MADE_BY,   
						           PARENT_ITEM_CODE,   
						           MATERIAL_MFS,   
						           INTERFACE_YN,   
						           INTERFACE_DATE,   
						           SALE_PRICE,   
						           SALE_AMT,   
						           SALE_CURRENCY,   
						           ARRIVAL_DATE,   
						           ARRIVAL_SEQ_NO,   
						           DEST_ORGANIZATION_ID,   
						           INSPECT_NO,   
						           RETURN_REQUEST_DATE,   
						           RETURN_REQUEST_SEQUENCE,   
						           CLOSE_YN,   
						           CLOSE_DATE,   
						           DEMAND_QTY ,
								  BARCODE ,
								  ORIGIN_MFS,
								  FEEDER_LOCATION_CODE,
								  ISSUE_DIVISION,
								  MODEL_NAME,
								  INVENTORY_TYPE,
								  MSL_PASSED_TIME)  
						VALUES  (  :lvs_item_code,      //ITEM_CODE, 
						            trunc(sysdate) ,      //ISSUE_DATE,   
						            SEQ_MAT_ISSUE.NEXTVAL ,      //ISSUE_SEQUENCE,   
						            :GVI_ORGANIZATION_ID ,      //ORGANIZATION_ID,   
						            nvl(:LVS_MFS, '*') ,      //MFS,   
						            :lvs_location_code,      //LOCATION_CODE,   
						            'T',      //ITEM_TYPE,   
						            :lvs_line_code,      //LINE_CODE,   
						            :lvs_workstage_code,      //WORKSTAGE_CODE,   
						            3,      //ISSUE_DEFICIT,   
						            :lvl_issue_qty ,      //ISSUE_QTY,   
						            'N',      //ISSUE_STATUS,   
						            0 ,      //ISSUE_AMT,   
						            'M001',      //ISSUE_ACCOUNT,   
						            :lvs_line_type , // 'F' ,      //LINE_TYPE,   
						            NULL,  //COMMENTS,   
						            0 ,      //ISSUE_PRICE,   
						            NULL,      //VIRTUAL_RECEIPT_YN,   
						            'N',      //ISSUE_TYPE,   
						            :lvs_supplier_code ,      //SUPPLIER_CODE,   
						            '*',      //WORK_ORDER_NO,   
						            sysdate ,      //ENTER_DATE,   
						           :gvs_user_id ,      //ENTER_BY,   
						           sysdate ,      //LAST_MODIFY_DATE,   
						            :gvs_user_id ,      //LAST_MODIFY_BY,   
						            '*',      //MACHINE_CODE,   
						            :lvs_slip_no ,      //INVOICE_NO,   
						            NULL,      //MADE_BY,   
						            '*',      //PARENT_ITEM_CODE,   
						           :lvs_lot_no ,      //MATERIAL_MFS,   
						            NULL,      //INTERFACE_YN,   
						            NULL,      //INTERFACE_DATE,   
						            NULL,      //SALE_PRICE,   
						            NULL,      //SALE_AMT,   
						            NULL,      //SALE_CURRENCY,   
						            NULL,      //ARRIVAL_DATE,   
						            NULL,      //ARRIVAL_SEQ_NO,   
						            NULL,      //DEST_ORGANIZATION_ID,   
						            NULL,      //INSPECT_NO,   
						            NULL,      //RETURN_REQUEST_DATE,   
						            NULL,      //RETURN_REQUEST_SEQUENCE,   
						            'N',         //CLOSE_YN,   
						            NULL,      //CLOSE_DATE,   
						            NULL,      //DEMAND_QTY 
								:lvs_our_barcode,
								:lvs_supplier_barcode,
								:LVS_FEEDER_LOCATION_CODE,
								:LVS_ISSUE_DIVISION ,
								:LVS_MODEL_NAME,
								:LVS_INVENTORY_TYPE,
								f_get_msl_passed_time( :lvs_our_barcode )
								)  ;

			 if  f_sql_check() < 0 then
				f_play_sound("scanfailed.wav")
//					if cbx_show_message.checked = true then 
					  F_MSG('$$HEX18$$85c7e0ac98ccacb9200011c9200024c658b900ac20001cbcddc0200088d5b5c2c8b2e4b2$$ENDHEX$$' , 'P' )
	//				 end if 
				st_status.text = 'NG'
				sle_our_barcode.text = ''
				sle_our_barcode.setfocus()
				return -1
			end if

//==============================================
//$$HEX20$$7dc740c720006fb8b8d27cb9200070b374c730d108c7c4b3b0c6d0c5200030ae5db85cd5e4b22000$$ENDHEX$$
//==============================================
if rb_request.checked = true then 
	
	if dw_3.update() < 0 then 
		f_play_sound("scanfailed.wav")
		F_MSG('$$HEX18$$9ccde0ac98ccacb9200011c9200024c658b900ac20001cbcddc0200088d5b5c2c8b2e4b2$$ENDHEX$$' , 'P' )
		st_status.text = 'NG'
		sle_our_barcode.text = ''
		sle_our_barcode.setfocus()
		return -1
	end if 
	
	f_retrieve()
	
end if 


if rb_kitting.checked = true then 
	
	dw_1.scrolltorow( ll_row)
	dw_1.object.our_barcode[ll_row] = lvs_our_barcode

end if 
