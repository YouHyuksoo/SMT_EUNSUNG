//end if  


end event

event ue_data_control;call super::ue_data_control;string lvs_feeder_shaft , lvs_feeder_shaft_new , lvst_linecode[]
choose case gvs_ue_data_control		
	case 'RETRIEVE'
				if rb_kitting.checked = true then 
						wf_smt_bom_query('P')
							
				elseif rb_smt_bom_report.checked = true then 
						wf_smt_bom_query('R')
							
				elseif rb_issue_plan.checked = true then 
						wf_issue_plan_query( 'P')
						sle_supplier_barcode.setfocus()
						
				elseif rb_request.checked = true  then 
						
						dw_3.retrieve(  ddlb_line_code.getcode()+'%' , '%' ,  GVI_ORGANIZATION_ID )
						sle_supplier_barcode.setfocus()
						
				elseif rb_compare_return.checked = true then 
					     lvst_linecode[1] =  ddlb_line_code.getcode() 
						  
						dw_9.retrieve( lvst_linecode[] , '%' ,  '%' , 99999,  'Y' ,  99999 , 99999 ,   gvi_organization_id )			
						//dw_5.retrieve(  ddlb_line_code.getcode() ,  ddlb_smt_model_name.getcode( ) , ddlb_top_bottom.getcode( ) ,    '%'  ,  GVI_ORGANIZATION_ID  , ddlb_line_code_new.getcode() ,  ddlb_smt_model_name_new.getcode( ) , ddlb_top_bottom_new.getcode( ) ,   lvs_feeder_shaft_new ,  GVI_ORGANIZATION_ID )					
					
				end if 
	case 'INSERT' 
	
	    		lvl_row = dw_8.insertrow(1)
	case 'UPDATE' 
		
			if dw_5.update() < 0 then 
			   rollback;
			else
				commit ;
				f_msgbox(170)
			end if 
		
	case else
end choose

end event

event open;call super::open;sle_supplier_barcode.setfocus()
end event

event clicked;call super::clicked;if ddlb_line_code.getcode() = '%' or isnull(ddlb_line_code.getcode()) then 
	ddlb_line_code.setfocus()
else
 sle_supplier_barcode.setfocus()
end if 
end event

event resize;call super::resize;st_status.width = dw_1.width + dw_2.width
dw_6.x = dw_1.x + dw_1.width
dw_6.width = dw_2.width
