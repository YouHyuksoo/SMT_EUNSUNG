//								// openwithparm(w_com_message_popup, f_msg_st(9111) +"~r~n " + " - VENDOR CODE : "+lvs_vendor_code+" ~r~n " + " - VENDOR LOT : "+lvs_vendor_lot+" ~r~n ")
