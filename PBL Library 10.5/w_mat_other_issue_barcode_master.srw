event modified;call super::modified;string lvs_scan_barcode, lvs_vendor_code, lvs_vendor_lot, lvs_keyitem , lvs_machine_name

int     lvi_row_count


lvs_scan_barcode = this.text 

//=====================================================================
// $$HEX15$$90c7acc0200014bc54cfdcb4d0c51cc120006fb8b8d2200094cd9ccd2000$$ENDHEX$$
//=====================================================================
SELECT  F_GET_ITEM_CODE_FROM_BARCODE(:lvs_scan_barcode)  INTO :lvs_item_code
  FROM DUAL  ;
 
if f_sql_check() < 0 then 
   return 
end if   

//=====================================================================
// $$HEX15$$90c7acc0200014bc54cfdcb4d0c51cc120006fb8b8d2200094cd9ccd2000$$ENDHEX$$
//=====================================================================
SELECT  F_GET_LOT_NO_FROM_BARCODE(:lvs_scan_barcode)  INTO :lvs_lot_no
  FROM DUAL  ;
 
if f_sql_check() < 0 then 
   return 
end if   



//=====================================================================
// $$HEX7$$a4d005d320009ccde0ac74ba2000$$ENDHEX$$
//=====================================================================
if rb_kitting.checked = true then 
   
   if ddlb_model_name.getitem() = '%' or isnull(ddlb_model_name.getitem() ) then 
      f_msgbox1(111 , "Model Name")
      st_status.text = f_msg_st1(111 , "Model Name")
      sle_our_barcode.text = ''
      ddlb_line_code.setfocus()
      return 
   end if 
end if 
//=====================================================================
// $$HEX6$$7cb778c72000b4cc6cd02000$$ENDHEX$$
//=====================================================================

if ddlb_line_code.getcode( ) = '%' or ddlb_line_code.getcode( ) = '' or ddlb_line_code.getcode( ) = '*' then
   f_msgbox1(111 , "Line")
   st_status.text = f_msg_st1(111 , "Line")
   sle_our_barcode.text = ''
   ddlb_line_code.setfocus()

end if 
//=====================================================================
// $$HEX6$$f5ac15c82000b4cc6cd02000$$ENDHEX$$
//=====================================================================
if ddlb_workstage_code.getcode( ) = '%' or ddlb_workstage_code.getcode( ) = '' or ddlb_workstage_code.getcode( ) = '*' then
   f_msgbox1(111 , "Workstage")
   st_status.text = f_msg_st1(111 , "Workstage")
   sle_our_barcode.text = ''
   ddlb_workstage_code.setfocus()
end if 

