end type

event modified;call super::modified;
string lvs_str_lot, lvs_str_mdoel

lvs_str_lot         =  this.text
lvs_str_mdoel    = ''

IF ( LEN( lvs_str_lot ) = 9 ) THEN
	
      SELECT  model_name
          INTO :lvs_str_mdoel
         FROM  ip_product_run_card
       WHERE  run_no            = :lvs_str_lot
            AND organization_id = 1
            AND rownum           = 1;
	
		 IF F_SQL_CHECK() < 0 THEN 
				lvs_str_mdoel    = ''
		 END IF 	 
			
		IF ( lvs_str_mdoel = '' OR ISNULL(lvs_str_mdoel) = true OR lvs_str_lot = lvs_str_mdoel  ) THEN
		 	 sle_our_barcode.setfocus()
			 sle_our_barcode.selecttext( 1,100)
			 
			return -1 
		ELSE
			this.text = lvs_str_mdoel
		END IF;
	
END IF
 

if rb_issue_plan.checked = true then 
	
	ddlb_model_name.redraw( this.text)
	ddlb_model_name.setfocus()
else
	
	ddlb_smt_model_name.redraw( this.text)
	ddlb_smt_model_name.setfocus()

end if 
end event

event getfocus;call super::getfocus;this.selecttext( 1,100)
end event

