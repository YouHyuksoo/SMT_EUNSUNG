this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_contents=create m_contents
this.m_helpshowvideo=create m_helpshowvideo
this.m_46=create m_46
this.m_47=create m_47
this.m_-18=create m_-18
this.m_columnexplanation=create m_columnexplanation
this.m_-2=create m_-2
this.m_aboutapplication=create m_aboutapplication
this.m_about=create m_about
this.Item[UpperBound(this.Item)+1]=this.m_contents
this.Item[UpperBound(this.Item)+1]=this.m_helpshowvideo
this.Item[UpperBound(this.Item)+1]=this.m_46
this.Item[UpperBound(this.Item)+1]=this.m_47
this.Item[UpperBound(this.Item)+1]=this.m_-18
this.Item[UpperBound(this.Item)+1]=this.m_columnexplanation
this.Item[UpperBound(this.Item)+1]=this.m_-2
this.Item[UpperBound(this.Item)+1]=this.m_aboutapplication
this.Item[UpperBound(this.Item)+1]=this.m_about
end on

on m_help.destroy
