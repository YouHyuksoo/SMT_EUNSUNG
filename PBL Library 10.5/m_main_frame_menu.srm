this.textsize = -8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 15780518
this.bitmapbackcolor = 12632256
this.menutitles = true
this.menubitmaps = true
this.titlegradient = true
this.toolbarstyle = contemporarytoolbar!
this.toolbarbackcolor = 30474192
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_machinepmmaster=create m_machinepmmaster
this.m_machinemaster=create m_machinemaster
this.m_machinerepairrequestmaster=create m_machinerepairrequestmaster
this.m_machinerepairmaster=create m_machinerepairmaster
this.m_machinepmmaster0=create m_machinepmmaster0
this.m_machinelossmaster=create m_machinelossmaster
this.m_-36=create m_-36
this.m_spresultquery=create m_spresultquery
this.m_spitimequery=create m_spitimequery
this.m_iictresultquery=create m_iictresultquery
this.m_aoiresultquery=create m_aoiresultquery
this.m_routerrsultquery=create m_routerrsultquery
this.m_romwriteresultquery=create m_romwriteresultquery
this.m_solderviscosityresultquery=create m_solderviscosityresultquery
this.m_reflowresultquery=create m_reflowresultquery
this.m_performacefuntiontest=create m_performacefuntiontest
this.m_-60=create m_-60
this.m_linemachinedailyoperationreport=create m_linemachinedailyoperationreport
this.Item[UpperBound(this.Item)+1]=this.m_machinepmmaster
this.Item[UpperBound(this.Item)+1]=this.m_machinemaster
this.Item[UpperBound(this.Item)+1]=this.m_machinerepairrequestmaster
this.Item[UpperBound(this.Item)+1]=this.m_machinerepairmaster
this.Item[UpperBound(this.Item)+1]=this.m_machinepmmaster0
this.Item[UpperBound(this.Item)+1]=this.m_machinelossmaster
this.Item[UpperBound(this.Item)+1]=this.m_-36
this.Item[UpperBound(this.Item)+1]=this.m_spresultquery
this.Item[UpperBound(this.Item)+1]=this.m_spitimequery
this.Item[UpperBound(this.Item)+1]=this.m_iictresultquery
this.Item[UpperBound(this.Item)+1]=this.m_aoiresultquery
this.Item[UpperBound(this.Item)+1]=this.m_routerrsultquery
this.Item[UpperBound(this.Item)+1]=this.m_romwriteresultquery
this.Item[UpperBound(this.Item)+1]=this.m_solderviscosityresultquery
this.Item[UpperBound(this.Item)+1]=this.m_reflowresultquery
this.Item[UpperBound(this.Item)+1]=this.m_performacefuntiontest
this.Item[UpperBound(this.Item)+1]=this.m_-60
this.Item[UpperBound(this.Item)+1]=this.m_linemachinedailyoperationreport
