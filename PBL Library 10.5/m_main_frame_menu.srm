event clicked;window activesheet
activesheet = w_main_frame.GetActiveSheet( )
if isvalid(activesheet) then 
	if activesheet.classname() = 'w_wallpaper' or activesheet.classname() = 'w_wallpaper_web' then 
		
	elseif  activesheet.classname() = 'w_tab_sheet' and gvi_opentab_count > 0  then
			uo_tabpage tabpage
			
			if w_tab_sheet.tab_1.Selectedtab < 1 then return
			
			tabpage = w_tab_sheet.tab_1.Control[w_tab_sheet.tab_1.Selectedtab]
			
			if isvalid(tabpage.ivw_openedwindow) then 
				close( tabpage.ivw_openedwindow )
			end if 
	elseif  activesheet.classname() = 'w_tab_sheet' and gvi_opentab_count = 0  then
	else
		
		close(activesheet)
	end if
end if

end event

