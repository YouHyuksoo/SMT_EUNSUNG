event clicked;int lvi_upperbound , i =1
Long lvl_bottom , lvl_height
String lvs_object_type

lvi_upperbound = Gst_edit_object.object_index 

if lvi_upperbound > 1 then 

			lvs_object_type = Gst_edit_object.object_type[1]
	    	     lvl_height  = Gst_edit_object.object_height[1]	  
		 
			if upper(lvs_object_type) = 'LINE' then //$$HEX10$$7cb778c724c60cbe1dc8b8d278c7bdacb0c62000$$ENDHEX$$
			
				lvl_bottom = Gst_edit_object.object_y2[1]
			
			else
				
				lvl_bottom = Gst_edit_object.object_y1[1] + lvl_height
				
			end if

else
	return
end if

do 
	i++
    	
     lvl_height  = Gst_edit_object.object_height[i]	  	 
		 
	if  upper(lvs_object_type) = 'LINE' then 
	    selected_data_window.Modify( Gst_edit_object.object_name[i]+".y2="+string(lvl_bottom) )
		 
	    Gst_edit_object.object_y1[i] = lvl_bottom 		
	    Gst_edit_object.object_y2[i] = lvl_bottom 				 
		 
	else
	    selected_data_window.Modify( Gst_edit_object.object_name[i]+".y="+string(lvl_bottom - lvl_height ) )
	    Gst_edit_object.object_y1[i] = lvl_bottom - lvl_height		

	end if
	
loop until i = lvi_upperbound

end event

