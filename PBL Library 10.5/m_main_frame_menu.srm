type m_checkall from menu within m_selectcheck
end type

event clicked;Long i 
String lvs_protect
if isvalid(selected_data_window) then 
else
	return
end if

if Upper(selected_data_window.Describe( selected_data_window.Getcolumnname()+'.Edit.Style')) = "CHECKBOX" then

else
		f_msgbox1( 123 , 	Upper(selected_data_window.Describe( selected_data_window.Getcolumnname()+'.Edit.Style')) ) 
		//( "Notify" , Upper(selected_data_window.Describe( selected_data_window.Getcolumnname()+'.Edit.Style')) +" Is not the check box type" ) 
		return
end if


Msg = f_msgbox( 119 )	
//Msg = ("Confirm" , "Name="+selected_data_window.Getcolumnname()+ "  The whole it selects? [Yes = Whole , No = Selected , Cancel = Cancel]" , question! , yesnocancel!)

IF MSG = 1 THEN 
	DO
		I++
		lvs_protect =  selected_data_window.DESCRIBE( selected_data_window.GETCOLUMNNAME()+".protect")
		if lvs_protect = '1' then 
			
		else
			selected_data_window.SETITEM( I ,selected_data_window.GETCOLUMNNAME() , 'Y' )
		end if
	
	LOOP UNTIL I = selected_data_window.ROWCOUNT()

ELSEIF MSG = 2 THEN  // $$HEX14$$20c1ddd01cb420005cb8b0c6ccb92000b4cc6cd0200020c1ddd02000$$ENDHEX$$
	DO
		I++
		
		IF selected_data_window.ISSELECTED(I) then
			
		lvs_protect =  selected_data_window.DESCRIBE( selected_data_window.GETCOLUMNNAME()+".protect")
		if lvs_protect = '1' then 
			
		else
					selected_data_window.SETITEM( I ,selected_data_window.GETCOLUMNNAME() , 'Y' )     														
				end if
		END IF
	
	LOOP UNTIL I = selected_data_window.ROWCOUNT()

ELSE
	
	RETURN
END IF


end event

