type m_improtfromxml from menu within m_saveopen
end type

event clicked;window activesheet
//=============================================
int    li_FileNum , loops, i , lvi_count
long   flen, bytes_read , bytes_read_sum , new_pos
STRING LIB_FILE , b
string is_filename, is_fullname , LVS_CUSTOMER_CODE 


activesheet = w_main_frame.GetActiveSheet( )

IF IsValid(activesheet) THEN
	
   if selected_data_window.dataobject <> ''  then
   else				
		 MSG = MESSAGEBOX("Notify","Data Window Invalid Continue ?" , question! , yesno!)
         IF MSG = 1 THEN 
	     ELSE
		   return
        END IF
	end if	
		
		if GetFileOpenName("Select File", &
			 is_fullname, is_filename, "XML", &
			 + "Text Files (*.TXT),*.TXT," &
			 + "XML Files (*.XML),*.XML," &
			 + "All Files (*.*), *.*") < 1 then return
				
		flen = FileLength(is_fullname)
		
		IF FLEN < 0 THEN 
			MESSAGEBOX("Error" , is_fullname+" File Length Unknown")
			RETURN 
		END IF
		
		setpointer(HOURGLASS!)
		li_FileNum = FileOpen(is_fullname,  StreamMode!, Read!, LockRead!)
		
		IF li_FileNum <> -1 THEN
				
					SetPointer(HourGlass!)					
		
					
					IF flen > 32765 THEN
					
							  IF Mod(flen, 32765) = 0 THEN
									loops = flen/32765
							  ELSE
									loops = (flen/32765) + 1
							  END IF
					ELSE
							  loops = 1
					END IF
					
					new_pos = 1
					FOR i = 1 to loops
							  bytes_read = FileRead(li_FileNum, b)
							  bytes_read_sum = bytes_read_sum + bytes_read
							  LIB_FILE = LIB_FILE + b
							  f_msg_mdi_help( STRING(bytes_read_sum)+"/"+string(flen)+" Bytes Read" )
					NEXT
					
					FileClose(li_FileNum)
					selected_data_window.sharedataoff()
					selected_data_window.Importstring( xml! , LIB_FILE )
						  
			 END IF
ELSE
	
	 f_msg_mdi_help( "Active Sheet Invalid" )
			
END IF 
//=============================================


end event

