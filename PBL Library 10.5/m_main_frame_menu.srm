type m_releaseall from menu within m_selectcheck
end type

event clicked;Long i 

if isvalid(selected_data_window) then 
else
	return
end if

if Upper(selected_data_window.Describe( selected_data_window.Getcolumnname()+'.Edit.Style')) = "CHECKBOX" then

else
f_msgbox1( 123 , 	Upper(selected_data_window.Describe( selected_data_window.Getcolumnname()+'.Edit.Style')) ) 	
//( "Notify" , Upper(selected_data_window.Describe( selected_data_window.Getcolumnname()+'.Edit.Style')) +" Is not the check box type" ) 
return
end if
Msg = f_msgbox( 137 )
//Msg = ("Confirm" , "Name="+selected_data_window.Getcolumnname()+ "  The whole it Release? [Yes = Whole , No = Selected , Cancel = Cancel]" , question! , yesnocancel!)

IF MSG = 1 THEN 
	DO
		I++
		selected_data_window.SETITEM( I ,selected_data_window.GETCOLUMNNAME() , 'N' )     														
	
	LOOP UNTIL I = selected_data_window.ROWCOUNT()


ELSEIF MSG = 2 THEN 
	DO
		I++
		
		IF selected_data_window.ISSELECTED(I) then
			selected_data_window.SETITEM( I ,selected_data_window.GETCOLUMNNAME() , 'N' )     														
		END IF
	
	LOOP UNTIL I = selected_data_window.ROWCOUNT()

ELSE
	
	RETURN
END IF


end event

