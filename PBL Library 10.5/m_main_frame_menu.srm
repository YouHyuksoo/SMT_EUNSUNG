event clicked;int lvi_upperbound , i=1
Long lvl_right ,  lvl_width
String lvs_object_type
lvi_upperbound = Gst_edit_object.object_index 

if lvi_upperbound > 1 then 

	  lvs_object_type = Gst_edit_object.object_type[1]

//	  lvl_x1  = Gst_edit_object.object_x1[1]
	  lvl_width  = Gst_edit_object.object_width[1]	  
	  
	  if upper(lvs_object_type) = 'LINE' then 
		  lvl_right = Gst_edit_object.object_x2[1]
	else
		  lvl_right = Gst_edit_object.object_x1[1] + lvl_width
	end if
	
else
	return
end if


do 
	i++
//    	  lvl_x1  = Gst_edit_object.object_x1[i]
	  lvl_width  = Gst_edit_object.object_width[i]	  
	  
	 
	if  upper(lvs_object_type) = 'LINE' then 
		selected_data_window.Modify( Gst_edit_object.object_name[i]+".x2="+string(lvl_right) )		
		selected_data_window.Modify( Gst_edit_object.object_name[i]+".x1="+string(lvl_right - lvl_width)  )		

		Gst_edit_object.object_x1[i] = lvl_right -lvl_width
		Gst_edit_object.object_x2[i] = lvl_right
	else
		selected_data_window.Modify( Gst_edit_object.object_name[i]+".x="+string(lvl_right - lvl_width) )
	     Gst_edit_object.object_x1[i] = lvl_right 		
	end if
	
	
loop until i = lvi_upperbound

end event

