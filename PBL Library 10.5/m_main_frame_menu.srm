type m_holizontal from menu within m_2
end type

event clicked;if isValid(selected_data_window) then 
string Vs_ot
Vs_ot = selected_data_window.describe("datawindow.print.orientation") 

if Vs_ot = '0' then
	selected_data_window.modify("datawindow.print.orientation = 1")
elseif Vs_ot = '1' then
	selected_data_window.modify("datawindow.print.orientation = 2")
elseif Vs_ot = '2' then
	selected_data_window.modify("datawindow.print.orientation = 1")
end if
end if
end event

