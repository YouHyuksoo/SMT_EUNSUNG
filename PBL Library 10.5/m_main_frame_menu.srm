type m_saveasword from menu within m_saveopen
end type

event clicked;Constant 	integer 	ppLayoutBlank = 12
OLEObject 				ole_obj
Datawindow ivdw_data_window

ivdw_data_window = SELECTED_DATA_WINDOW
IF ISVALID(ivdw_data_window) THEN 
ELSE
	RETURN
END IF

ole_obj = Create OLEObject

//word $$HEX2$$f0c5b0ac$$ENDHEX$$
Integer					li_ret

li_ret = ole_obj.ConnectToNewObject("word.application")
IF li_ret <> 0 THEN
	//$$HEX3$$ccb97dc52000$$ENDHEX$$word$$HEX15$$00ac2000f4c5acb9c0c920004ac53cc774ba2000e4b2dcc22000f0c5e4b2$$ENDHEX$$.
	li_ret = ole_obj.ConnectToObject("", "word.application")
	IF li_ret <> 0 THEN
		Messagebox("OLE Error", "Can`t Open OLE! Error Code : " + String(li_ret))
		return
	END IF
	
	ole_obj.Visible = True
END IF

//OLE$$HEX23$$7cb92000acc0a9c658d530ae200004c758d5ecc5200068d518c240c620008dc131c144c7200015c858c75cd5e4b2$$ENDHEX$$.
Long	ll_colnum, ll_rownum

// $$HEX18$$44d594c65cd5200038cce0ac01c878c718c27cb92000c1c911c8200015c858c75cd5e4b2$$ENDHEX$$.
constant long 	wdWord9TableBehavior = 1
constant long 	wdAutoFitFixed = 0
constant long 	wdCell = 12
String			ls_value
pointer			oldpointer

//$$HEX13$$74c704c858c72000ecd378c730d17cb9200030aeb5c55cd5e4b2$$ENDHEX$$.
oldpointer = SetPointer(HourGlass!)

String 	ls_objects, ls_obj, ls_objs[], ls_objtag[]
Long		ll_pos, ll_len, ll_num = 0

//DataWindow$$HEX2$$58c72000$$ENDHEX$$Object$$HEX6$$7cb92000f4b244c554b4e4b2$$ENDHEX$$.
ls_objects = Trim(ivdw_data_window.Describe('datawindow.Objects'))


//Column$$HEX7$$85ba44c7200084bdacb95cd5e4b2$$ENDHEX$$.
do while ( Pos(ls_objects, "~t") > 0 )
	ll_pos = pos(ls_objects, "~t")
	ll_len = ll_pos - 1 
	ls_obj = left(ls_objects, ll_len)
	
	//column$$HEX2$$fcac2000$$ENDHEX$$Compute $$HEX10$$44d5dcb474c774ba1cc1200034bcdcb400ac2000$$ENDHEX$$detail$$HEX8$$78c783acccb9200098ccacb95cd5e4b2$$ENDHEX$$.
	IF (ivdw_data_window.Describe(ls_obj + '.type') = 'column' or ivdw_data_window.Describe(ls_obj + '.type') = 'compute' ) and &
		(ivdw_data_window.Describe(ls_obj + '.band') = 'detail') THEN
		
		ll_num += 1
		ls_objs[ll_num] = ls_obj
		
		//$$HEX4$$00ad28b81cb42000$$ENDHEX$$tag$$HEX8$$8dc131c144c720001bbc44c528c6e4b2$$ENDHEX$$.
		ls_objtag[ll_num] = ivdw_data_window.Describe(ls_obj + '_t.text')
	END IF
	
	ls_objects = right(ls_objects, len(ls_objects) - ll_pos)
loop

IF (ivdw_data_window.Describe(ls_objects + '.type') = 'column' or ivdw_data_window.Describe(ls_objects + '.type') = 'compute') and &
	(ivdw_data_window.Describe(ls_objects + '.band') = 'detail') THEN
	
	ll_num += 1
	ls_objs[ll_num] = ls_objects
	ls_objtag[ll_num] = ivdw_data_window.Describe(ls_objects + '_t.text')
END IF

//column count$$HEX2$$40c62000$$ENDHEX$$row count$$HEX5$$7cb920003cc1e4b22000$$ENDHEX$$
ll_colnum = ll_num
ll_rownum = ivdw_data_window.RowCount() + 1 //word$$HEX4$$d0c51cc194b22000$$ENDHEX$$Column band$$HEX4$$c4b320005cd52000$$ENDHEX$$row$$HEX12$$7cb9200028ccc0c9200058d530ae20004cb538bb74c7e4b2$$ENDHEX$$.

//Document$$HEX10$$7cb9200058d598b02000ddc031c158d5ecc52000$$ENDHEX$$Data$$HEX14$$7cb92000d1c9b4c5200023b144c7200000c944be7cb920005cd5e4b2$$ENDHEX$$.
ole_obj.Documents.Add()

//Document$$HEX2$$d0c52000$$ENDHEX$$Table$$HEX6$$7cb92000ddc031c15cd5e4b2$$ENDHEX$$. Data$$HEX12$$7cb92000d1c9b4c5200023b130ae200004c774d51cc1e4b2$$ENDHEX$$.
ole_obj.ActiveDocument.Tables.Add(ole_obj.Selection.Range, ll_rownum, ll_colnum)


String 	ls_colname
Integer 	i, j, k

FOR i = 1 TO ll_colnum
	//Column $$HEX7$$85ba44c7200030bc58ce5cd5e4b2$$ENDHEX$$.
	ls_value = ls_objtag[i]
	//Column$$HEX11$$58c7200004c758ce7cb9200030bc15c858d5ecc52000$$ENDHEX$$column$$HEX9$$85ba44c72000d1c9b4c5200023b194b2e4b2$$ENDHEX$$.
	ole_obj.Selection.TypeText("~r~n~t" + ls_value + "~t~r~n" )

	//$$HEX10$$e4b24cc7200040c15cb8200074c7d9b35cd5e4b2$$ENDHEX$$.
	ole_obj.Selection.MoveRight(wdCell)
	
NEXT

ivdw_data_window.setredraw(false)

ole_obj.Selection.MoveLeft(wdCell)

String column_name

FOR i = 2 TO ll_Rownum
	FOR j = 1 TO ll_colnum
		column_name = ls_objs[j]
		//DW$$HEX12$$58c7200070b374c7c0d07cb9200000acc0c9e0ac40c62000$$ENDHEX$$Word$$HEX2$$5cb82000$$ENDHEX$$Setting$$HEX2$$5cd5e4b2$$ENDHEX$$.
		IF ivdw_data_window.Describe( column_name + '.type') = 'column' THEN
			ls_value = ivdw_data_window.Describe( "Evaluate( 'LookupDisplay(" + column_name + ")' , " + String( i - 1 ) + ")")
		END IF
		
		IF ivdw_data_window.Describe( column_name + '.type') = 'compute' THEN
			ls_value = ivdw_data_window.Describe("Evaluate('" + ivdw_data_window.Describe(column_name + '.expression') + "', " + String( i - 1 ) + ")")
		END IF
		
		//Word$$HEX2$$d0c52000$$ENDHEX$$Setting$$HEX2$$58d530ae$$ENDHEX$$.
		
		ole_obj.Selection.MoveRight(wdCell)
		ole_obj.Selection.TypeText(ls_value)

	NEXT
NEXT

ivdw_data_window.setredraw(true)

constant long wdFormatDocument = 0

//Pointer$$HEX17$$7cb9200074c704c82000ecd378c730d15cb8200018b4ccb324b8200093b194b2e4b2$$ENDHEX$$.
SetPointer(oldpointer)

//word$$HEX22$$5cb8200098c7200018b4b4c520004cc844c700b3200000c8a5c744c7200060d574acc0c920004dbb94b2e4b2$$ENDHEX$$.
IF messagebox("Notify", "Data was Changed. Do you wish to Save? ", Question!, YesNo!) = 1 THEN
	String docname, named
	Integer value
	
	value = GetFileSaveName("Save", docname, named, "DOC", "Doc Files(*.DOC), *.doc")
	
	//$$HEX22$$00c8a5c758d524b894b220000cd37cc774c7200098c7200020c1ddd074c7200018b4b4c54cc8e4b274ba2000$$ENDHEX$$Doc$$HEX8$$38bb1cc15cb8200000c8a5c75cd5e4b2$$ENDHEX$$.
	IF value = 1 THEN
		ole_obj.ActiveDocument.SaveAs(docname, 0, False, "", True, "", False, False, False, False, False)
	END IF
	
END IF

ole_obj.quit()
ole_obj.DisconnectObject ( )
Destroy ole_obj
ChangeDirectory ( Gvs_default_directory )





end event

