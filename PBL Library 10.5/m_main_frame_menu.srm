event clicked;Long i 

if isvalid(selected_data_window) then 
	if  selected_data_window.rowcount() < 1 then 
	   return
	end if
	
else
	return
end if


do 
	i++
	
	selected_data_window.selectrow( i , true )
	
loop until i = selected_data_window.rowcount()
end event

