event clicked;window activesheet
string mtext
activesheet = w_main_frame.GetActiveSheet( )
IF IsValid(activesheet) THEN
	
	     IF ISVALID(SELECTED_DATA_WINDOW) THEN 
	     ELSE
			RETURN
		END IF
		
		IF SELECTED_DATA_WINDOW.GETROW() < 1  THEN 

		ELSE
				STRING ls_data , ls_temp
				INT       ll_list ,ll_start = 1 , ll_height
				
				ls_data = SELECTED_DATA_WINDOW.Describe("DataWindow.Bands")+"~t"
				ll_list = pos (ls_data, "~t", 1)
				
				DO WHILE ll_list > 0
					
					ls_temp =UPPER(mid(ls_data, ll_start, ll_list - ll_start))
					
					IF  mid( ls_temp , 1 , 7 )  = 'TRAILER' THEN 
						ll_height = integer(SELECTED_DATA_WINDOW.Describe("DataWindow."+ls_temp+".Height"))
                           IF ll_height = 0 THEN 
							SELECTED_DATA_WINDOW.Modify("DataWindow."+ls_temp+".Height='80'")			
						ELSE
							SELECTED_DATA_WINDOW.Modify("DataWindow."+ls_temp+".Height='0'")													
 					     END IF
					END IF
					
					ls_temp = ""
					ll_start = ll_list + 1
					
					ll_list = pos (ls_data, "~t", ll_start)
					
				LOOP 
		
		END IF
end if
end event

type m_detailshowhide from menu within m_edit
end type

event clicked;window activesheet
string mtext
activesheet = w_main_frame.GetActiveSheet( )
IF IsValid(activesheet) THEN
	
	     if isvalid(SELECTED_DATA_WINDOW) then 
	     else
			return
		end if
		IF SELECTED_DATA_WINDOW.GETROW() < 0  THEN 

		ELSE
				STRING ls_data , ls_temp
				INT       ll_list ,ll_start = 1 , ll_height
				
				ls_data = SELECTED_DATA_WINDOW.Describe("DataWindow.Bands")+"~t"
				ll_list = pos (ls_data, "~t", 1)
				
				DO WHILE ll_list > 0
					
					ls_temp =UPPER(mid(ls_data, ll_start, ll_list - ll_start))
					
					IF  mid( ls_temp , 1 , 6 )  = 'DETAIL' THEN 
						ll_height = integer(SELECTED_DATA_WINDOW.Describe("DataWindow."+ls_temp+".Height"))
                           IF ll_height = 0 THEN 
							SELECTED_DATA_WINDOW.Modify("DataWindow."+ls_temp+".Height='64'")			
						ELSE
							SELECTED_DATA_WINDOW.Modify("DataWindow."+ls_temp+".Height='0'")													
 					     END IF
					END IF
					
					ls_temp = ""
					ll_start = ll_list + 1
					
					ll_list = pos (ls_data, "~t", ll_start)
					
				LOOP 
		
		END IF
end if
end event

