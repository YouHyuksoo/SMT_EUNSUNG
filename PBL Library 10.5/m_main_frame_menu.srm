type m_editwindow from menu within m_edit
end type

event clicked;window activesheet
string mtext , lvs_column_name
activesheet = w_main_frame.GetActiveSheet( )
IF IsValid(activesheet) THEN

	if isvalid(selected_data_window) then 
	else
		return
	end if
	
	if selected_data_window.getrow() = 0  then 
		return
	end if

   if SELECTED_DATA_WINDOW.Getcolumnname() = '' or isnull(SELECTED_DATA_WINDOW.Getcolumnname()) then 
		return
	end if
	
	message.stringparm=''
	
	lvs_column_name = lower(SELECTED_DATA_WINDOW.Getcolumnname())
	
	openwithparm(w_edit_window , selected_data_window.gettext())

	if message.stringparm = '' then 
	else
  	 selected_data_window.setitem( selected_data_window.getrow() , lvs_column_name , message.stringparm)
	end if	
end if
end event

