event clicked;int lvi_upperbound , i
Long lvl_center
String lvs_object_type

lvi_upperbound = Gst_edit_object.object_index 

if lvi_upperbound > 0 then 
	
		 do
			i++
				lvs_object_type = Gst_edit_object.object_type[i]
	  
				if upper(lvs_object_type) = 'LINE' then 
				
				    Messagebox("1" , string( Gst_edit_object.object_y1[i] ) + '  '+string( Gst_edit_object.object_y2[i] ) )
				
					lvl_center =  Gst_edit_object.object_y1[i]
					
					selected_data_window.Modify( Gst_edit_object.object_name[i]+".y1="+string(lvl_center) )
					selected_data_window.Modify( Gst_edit_object.object_name[i]+".y2="+string(lvl_center) )	
					
					Gst_edit_object.object_y1[i]  = lvl_center
					Gst_edit_object.object_y2[i]  = lvl_center
					
				end if
	
		Loop Until i = lvi_upperbound

else
	return
end if

end event

