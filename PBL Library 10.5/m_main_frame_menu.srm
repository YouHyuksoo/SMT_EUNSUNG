			lvs_object_type = Gst_edit_object.object_type[1]
  
			if upper(lvs_object_type) = 'LINE' then 
			
				lvl_top = Gst_edit_object.object_y1[1]
			
			else
				
				lvl_top = Gst_edit_object.object_y1[1]
				
			end if

	
else
	return
end if


do 
	i++
    	
	if  upper(lvs_object_type) = 'LINE' then 
	    selected_data_window.Modify( Gst_edit_object.object_name[i]+".y1="+string(lvl_top) )
	    Gst_edit_object.object_y1[i] = lvl_top 		
		 
	else
	    selected_data_window.Modify( Gst_edit_object.object_name[i]+".y="+string(lvl_top) )
	    Gst_edit_object.object_y1[i] = lvl_top 			

	end if
	
loop until i = lvi_upperbound

end event

