type m_previewbysetup from menu within m_116
end type

event clicked;string active_window , active_dw ,vs_ot ,vs_style , lvs_window_zoom, ls_zoom


if isvalid(selected_data_window) then 
else
	return
end if

active_window = selected_window.classname()
active_dw        = selected_data_window.classname()

select style , zoom_is , window_zoom_is
  into :vs_ot , :ls_zoom , :lvs_window_zoom
  from isys_dwzoom
 where upper(window_name) = upper(:active_window)
   and upper(DATAWINDOW_NAME)     = upper(:active_dw) 
   and organization_id  = :gvi_organization_id;

if  f_sql_check() < 1 then 
	return
end if

if sqlca.sqlnrows < 1 then 
	
    msg = f_msgbox(177) 
    if msg = 1 then 
		
		Gvs_zoom_size = selected_data_window.Describe("Datawindow.Zoom")
		open(w_set_zoom)
		
	end if
	
else
	
	string s_var
	s_var = "datawindow.zoom=" + trim(ls_zoom)
	selected_data_window.modify(s_var)

	vs_style = "datawindow.print.orientation = "+vs_ot
	selected_data_window.modify(vs_style)
end if
end event

