event clicked;window activesheet

DO WHILE TRUE
	activesheet = w_main_frame.GetActiveSheet( )
	IF IsValid(activesheet) THEN
		if activesheet.classname() = 'w_wallpaper' then
		else
			close(activesheet)	
		end if 
	ELSE
		EXIT
	END IF
LOOP 
end event

type m_help from menu within m_main_frame_menu
m_contents m_contents
