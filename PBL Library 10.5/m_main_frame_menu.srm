event clicked;int lvi_count
String lvs_col_name , lvs_col_x , lvs_col_width , lvs_object_name , lvs_visible_yn , lvs_object_width , lvs_object_x1

lvs_col_name = gs_anydata.name	

IF upper(gs_anydata.type) = 'COLUMN' THEN 
	
			Gst_dw_colinfo.i_dw_colcount = 0
			Gst_dw_colinfo.i_dw_colcount=Integer(  selected_data_window.Describe("DataWindow.Column.Count"))

                lvs_col_x = selected_data_window.Describe(lvs_col_name + ".x")   
			 lvs_col_width = selected_data_window.Describe(lvs_col_name + ".width")
			 
		      selected_data_window.MODIFY("destroy "+lvs_col_name )
		
			//======================================================================
			//
			//======================================================================
			For lvi_count = 1 to Gst_dw_colinfo.i_dw_colcount
					
				lvs_object_name	= selected_data_window.Describe('#'+String(lvi_count)+".Name")	
				lvs_visible_yn= selected_data_window.Describe(lvs_object_name + ".visible")
				lvs_object_width = selected_data_window.Describe(lvs_object_name + ".width")
			     lvs_object_x1 = selected_data_window.Describe(lvs_object_name + ".x")
				  
				if   Long(lvs_col_x) <  Long(lvs_object_x1) then 
					selected_data_window.Modify(lvs_object_name + ".x='"+string(Long(lvs_object_x1) - Long(lvs_col_width)) +"'")	
				end if

			Next
	
ELSEIF  upper(gs_anydata.type) = 'COMPUTE'  THEN
	
	        selected_data_window.MODIFY( lvs_col_name + ".visible=0")	
	
ELSEIF  upper(gs_anydata.type) = 'TEXT'  THEN
	
	        selected_data_window.MODIFY( lvs_col_name + ".visible=0")
					
ELSE
	f_msgbox1( 178 , upper(gs_anydata.type)  ) 
//	("Notify" ,  upper(gs_anydata.type) +" Type Not Support" )
	
END IF
end event

