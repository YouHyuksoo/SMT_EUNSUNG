type m_changeorganization from menu within m_file
end type

event clicked;window activesheet

DO WHILE TRUE
	activesheet = w_main_frame.GetActiveSheet( )
	IF IsValid(activesheet) THEN
			if activesheet.classname() = 'w_wallpaper' then 
				Exit
			else
				close(activesheet)
			end if
	ELSE
		EXIT
	END IF
LOOP 

openSheet(w_wallpaper, w_main_frame , Gvi_opensheet_position, Layered!)
OPEN(W_CHOOSE_ORGANIZATION_OTHER)

end event

