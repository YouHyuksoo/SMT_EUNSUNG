 column=(type=datetime updatewhereclause=yes name=last_modify_date dbname="ip_product_pack_assy_master.last_modify_date" )
 column=(type=char(20) updatewhereclause=yes name=last_modify_by dbname="ip_product_pack_assy_master.last_modify_by" )
 column=(type=number updatewhereclause=yes name=organization_id dbname="ip_product_pack_assy_master.organization_id" )
 retrieve="select  pack_date, 
           line_code, 
           workstage_code, 
           run_no, 
           model_name, 
           pack_qty, 
           pack_barcode, 
           v1, 
           v2, 
           v3, 
           v4, 
           v5, 
           v6, 
           v7, 
           v8, 
           v9, 
           enter_date, 
           enter_by, 
           last_modify_date, 
           last_modify_by, 
           organization_id
  from IP_PRODUCT_PACK_ASSY_MASTER
 where run_no             like :ARG_RUN_NO
     and organization_id = :ARG_ORG_ID
   order by pack_date, pack_barcode
" arguments=(("ARG_RUN_NO", string),("ARG_ORG_ID", number))  sort="model_name A " )
