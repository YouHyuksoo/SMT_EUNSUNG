 retrieve="  SELECT pid, 
inspect_date, 
result, 
enter_date, 
enter_by, 
last_modify_date, 
last_modify_by, 
organization_id, 
run_no, 
line_code, 
machine_code, 
file_name, 
c1, 
c2, 
c3, 
c4, 
c5, 
c6, 
c7, 
c8, 
c9, 
c10, 
c11, 
c12, 
c13, 
c14, 
c15, 
c16, 
c17, 
c18, 
c19, 
c20, 
c21, 
c22, 
c23, 
c24, 
c25, 
c26, 
c27, 
c28, 
c29, 
c30, 
c31, 
c32, 
c33, 
c34, 
c35, 
c36, 
c37, 
c38, 
c39, 
c40,
              F_GET_RUN_MODEL_NAME(RUN_NO) MODEL_NAME

    FROM IQ_MACHINE_INSPECT_DATA_O1XX
   WHERE INSPECT_DATE >= TO_CHAR(TRUNC(:ARG_DATESET),'YYYY/MM/DD HH24:MI:SS' ) 
        AND INSPECT_DATE <   TO_CHAR(TRUNC(:ARG_DATEEND)+1 ,'YYYY/MM/DD HH24:MI:SS' )
        AND PID                                                   like :ARG_PID  
	   AND LINE_CODE                                        LIKE :ARG_LINE_CODE 
       AND  F_GET_RUN_MODEL_NAME( RUN_NO) LIKE :ARG_MODEL_NAME
        AND  RUN_NO                                           LIKE :ARG_RUN_NO " arguments=(("ARG_DATESET", datetime),("ARG_DATEEND", datetime),("ARG_LINE_CODE", string),("ARG_PID", string),("ARG_MODEL_NAME", string),("ARG_RUN_NO", string))  sort="line_code A machine_code A inspect_date A pid A " )
