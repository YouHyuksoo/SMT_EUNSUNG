 retrieve="  SELECT ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"JIG_CODE~",   
         ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"ORGANIZATION_ID~",   
         ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"JIG_CHECK_DATE~",   
         ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"JIG_CHECK_STATUS~",   
         ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"LINE_CODE~",   
         ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"CLEAN_YN~",   
         ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"CONFIRM_YN~",   
         ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"CONFIRM_DATE~",   
         ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"COMMENTS~",   
         ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"ENTER_BY~",   
         ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"ENTER_DATE~",   
         ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"LAST_MODIFY_BY~",   
         ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"LAST_MODIFY_DATE~",   
         ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"JIG_CHECK_SEQUENCE~",   
         ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"JIG_LOT_NO~",   
         ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"BREAK_VALUE~",   
         ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"HIT_VALUE~",   
         ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"PIN_HOLE_YN~"  
    FROM ~"IMCN_JIG_BACKUPBLOCK_CHECK~"  
   WHERE ( ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"JIG_LOT_NO~" like :arg_jig_lot_no ) AND  
         ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"JIG_CHECK_DATE~" >= :arg_dateset AND  
         ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"JIG_CHECK_DATE~" < :arg_dateend+1 AND  
         ( ~"IMCN_JIG_BACKUPBLOCK_CHECK~".~"ORGANIZATION_ID~" = :arg_org )    
" update="IMCN_JIG_BACKUPBLOCK_CHECK" updatewhere=0 updatekeyinplace=no arguments=(("arg_jig_lot_no", string),("arg_dateset", datetime),("arg_dateend", datetime),("arg_org", number))  sort="organization_id A jig_check_sequence D " )
