table(column=(type=number updatewhereclause=yes name=organization_id dbname="organization_id" )
 column=(type=char(20) updatewhereclause=yes name=line_code dbname="line_code" )
 column=(type=datetime updatewhereclause=yes name=inspection_date dbname="inspection_date" )
 column=(type=char(30) updatewhereclause=yes name=inspect_group dbname="iqc_inspection_template.inspect_group" )
 column=(type=char(50) updatewhereclause=yes name=inspect_group_desc dbname="iqc_inspection_template.inspect_group_desc" )
 column=(type=char(100) updatewhereclause=yes name=inspection_item dbname="iqc_inspection_template.inspection_item" )
 column=(type=char(20) updatewhereclause=yes name=inspection_by dbname="iqc_inspection_template.inspection_by" )
 column=(type=char(20) updatewhereclause=yes name=inspection_yn dbname="iqc_inspection_template.inspection_yn" )
 column=(type=number updatewhereclause=yes name=inspection_value dbname="iqc_inspection_template.inspection_value" )
 column=(type=char(10) updatewhereclause=yes name=inspection_result dbname="inspection_result" )
 column=(type=char(1) updatewhereclause=yes name=inspection_item_type dbname="iqc_inspection_template.inspection_item_type" )
