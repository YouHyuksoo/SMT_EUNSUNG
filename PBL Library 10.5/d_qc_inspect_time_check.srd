 column=(type=char(10) updatewhereclause=yes name=inspection_unit dbname="iqc_inspection_template.inspection_unit" )
 column=(type=number updatewhereclause=yes name=display_seq dbname="iqc_inspection_template.display_seq" )
 column=(type=datetime updatewhereclause=yes name=enter_date dbname="iqc_inspection_template.enter_date" )
 column=(type=char(20) updatewhereclause=yes name=enter_by dbname="iqc_inspection_template.enter_by" )
 column=(type=datetime updatewhereclause=yes name=last_modify_date dbname="iqc_inspection_template.last_modify_date" )
 column=(type=char(20) updatewhereclause=yes name=last_modify_by dbname="iqc_inspection_template.last_modify_by" )
 retrieve="  SELECT NVL(A.ORGANIZATION_ID, :GVI_ORGANIZATION_ID)                     AS ORGANIZATION_ID,
              NVL(A.LINE_CODE, :IVS_LINE_CODE)                                          AS LINE_CODE,
              NVL(A.INSPECTION_DATE, TRUNC(:IVD_INSPECTION_DATE ))       AS INSPECTION_DATE,

              B.INSPECT_GROUP                                                                     AS INSPECT_GROUP,
              B.INSPECT_GROUP_DESC                                                           AS INSPECT_GROUP_DESC,
              B.INSPECTION_ITEM                                                                  AS INSPECTION_ITEM,

              A.INSPECTION_BY                                                                      AS INSPECTION_BY,
              A.INSPECTION_YN                                                                      AS INSPECTION_YN,

              A.INSPECTION_VALUE                                                                 AS INSPECTION_VALUE,
              NVL(A.INSPECTION_RESULT, 'WAIT')                                            AS INSPECTION_RESULT,

             B.INSPECTION_ITEM_TYPE                                                           AS INSPECTION_ITEM_TYPE,
             B.INSPECTION_VALUE_LCL                                                           AS INSPECTION_VALUE_LCL,
             B.INSPECTION_VALUE_STD                                                          AS INSPECTION_VALUE_STD,
             B.INSPECTION_VALUE_UCL                                                          AS INSPECTION_VALUE_UCL,
             B.INSPECTION_UNIT                                                                   AS INSPECTION_UNIT,
             B.DISPLAY_SEQ                                                                          AS DISPLAY_SEQ,

             A.ENTER_DATE                                                                          AS ENTER_DATE,
             A.ENTER_BY                                                                              AS ENTER_BY,
             A.LAST_MODIFY_DATE                                                              AS LAST_MODIFY_DATE,
             A.LAST_MODIFY_BY                                                                   AS LAST_MODIFY_BY

    FROM IQC_INSPECTION_TEMPLATE     B,
              ( 
                SELECT ORGANIZATION_ID, LINE_CODE, INSPECT_GROUP, DISPLAY_SEQ, INSPECTION_DATE,
                            INSPECTION_BY, INSPECTION_YN, INSPECTION_VALUE, INSPECTION_RESULT, 
                            ENTER_DATE, ENTER_BY, LAST_MODIFY_DATE, LAST_MODIFY_BY
                  FROM IQC_INSPECTION_TIME_CHECK 
                WHERE INSPECTION_DATE     = TRUNC(:IVD_INSPECTION_DATE )
                    AND WORK_ORDER_NO      = :IVS_WORK_ORDER_NO
                    AND CHECK_TIME              = :IVS_CHECK_TIME
                    AND ORGANIZATION_ID     = :GVI_ORGANIZATION_ID                    
              ) A
   WHERE B.ORGANIZATION_ID     = A.ORGANIZATION_ID  (+)
        AND B.INSPECT_GROUP       = A.INSPECT_GROUP (+)
        AND B.DISPLAY_SEQ            = A.DISPLAY_SEQ   (+)

        AND B.INSPECT_GROUP        = :IVS_ITEM_CODE
        AND B.ORGANIZATION_ID     = :GVI_ORGANIZATION_ID
" arguments=(("GVI_ORGANIZATION_ID", number),("IVS_LINE_CODE", string),("IVS_WORK_ORDER_NO", string),("IVS_ITEM_CODE", string),("IVD_INSPECTION_DATE", datetime),("IVS_CHECK_TIME", string))  sort="organization_id A display_seq A inspect_group_desc A inspection_item A " )
