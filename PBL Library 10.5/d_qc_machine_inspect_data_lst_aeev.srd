 retrieve="  SELECT ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"PID~",   
         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"MACHINE_CODE~",   
         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"INSPECT_DATE~",    
         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"RESULT~",   

         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"ENTER_DATE~",   
         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"ENTER_BY~",   
         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"LAST_MODIFY_DATE~",   
         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"LAST_MODIFY_BY~",   
         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"ORGANIZATION_ID~",   
         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"FILE_NAME~",   
         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"RUN_NO~",
         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"LINE_CODE~",
         F_GET_RUN_MODEL_NAME(RUN_NO) MODEL_NAME,

         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"CURRENT_CHECK1~",
         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"CURRENT_CHECK2~",
         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"CURRENT_CHECK3~",
         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"CURRENT_CHECK4~",
         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"CURRENT_CHECK5~",
         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"CURRENT_CHECK6~",

         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"CONNECTIVITY_CHECK1~",
         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"CONNECTIVITY_CHECK2~",
         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"CONNECTIVITY_CHECK3~",
         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"CONNECTIVITY_CHECK4~",
         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"CONNECTIVITY_CHECK5~",
         ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"CONNECTIVITY_CHECK6~"
         
    FROM ~"IQ_MACHINE_INSPECT_DATA_AEEV~"  
   WHERE ( ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"INSPECT_DATE~" >= TO_CHAR(TRUNC(:ARG_DATESET),'YYYY/MM/DD HH24:MI:SS' ) ) AND  
              ( ~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"INSPECT_DATE~" <   TO_CHAR(TRUNC(:ARG_DATEEND)+1 ,'YYYY/MM/DD HH24:MI:SS' )) AND  
              (~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"PID~" like :ARG_PID  )   AND 
	     	 (NVL(~"IQ_MACHINE_INSPECT_DATA_AEEV~".~"LINE_CODE~",'*') LIKE :ARG_LINE_CODE ) AND
              F_GET_RUN_MODEL_NAME( RUN_NO) LIKE :ARG_MODEL_NAME  AND
             RUN_NO  LIKE :ARG_RUN_NO " arguments=(("ARG_DATESET", datetime),("ARG_DATEEND", datetime),("ARG_LINE_CODE", string),("ARG_PID", string),("ARG_MODEL_NAME", string),("ARG_RUN_NO", string))  sort="inspect_date A pid A " )
