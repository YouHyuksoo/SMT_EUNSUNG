 retrieve="  SELECT ~"IQ_ITEM_IQC~".~"INSPECT_DATE~",   
         ~"IQ_ITEM_IQC~".~"INSPECT_SEQUENCE~",   
         ~"IQ_ITEM_IQC~".~"IQC_INSPECT_NO~",   
         ~"IQ_ITEM_IQC~".~"MFS~",   
         ~"IQ_ITEM_IQC~".~"INSPECT_RESULT~",   
         ~"IQ_ITEM_IQC~".~"SUPPLIER_CODE~",   
         ~"IQ_ITEM_IQC~".~"INSPECT_BY~",   
         ~"IQ_ITEM_IQC~".~"ENTER_DATE~",   
         ~"IQ_ITEM_IQC~".~"ENTER_BY~",   
         ~"IQ_ITEM_IQC~".~"LAST_MODIFY_DATE~",   
         ~"IQ_ITEM_IQC~".~"LAST_MODIFY_BY~",   
         ~"IQ_ITEM_IQC~".~"ITEM_CODE~",   
         ~"IQ_ITEM_IQC~".~"ORGANIZATION_ID~",   
         ~"ID_ITEM~".~"ITEM_NAME~",   
         ~"IQ_ITEM_IQC~".~"BAD_REASON_CODE~",   
         ~"IQ_ITEM_IQC~".~"COMMENTS~",   
         ~"IQ_ITEM_IQC~".~"IQC_IMPROVE_NO~",   
         ~"IQ_ITEM_IQC~".~"INSPECT_QTY~",   
         ~"IQ_ITEM_IQC~".~"INSPECT_BAD_QTY~",   
         ~"IQ_ITEM_IQC~".~"INSPECT_BAD_LOT_QTY~",   
         ~"IQ_ITEM_IQC~".~"INSPECT_LOT_QTY~",   
         ~"IQ_ITEM_IQC~".~"ARRIVAL_QTY~",   
         ~"IQ_ITEM_IQC~".~"DESTROY_QTY~",   
         ~"IQ_ITEM_IQC~".~"ARRIVAL_DATE~"  
  FROM ~"IQ_ITEM_IQC~",   
         ~"ID_ITEM~"  
   WHERE ( ~"IQ_ITEM_IQC~".~"ITEM_CODE~" = ~"ID_ITEM~".~"ITEM_CODE~"(+) ) and  
         ( ~"IQ_ITEM_IQC~".~"ORGANIZATION_ID~" = ~"ID_ITEM~".~"ORGANIZATION_ID~"(+) ) and  
         ( ~"IQ_ITEM_IQC~".~"INSPECT_DATE~" >= :ARG_DATESET ) AND  
         ( ~"IQ_ITEM_IQC~".~"INSPECT_DATE~"  < :ARG_DATEEND+1 ) AND  
         ( ~"IQ_ITEM_IQC~".~"ITEM_CODE~" LIKE :ARG_ITEM_CODE ) AND  
         ( ~"IQ_ITEM_IQC~".~"IQC_INSPECT_NO~" LIKE :ARG_SLIP_NO ) AND  
         ( ~"IQ_ITEM_IQC~".~"ORGANIZATION_ID~" = :ARG_ORG )    
" update="IQ_ITEM_IQC" updatewhere=0 updatekeyinplace=no arguments=(("ARG_DATESET", datetime),("ARG_DATEEND", datetime),("ARG_ITEM_CODE", string),("ARG_SLIP_NO", string),("ARG_ORG", number))  sort="inspect_date A inspect_sequence A " )
