 retrieve="  select inspect_group, 
         inspect_group_desc, 
         display_seq, 
         inspection_item, 
         inspection_item_type, 
         inspection_value_lcl, 
         inspection_value_ucl, 
         inspection_value_std, 
         inspection_unit,
         use_flag,  
         last_modify_date, 
         last_modify_by, 
         enter_date, 
         enter_by,
         organization_id, 
         inspection_item_seq, 
         sample_qty
    from iqc_inspection_template
   where inspect_group like :arg_group  
     and organization_id = :arg_org_id

" update="iqc_inspection_template" updatewhere=1 updatekeyinplace=no arguments=(("arg_group", string),("arg_org_id", number))  sort="inspect_group A display_seq A inspection_item_seq A " )
