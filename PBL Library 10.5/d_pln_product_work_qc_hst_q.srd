 column=(type=char(0) updatewhereclause=yes name=check_yn dbname="check_yn" values="	Y/	N" )
 column=(type=char(10) update=yes updatewhereclause=yes name=repair_result_code dbname="ip_product_work_qc.repair_result_code" )
 column=(type=number updatewhereclause=yes name=tat_time dbname="tat_time" )
 column=(type=char(30) update=yes updatewhereclause=yes name=item_code dbname="ip_product_work_qc.item_code" )
 column=(type=char(100) updatewhereclause=yes name=model_name dbname="ip_product_work_qc.model_name" )
 column=(type=char(50) updatewhereclause=yes name=model_suffix dbname="ip_product_work_qc.model_suffix" )
 column=(type=char(100) update=yes updatewhereclause=yes name=location_code dbname="ip_product_work_qc.location_code" )
 column=(type=char(10) updatewhereclause=yes name=repair_workstage_code dbname="ip_product_work_qc.repair_workstage_code" )
 column=(type=char(10) updatewhereclause=yes name=repair_line_code dbname="ip_product_work_qc.repair_line_code" )
 column=(type=char(1) updatewhereclause=yes name=bad_cause_by dbname="ip_product_work_qc.bad_cause_by" )
 column=(type=char(10) updatewhereclause=yes name=work_order_no dbname="work_order_no" )
 column=(type=char(30) updatewhereclause=yes name=run_no dbname="run_no" )
 column=(type=char(20) updatewhereclause=yes name=magazine_no dbname="magazine_no" )
 column=(type=char(4000) updatewhereclause=yes name=wip_state dbname="wip_state" )
 column=(type=char(50) updatewhereclause=yes name=ip_product_work_qc_lcr_measure dbname="ip_product_work_qc.lcr_measure" )
 column=(type=char(4000) updatewhereclause=yes name=aoi_result dbname="aoi_result" )
 column=(type=char(10) updatewhereclause=yes name=repair_method dbname="ip_product_work_qc.repair_method" )
 retrieve="  SELECT ~"IP_PRODUCT_WORK_QC~".~"QC_SEQUENCE~",   
         ~"IP_PRODUCT_WORK_QC~".~"LINE_CODE~",   
         ~"IP_PRODUCT_WORK_QC~".~"WORKSTAGE_CODE~",   
         ~"IP_PRODUCT_WORK_QC~".~"SERIAL_NO~",   
         ~"IP_PRODUCT_WORK_QC~".~"QC_RESULT~",   
         ~"IP_PRODUCT_WORK_QC~".~"BAD_REASON_CODE~",   
         ~"IP_PRODUCT_WORK_QC~".~"BAD_QTY~",   
         ~"IP_PRODUCT_WORK_QC~".~"CHARGER~",   
         ~"IP_PRODUCT_WORK_QC~".~"REPAIR_BY~",   
         ~"IP_PRODUCT_WORK_QC~".~"QC_DATE~",   
         ~"IP_PRODUCT_WORK_QC~".~"REPAIR_DATE~",   
         ~"IP_PRODUCT_WORK_QC~".~"QC_INSPECT_HANDLING~",   
         ~"IP_PRODUCT_WORK_QC~".~"COMMENTS~",   
         ~"IP_PRODUCT_WORK_QC~".~"ORGANIZATION_ID~",   
         ~"IP_PRODUCT_WORK_QC~".~"ENTER_DATE~",   
         ~"IP_PRODUCT_WORK_QC~".~"ENTER_BY~",   
         ~"IP_PRODUCT_WORK_QC~".~"LAST_MODIFY_DATE~",   
         ~"IP_PRODUCT_WORK_QC~".~"LAST_MODIFY_BY~",   
         ~"IP_PRODUCT_WORK_QC~".~"SHIFT_CODE~",   
         ~"IP_PRODUCT_WORK_QC~".~"DEFECT_QTY~",   
         ~"IP_PRODUCT_WORK_QC~".~"RECEIPT_DEFICIT~",   
         ~"IP_PRODUCT_WORK_QC~".~"MACHINE_CODE~",   
         '' check_yn,   
         ~"IP_PRODUCT_WORK_QC~".~"REPAIR_RESULT_CODE~",   
         (nvl(REPAIR_DATE, sysdate) - qc_date ) * 24 TAT_TIME,   
         ~"IP_PRODUCT_WORK_QC~".~"ITEM_CODE~",   

         ~"IP_PRODUCT_WORK_QC~".~"MODEL_NAME~" MODEL_NAME,   
         ~"IP_PRODUCT_WORK_QC~".~"MODEL_SUFFIX~" MODEL_SUFFIX,    
         ~"IP_PRODUCT_WORK_QC~".~"LOCATION_CODE~",   
         ~"IP_PRODUCT_WORK_QC~".~"REPAIR_WORKSTAGE_CODE~",   
         ~"IP_PRODUCT_WORK_QC~".~"REPAIR_LINE_CODE~" ,
         ~"IP_PRODUCT_WORK_QC~".~"BAD_CAUSE_BY~" ,
         (
          SELECT WORK_ORDER_NO
            FROM IP_PRODUCT_2D_BARCODE
          WHERE SERIAL_NO=  ~"IP_PRODUCT_WORK_QC~".~"SERIAL_NO~"
         ) WORK_ORDER_NO,
         (
          SELECT RUN_NO
            FROM IP_PRODUCT_2D_BARCODE
          WHERE SERIAL_NO=  ~"IP_PRODUCT_WORK_QC~".~"SERIAL_NO~"
         ) RUN_NO,
         (
          SELECT MAGAZINE_NO
            FROM IP_PRODUCT_2D_BARCODE
          WHERE SERIAL_NO=  ~"IP_PRODUCT_WORK_QC~".~"SERIAL_NO~"
         ) MAGAZINE_NO,
         (
           f_get_wip_state_by_serial(~"IP_PRODUCT_WORK_QC~".~"SERIAL_NO~")
        ) WIP_STATE,
         ~"IP_PRODUCT_WORK_QC~".~"LCR_MEASURE~" , 
        F_GET_AOI_RESULT_BY_PID(~"IP_PRODUCT_WORK_QC~".~"SERIAL_NO~", ~"IP_PRODUCT_WORK_QC~".~"REPAIR_DATE~")   aoi_result,
          ~"IP_PRODUCT_WORK_QC~".~"REPAIR_METHOD~" 
    FROM ~"IP_PRODUCT_WORK_QC~",   
         ~"ID_ITEM~"  
   WHERE ( ip_product_work_qc.item_code = id_item.item_code (+)) and  
         ( ip_product_work_qc.organization_id = id_item.organization_id (+)) and  
         ( ( ~"IP_PRODUCT_WORK_QC~".~"MODEL_NAME~" like :ARG_MODEL_NAME ) AND  
         ( ~"IP_PRODUCT_WORK_QC~".~"SERIAL_NO~" like :ARG_SERIAL_NO ) AND  
         ( ~"IP_PRODUCT_WORK_QC~".~"LINE_CODE~" like :ARG_LINE_CODE ) AND  
         ( ~"IP_PRODUCT_WORK_QC~".~"QC_DATE~" >= :ARG_DATESET ) AND  
         ( ~"IP_PRODUCT_WORK_QC~".~"QC_DATE~" < :ARG_DATEEND +1 ) AND  
         ( ~"IP_PRODUCT_WORK_QC~".~"RECEIPT_DEFICIT~" like :ARG_DEFICIT ) AND  
         ( ~"IP_PRODUCT_WORK_QC~".~"QC_INSPECT_HANDLING~" like :ARG_INSPECT_HANDLING ) AND  
         ( nvl(~"IP_PRODUCT_WORK_QC~".~"REPAIR_RESULT_CODE~",'*') like :ARG_REPAIR_RESULT_CODE ) AND  
         ( ~"IP_PRODUCT_WORK_QC~".~"ORGANIZATION_ID~" = :ARG_ORG ) )    
" arguments=(("ARG_MODEL_NAME", string),("ARG_SERIAL_NO", string),("ARG_LINE_CODE", string),("ARG_DATESET", datetime),("ARG_DATEEND", datetime),("ARG_DEFICIT", string),("ARG_INSPECT_HANDLING", string),("ARG_REPAIR_RESULT_CODE", string),("ARG_ORG", number))  sort="receipt_deficit A qc_inspect_handling A qc_sequence A " )
