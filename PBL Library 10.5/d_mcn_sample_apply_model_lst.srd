table(column=(type=char(30) update=yes updatewhereclause=yes key=yes name=sample_code dbname="imcn_sample_apply_model.sample_code" )
 column=(type=char(30) update=yes updatewhereclause=yes key=yes name=sample_lot_no dbname="imcn_sample_apply_model.sample_lot_no" )
 column=(type=char(30) update=yes updatewhereclause=yes key=yes name=item_code dbname="imcn_sample_apply_model.item_code" )
