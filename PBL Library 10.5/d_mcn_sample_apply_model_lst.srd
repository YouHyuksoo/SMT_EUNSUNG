 column=(type=char(30) update=yes updatewhereclause=yes name=apply_smt_model_name dbname="imcn_sample_apply_model.apply_smt_model_name" )
 retrieve="  SELECT ~"IMCN_SAMPLE_APPLY_MODEL~".~"SAMPLE_CODE~",   
              ~"IMCN_SAMPLE_APPLY_MODEL~".~"SAMPLE_LOT_NO~",   
              ~"IMCN_SAMPLE_APPLY_MODEL~".~"ITEM_CODE~",   
              ~"IMCN_SAMPLE_APPLY_MODEL~".~"ORGANIZATION_ID~",   
              ~"IMCN_SAMPLE_APPLY_MODEL~".~"ENTER_BY~",   
              ~"IMCN_SAMPLE_APPLY_MODEL~".~"ENTER_DATE~",   
              ~"IMCN_SAMPLE_APPLY_MODEL~".~"LAST_MODIFY_BY~",   
              ~"IMCN_SAMPLE_APPLY_MODEL~".~"LAST_MODIFY_DATE~",   
              ~"IMCN_SAMPLE_APPLY_MODEL~".~"APPLY_SMT_MODEL_NAME~"  
    FROM ~"IMCN_SAMPLE_APPLY_MODEL~"  
   WHERE ( ~"IMCN_SAMPLE_APPLY_MODEL~".~"SAMPLE_CODE~"             = :arg_sample_code ) AND  
              ( ~"IMCN_SAMPLE_APPLY_MODEL~".~"SAMPLE_LOT_NO~"          = :arg_sample_lot_no ) AND  
              ( ~"IMCN_SAMPLE_APPLY_MODEL~".~"ORGANIZATION_ID~" = :arg_org )    
" update="IMCN_SAMPLE_APPLY_MODEL" updatewhere=0 updatekeyinplace=no arguments=(("arg_sample_code", string),("arg_sample_lot_no", string),("arg_org", number))  sort="item_code A apply_smt_model_name A " )
