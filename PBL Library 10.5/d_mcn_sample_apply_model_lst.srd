 column=(type=char(20) update=yes updatewhereclause=yes name=enter_by dbname="imcn_sample_apply_model.enter_by" )
 column=(type=datetime update=yes updatewhereclause=yes name=enter_date dbname="imcn_sample_apply_model.enter_date" )
