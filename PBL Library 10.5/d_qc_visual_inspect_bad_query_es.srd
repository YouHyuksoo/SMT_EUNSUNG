 column=(type=char(20) updatewhereclause=yes name=iq_product_wqc_model_name dbname="iq_product_wqc_model_name" )
 column=(type=char(20) updatewhereclause=yes name=iq_product_wqc_item_code dbname="iq_product_wqc_item_code" )
 column=(type=char(20) updatewhereclause=yes name=id_item_item_name dbname="id_item_item_name" )
 column=(type=number updatewhereclause=yes name=inspect_bad_qty dbname="inspect_bad_qty" )
 retrieve="SELECT IQ_PRODUCT_WQC.MODEL_NAME MODEL_NAME,
			IQ_PRODUCT_WQC.ITEM_CODE ITEM_CODE,
			F_GET_LINE_NAME (IQ_PRODUCT_WQC.LINE_CODE,
			IQ_PRODUCT_WQC.ORGANIZATION_ID)	LINE_CODE,
			f_get_code_master ('VISUAL BAD REASON CODE', IQ_PRODUCT_WQC.BAD_REASON_CODE,:ARG_LANG,:ARG_ORG)	BAD_REASON_CODE,
			1      INSPECT_BAD_QTY,
			ID_ITEM.ITEM_NAME ITEM_NAME
  FROM IQ_PRODUCT_WQC, ID_ITEM
 WHERE     IQ_PRODUCT_WQC.ITEM_CODE = ID_ITEM.ITEM_CODE(+)
       AND IQ_PRODUCT_WQC.ORGANIZATION_ID = ID_ITEM.ORGANIZATION_ID(+)
       AND IQ_PRODUCT_WQC.MODEL_NAME LIKE :ARG_MODEL_NAME
       AND IQ_PRODUCT_WQC.LINE_CODE LIKE :ARG_LINE_CODE
       AND INSPECT_DATE >= trunc(:ARG_DATESET)
       AND INSPECT_DATE < trunc(:ARG_DATEEND + 1 ) " arguments=(("ARG_MODEL_NAME", string),("ARG_LINE_CODE", string),("ARG_DATESET", datetime),("ARG_DATEEND", datetime),("ARG_LANG", string),("ARG_ORG", number))  sort="line_code A iq_product_wqc_model_name A iq_product_wqc_item_code A " )
group(level=1 header.height=0 trailer.height=36 by=("line_code" ) header.color="536870912" trailer.color="12632256" )
