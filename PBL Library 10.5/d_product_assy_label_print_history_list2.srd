 column=(type=datetime updatewhereclause=yes name=enter_date dbname="ip_product_pack_master.enter_date" )
 column=(type=char(20) updatewhereclause=yes name=enter_by dbname="ip_product_pack_master.enter_by" )
 column=(type=datetime updatewhereclause=yes name=last_modify_date dbname="ip_product_pack_master.last_modify_date" )
 column=(type=char(20) updatewhereclause=yes name=last_modify_by dbname="ip_product_pack_master.last_modify_by" )
 retrieve="select  pack_date, 
          pack_barcode, 
          pack_type, 
          pack_qty, 
          line_code, 
          workstage_code, 
          run_no,
          model_name, 
          part_no, 
          attr1, 
          attr2, 
          attr3, 
          attr4, 
          attr5, 
          attr6, 
          attr7, 
          attr8, 
          organization_id, 
          enter_date, 
          enter_by, 
          last_modify_date, 
          last_modify_by
  from IP_PRODUCT_PACK_MASTER
 where run_no             like :ARG_RUN_NO
     and organization_id = :ARG_ORG_ID
   order by pack_date, pack_barcode
" update="IP_PRODUCT_PACK_MASTER" updatewhere=0 updatekeyinplace=no arguments=(("ARG_RUN_NO", string),("ARG_ORG_ID", number))  sort="model_name A " )
