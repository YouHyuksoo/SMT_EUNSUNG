 column=(type=char(20) updatewhereclause=yes name=last_modify_by dbname="iqc_inspection_time_check.last_modify_by" )
 retrieve="    SELECT A.INSPECTION_DATE,
                A.LINE_CODE,
                A.WORK_ORDER_NO,

                A.INSPECT_GROUP,
                A.INSPECT_GROUP_DESC,
                A.INSPECTION_ITEM_SEQ                                               AS INSPECTION_ITEM_SEQ,
                A.INSPECTION_ITEM,
                A.ORGANIZATION_ID,
                
                A.INSPECTION_VALUE_LCL                                              AS INSPECTION_VALUE_LCL,
                A.INSPECTION_VALUE_UCL                                              AS INSPECTION_VALUE_UCL,
                A.INSPECTION_UNIT                                                       AS INSPECTION_UNIT,
                
                A.CHECK_TIME                                                               AS CHECK_TIME,
                A.INSPECTION_BY                                                          AS INSPECTION_BY,

                A.INSPECTION_VALUE                                                    AS VALUE,
                A.INSPECTION_RESULT                                                  AS RESULT,
                A.LAST_MODIFY_DATE                                                   AS LAST_MODIFY_DATE,
                A.LAST_MODIFY_BY                                                       AS LAST_MODIFY_BY

    FROM IQC_INSPECTION_TIME_CHECK A
 
     WHERE A.ORGANIZATION_ID          = :arg_org_id
       AND A.INSPECTION_DATE            between :arg_sdate and :arg_edate
       AND A.line_CODE                        like :arg_line_code
       AND A.INSPECT_GROUP_DESC     like :arg_model_name
       AND A.WORK_ORDER_NO            like :arg_work_order
       AND A.INSPECTION_YN               = 'Y'        
       AND A.INSPECTION_RESULT        like :arg_result
" update="IQC_INSPECTION_TIME_CHECK" updatewhere=0 updatekeyinplace=yes arguments=(("arg_org_id", number),("arg_sdate", datetime),("arg_edate", datetime),("arg_line_code", string),("arg_model_name", string),("arg_work_order", string),("arg_result", string))  sort="inspection_date A work_order_no A inspection_item_seq A check_time A " )
