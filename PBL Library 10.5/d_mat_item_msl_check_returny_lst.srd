footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(50) updatewhereclause=yes name=im_item_receipt_barcode_lot_no dbname="lot_no" )
 column=(type=char(50) updatewhereclause=yes name=im_item_receipt_barcode_item_barcode dbname="im_item_receipt_barcode.item_barcode" dbalias="b.item_barcode" )
 column=(type=char(20) updatewhereclause=yes name=im_item_receipt_barcode_supplier_code dbname="im_item_receipt_barcode.supplier_code" dbalias="b.supplier_code" )
 column=(type=char(20) updatewhereclause=yes name=im_item_receipt_barcode_item_code dbname="im_item_receipt_barcode.item_code" dbalias="b.item_code" )
 column=(type=char(300) updatewhereclause=yes name=id_item_item_name dbname="id_item.item_name" dbalias="m.item_name" )
 column=(type=number updatewhereclause=yes name=im_item_receipt_barcode_new_scan_qty dbname="im_item_receipt_barcode.new_scan_qty" dbalias="b.new_scan_qty" )
 column=(type=datetime updatewhereclause=yes name=im_item_receipt_barcode_issue_compare_date dbname="im_item_receipt_barcode.issue_compare_date" dbalias="b.issue_compare_date" )
 column=(type=datetime updatewhereclause=yes name=im_item_receipt_barcode_feeding_date dbname="im_item_receipt_barcode.feeding_date" dbalias="b.feeding_date" )
 column=(type=char(10) updatewhereclause=yes name=id_item_msl_level dbname="id_item.msl_level" dbalias="m.msl_level" )
 column=(type=number updatewhereclause=yes name=id_item_msl_max_time dbname="id_item.msl_max_time" dbalias="m.msl_max_time" )
 column=(type=number updatewhereclause=yes name=passed_time dbname="passed_time" )
 column=(type=number updatewhereclause=yes name=reamin_time dbname="reamin_time" )
 column=(type=number updatewhereclause=yes name=passed_rate dbname="passed_rate" )
 column=(type=number updatewhereclause=yes name=pre_passed_time dbname="pre_passed_time" )
 column=(type=number updatewhereclause=yes name=cur_passed_time dbname="cur_passed_time" )
 column=(type=number updatewhereclause=yes name=im_item_receipt_barcode_scan_qty dbname="im_item_receipt_barcode.scan_qty" dbalias="b.scan_qty" )
 column=(type=char(4000) updatewhereclause=yes name=line_name dbname="line_name" )
 column=(type=char(4000) updatewhereclause=yes name=workstage_name dbname="workstage_name" )
 column=(type=char(200) updatewhereclause=yes name=id_item_part_no dbname="id_item.part_no" dbalias="m.part_no" )
 column=(type=char(1000) updatewhereclause=yes name=feeding_model dbname="im_item_receipt_barcode.feeding_model" dbalias="b.feeding_model" )
 column=(type=datetime updatewhereclause=yes name=msl_open_date dbname="im_item_receipt_barcode.msl_open_date" dbalias="b.msl_open_date" )
 column=(type=datetime updatewhereclause=yes name=first_line_input_date dbname="first_line_input_date" )
 retrieve="select /*+ index (b INDXIM_ITEM_RECEIPT_BARCODE4 )*/
         b.lot_no, 
         b.item_barcode,
         b.supplier_code,
         b.item_code,  
         m.item_name,
         b.new_scan_qty,
         b.issue_compare_date,
         b.feeding_date,
         m.MSL_level, 
         m.MSL_MAX_TIME, 
         trunc( nvl(F_GET_MSL_PASSED_TIME(b.item_barcode),0), 2)                                                      passed_time, 
         (m.MSL_MAX_TIME - trunc( nvl(F_GET_MSL_PASSED_TIME(b.item_barcode),0), 2) )                    reamin_time,  
         trunc( nvl(F_GET_MSL_PASSED_TIME(b.item_barcode),0) / m.msl_max_time * 100 ,2)                 passed_rate,    
          trunc(round(nvl(b.msl_passed_time ,0)) ,2)                                                                               pre_passed_time, 
         round((sysdate - nvl(msl_open_date, sysdate)) * (24),0)                                                             cur_passed_time,
         b.scan_qty,
         f_get_line_name(b.LINE_CODE, 1) line_name,
         f_get_workstage_name(b.WORKSTAGE_CODE) workstage_name,
         m.part_no ,
		b.FEEDING_MODEL , 
 		b.MSL_OPEN_DATE ,
         (              
           select min(check_date)
             from ib_smt_checkhist
           where lot_no =  b.lot_no
               and check_type in ( '1', '2' )
               and check_status = 'P'
         ) first_line_input_date
  from im_item_receipt_barcode b,
          id_item                 m
 where b.item_code = m.item_code
     and b.organization_id = m.organization_id
     and b.item_code like :arg_item_code
     and b.issue_compare_yn   = 'Y'      
     and b.organization_id = :arg_org_id            
     and b.issue_compare_date >= to_date('20160901','YYYYMMDD')
     and NVL(b.reel_destroy_yn,'N') <> 'Y'
     and b.feeding_yn   = 'N'                       
      and m.msl_level    >= :arg_msl_level
     and trunc( nvl(F_GET_MSL_PASSED_TIME(b.item_barcode),0) / m.msl_max_time * 100 ,2)  >= :arg_passed_rate
     and b.LINE_CODE in (
                                    select line_code
                                      from ip_product_line
                                    where line_division  = 'D'
                                        and mes_display_yn = 'Y'
                          )
 order by trunc( nvl(F_GET_MSL_PASSED_TIME(b.item_barcode),0), 2) desc , b.issue_compare_date DESC
" arguments=(("arg_item_code", string),("arg_msl_level", string),("arg_passed_rate", number),("arg_org_id", number)) )
