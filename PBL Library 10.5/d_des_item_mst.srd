         ~"ID_ITEM~".~"ENTER_DATE~",   
         ~"ID_ITEM~".~"LAST_MODIFY_DATE~",   
         ~"ID_ITEM~".~"BARCODE~",   
         ~"ID_ITEM~".~"ENTER_BY~",   
         ~"ID_ITEM~".~"LAST_MODIFY_BY~",   
         ~"ID_ITEM~".~"SAFETY_INVENTORY~",   
         ~"ID_ITEM~".~"ORDER_RULE~",   
         ~"ID_ITEM~".~"ORDER_CYCLE~",   
         ~"ID_ITEM~".~"ABC_GRADE~",   
         ~"ID_ITEM~".~"RAW_MATERIAL~",   
         ~"ID_ITEM~".~"SVC_CODE~",   
         ~"ID_ITEM~".~"SPECIAL_PROPERTY~",    
         ~"ID_ITEM~".~"LENGTH~",   
         ~"ID_ITEM~".~"HEIGHT~",   
         ~"ID_ITEM~".~"WEIGHT~",   
         ~"ID_ITEM~".~"CAPACITY~",   
         ~"ID_ITEM~".~"DENSITY~",   
         ~"ID_ITEM~".~"INNER_DIAMETER~",   
         ~"ID_ITEM~".~"OUTER_DIAMETER~",   
         ~"ID_ITEM~".~"GRADIENT~",   
         ~"ID_ITEM~".~"LAYER~",   
         ~"ID_ITEM~".~"MANUFACTURE_LEADTIME~",   
         ~"ID_ITEM~".~"WORK_BAD_RATE~",   
         ~"ID_ITEM~".~"DATESET~",   
         ~"ID_ITEM~".~"DATEEND~",   
         ~"ID_ITEM~".~"WIDTH~",   
         ~"ID_ITEM~".~"DRAWING_NO~",   
         ~"ID_ITEM~".~"ITEM_DIVISION~",   
         ~"ID_ITEM~".~"PART_NO~",   
         ~"ID_ITEM~".~"HS_CODE~",   
         ~"ID_ITEM~".~"ISSUE_PACKING_QTY~",   
         ~"ID_ITEM~".~"TRANSFER_UOM~",   
         ~"ID_ITEM~".~"HS_NAME~",   
         ~"ID_ITEM~".~"HS_NAME_SALE~",   
         ~"ID_ITEM~".~"HS_SPEC~",   
         ~"ID_ITEM~".~"HS_CODE_SCRAP~",   
         ~"ID_ITEM~".~"HS_NAME_SCRAP~",   
         ~"ID_ITEM~".~"HS_SPEC_SCRAP~",   
         ~"ID_ITEM~".~"ROUTE_NO~",   
         ~"ID_ITEM~".~"TRANSFER_YN~",   
         ~"ID_ITEM~".~"LINE_CODE~",   
         ~"ID_ITEM~".~"TARIFF_RATE~",   
         ~"ID_ITEM~".~"SUPPLIER_CODE~",   
         ~"ID_ITEM~".~"CUSTOMER_CODE~",   
         ~"ID_ITEM~".~"MODEL_NAME~",   
         ~"ID_ITEM~".~"MODEL_SUFFIX~",   
         ~"ID_ITEM~".~"AUTO_ISSUE_YN~",   
         ~"ID_ITEM~".~"AUTO_RECEIPT_YN~",   
         ~"ID_ITEM~".~"AUTO_ISSUE_PLAN_YN~",   
         ~"ID_ITEM~".~"BUY_PRICE~",   
         ~"ID_ITEM~".~"SALE_PRICE~",   
         ~"ID_ITEM~".~"SALE_PRICE_APPLY_TYPE~",   
         ~"ID_ITEM~".~"GROSS_WEIGHT~",   
         ~"ID_ITEM~".~"CBM~",   
         ~"ID_ITEM~".~"VIRTUAL_RECEIPT_YN~",   
         ~"ID_ITEM~".~"MES_DISPLAY_YN~",   
         ~"ID_ITEM~".~"LOCATION_ADDRESS~",   
         ~"ID_ITEM~".~"MATERIAL_QTY~",   
         ~"ID_ITEM~".~"MATERIAL_QTY2~",   
         ~"ID_ITEM~".~"MATERIAL_QTY3~",   
         ~"ID_ITEM~".~"MSL_LEVEL~",   
         ~"ID_ITEM~".~"CHECK_SUPPLIER_BARCODE~",   
         ~"ID_ITEM~".~"MSL_MAX_TIME~",   
         ~"ID_ITEM~".~"LIFE_CYCLE~",   
         ~"ID_ITEM~".~"COMMENTS~",   
         ~"ID_ITEM~".~"RECEIPT_LOT_CHECK_YN~",   
         ~"ID_ITEM~".~"SOLDER_TYPE~",   
         ~"ID_ITEM~".~"FEEDER_SIZE~",
         nvl(~"ID_ITEM~".~"KEYITEM_YN~",'N') KEYITEM_YN,
         ~"ID_ITEM~".~"VENDOR_CODE1~",
         ~"ID_ITEM~".~"VENDOR_CODE2~",
         ~"ID_ITEM~".~"VENDOR_CODE3~" ,
		PCB_COATING_TYPE,
	    PCB_COATING_MAX_DAY ,
		 ~"ID_ITEM~".~"CUSTOMER_PART_NO~",
	    PCB_WORKING_MAX_DAY ,
		BAKING_TIME,
         ~"ID_ITEM~".~"BAKING_TEMPERATURE~" 
    FROM ~"ID_ITEM~"  
   WHERE ( ~"ID_ITEM~".~"ITEM_CODE~" = :ARG_item_code ) AND  
         ( ~"ID_ITEM~".~"ORGANIZATION_ID~" = :arg_org )    
" update="ID_ITEM" updatewhere=0 updatekeyinplace=yes arguments=(("ARG_item_code", string),("arg_org", number)) )
