event modified;call super::modified;long lvl_break_value , lvl_hit_value 
Datetime lvdt_clean_date
Decimal lvf_min_tension , lvf_max_tension

lvs_jig_lot_no = this.text 

em_break_value.text = ''
em_hit_value.text = ''
sle_jig_code.text = ''

//============================================
//
//============================================
select break_value , hit_value , jig_code , min_tension , max_tension , line_code , use_status , TENSION_CHECK_YN
  into :lvl_break_value , :lvl_hit_value , :lvs_jig_code , :lvf_min_tension , :lvf_max_tension , :lvs_line_code , :lvs_use_status , :LVS_TENSION_CHECK_YN
 from imcn_jig 
where jig_lot_no = :lvs_jig_lot_no 
    and jig_type = 'M'
    and organization_id = :gvi_organization_id ;
	 
if f_sql_check() < 0 then
	return 
end if 

if  isnull(lvf_min_tension) or isnull(lvf_max_tension) then 
	sle_barcode.text = ''
	f_msg("$$HEX24$$50d158c1200021ce15c8200030ae00c912ac74c720002000f8bbf1b45db81cb42000c8b9a4c26cd0200085c7c8b2e4b2$$ENDHEX$$",'P')	
	sle_barcode.setfocus()
	return 
end if 


//========================================
// $$HEX17$$74c7f8bb200080acacc020001bbc40c770ac74ba2000acc780ac200088bd00ac2000$$ENDHEX$$
//========================================
if LVS_TENSION_CHECK_YN ='Y' and lvs_use_status = 'U' then 
	f_msg("$$HEX28$$50d158c1200021ce15c82000f1b45db81cb42000c8b9a4c26cd0200085c7c8b2e4b22000acc780acacc0200088bd00ac200069d5c8b2e4b2$$ENDHEX$$.",'P')		
	return 
	
end if 

em_max.text =string(lvf_min_tension)
em_min.text = string( lvf_max_tension)

select max(jig_check_date)
  into :lvdt_clean_date
 from imcn_jig_mask_check
where jig_lot_no = :lvs_jig_lot_no 
    and clean_yn = 'Y'
    and organization_id = :gvi_organization_id ;
	 
if f_sql_check() < 0 then
	return 
end if 

if lvs_jig_code = '' or isnull(lvs_jig_code) then 
	f_msg("$$HEX15$$f8bbf1b45db82000c8b9a4c26cd0200014bc54cfdcb4200085c7c8b2e4b2$$ENDHEX$$",'P')
	sle_barcode.text = ''
	sle_barcode.setfocus( )
	return 
end if 

st_last_clean_date.text = ''
st_last_clean_date.text = string( lvdt_clean_date )

em_break_value.text = string( lvl_break_value )
em_hit_value.text = string( lvl_hit_value ) 

if  lvl_break_value < lvl_hit_value then 
	
	f_msg("$$HEX14$$5cd5c4ac200018c285ba44c7200008cdfcac200088d5b5c2c8b2e4b2$$ENDHEX$$",'P')
	st_status.text =  f_msg("$$HEX14$$5cd5c4ac200018c285ba44c7200008cdfcac200088d5b5c2c8b2e4b2$$ENDHEX$$",'S')
	
end if 

// IVI JIG $$HEX3$$bdacb0c62000$$ENDHEX$$tension$$HEX5$$d0c5200000b35cd52000$$ENDHEX$$MIN $$HEX6$$12ac44c7200030ae74c82000$$ENDHEX$$0.4$$HEX3$$d0c51cc12000$$ENDHEX$$0.5$$HEX7$$5cb8200018c215c85cd5e4b22000$$ENDHEX$$---------

String lvs_max, lvs_min

SELECT nvl(max(code_name),'0'), nvl(min(code_name),'0')
   INTO :lvs_max, :lvs_min
  FROM ISYS_BASECODE
WHERE CODE_TYPE = 'METALMASK_SPEC';
	
if f_sql_check() < 0 then
   return 
end if 

if (left(lvs_jig_code,3) = 'IVI') then
    	em_max.text = lvs_max	
    em_min.text = '0.5'
else
   	em_max.text = lvs_max	
    em_min.text = lvs_min
end if	
//------------------------------------------------------------------------------------

sle_jig_code.text = lvs_jig_code 
dw_1.retrieve(  lvs_jig_lot_no , gvi_organization_id, uo_dateset.text() , uo_dateend.text()  )

f_play_sound("cleancheck.wav")

end event

