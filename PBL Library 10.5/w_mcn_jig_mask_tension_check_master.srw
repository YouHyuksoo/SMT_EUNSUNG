event ue_data_control;call super::ue_data_control;
string lvs_date
double LVDB_RCV_ISS_SEQ
choose case gvs_ue_data_control
		
	case 'RETRIEVE'
		
	
			dw_1.reset()
			dw_1.retrieve(  sle_barcode.text+'%' , gvi_organization_id, uo_dateset.text() , uo_dateend.text() )

			sle_barcode.setfocus()
	

    case 'INSERT'
		
			lvl_ROW = dw_1.INSERTROW(0)
			dw_1.SCROLLTOROW(lvl_ROW)
			F_SET_SECURITY_ROW(dw_1 , lvl_ROW ,'ALL')
			
//              if dw_1.getrow() < 1 then 
//		    else
//				dw_1.SETITEM( ROW , 'JIG_CODE' , dw_1.object.jig_code[dw_1.getrow()] )
//				dw_1.SETITEM( ROW , 'JIG_LOT_NO' , dw_1.object.JIG_LOT_NO[dw_1.getrow()] )	
//				dw_1.SETITEM( ROW , 'JIG_CHECK_DATE' , F_SYSDATE() )			
//				dw_1.SETITEM( ROW , 'USED_QTY' , dw_1.object.break_value[dw_1.getrow()]  )		
//				dw_1.SETITEM( ROW , 'ACTUAL_VALUE' ,dw_1.object.hit_value[dw_1.getrow()])		
//				
//			end if
			sle_barcode.setfocus()
	case 'APPEND'		
			
//			ROW = dw_1.INSERTROW(dw_1.GETROW())
//			dw_1.SCROLLTOROW(ROW)
//			F_SET_SECURITY_ROW(dw_1 , ROW ,'ALL')
//			
//			
//              if dw_1.getrow() < 1 then 
//		    else
//				dw_1.SETITEM( ROW , 'JIG_CODE' , dw_1.object.jig_code[dw_1.getrow()] )
//				dw_1.SETITEM( ROW , 'JIG_LOT_NO' , dw_1.object.JIG_LOT_NO[dw_1.getrow()] )
//				dw_1.SETITEM( ROW , 'JIG_CHECK_DATE' , F_SYSDATE() )		
//				dw_1.SETITEM( ROW , 'USED_QTY' , dw_1.object.break_value[dw_1.getrow()]  )		
//				dw_1.SETITEM( ROW , 'ACTUAL_VALUE' ,dw_1.object.hit_value[dw_1.getrow()])						
//				
//			end if
			sle_barcode.setfocus()
	case 'DELETE'
		
		  	if dw_1.AcceptText() = -1 then
				return
			end if
			
			MSG = F_MSGBOX(1003)  //$$HEX8$$adc01cc858d5dcc2a0acb5c2c8b24cae$$ENDHEX$$?
			IF MSG = 1 THEN
				Gvl_row_deleted = dw_1.GetRow()			
				dw_1.DELETEROW(Gvl_row_deleted)		
				dw_1.SetFocus()
				lvl_ROW = dw_1.GetRow()
				dw_1.ScrollToRow(lvl_ROW)
				dw_1.SetColumn(1)
			END IF		 
			sle_barcode.setfocus()
   case 'UPDATE'
		
			IF dw_1.UPDATE() < 0  THEN
			  	 ROLLBACK;
				 RETURN
			ELSE
				 COMMIT;
				 F_MSG_MDI_HELP( "Update Complete" )//$$HEX14$$31c1f5ac01c83cc75cb8200000c8a5c7200018b4c8c5b5c2c8b2e4b2$$ENDHEX$$"			 
			END IF
			sle_barcode.setfocus()
	case else
end choose

end event

event open;call super::open;
String lvs_max, lvs_min

SELECT nvl(max(code_name),'0'), nvl(min(code_name),'0')
   INTO :lvs_max, :lvs_min
  FROM ISYS_BASECODE
WHERE CODE_TYPE = 'METALMASK_SPEC';
	
if f_sql_check() < 0 then
   return 
end if 

em_max.text = lvs_max	
 em_min.text = lvs_min

end event

