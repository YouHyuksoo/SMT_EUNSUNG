event clicked;call super::clicked;
//===============================================================
// $$HEX16$$85c725b812ac74c72000e4b22000e4b4b4c5200054c694b2c0c9200055d678c7$$ENDHEX$$
//===============================================================

if ( TRIM(sle_barcode.text) = '' OR TRIM(sle_jig_code.text) = '' ) then   
	
	messagebox("$$HEX4$$50d158c121ce15c8$$ENDHEX$$", "$$HEX18$$54bac8d0c8b9a4c26cd0200014bc54cfdcb47cb9200085c725b8200014bc8db7c8b2e4b2$$ENDHEX$$!")
	
else	
	
	if ( st_clean_status.text= '$$HEX2$$00b330ae$$ENDHEX$$...') then
		messagebox("$$HEX4$$50d158c121ce15c8$$ENDHEX$$", "$$HEX12$$adccb0acc1c0dcd07cb9200055d678c7200058d538c194c6$$ENDHEX$$!")
		return
	end if
	
	if ( st_visual_status.text= '$$HEX2$$00b330ae$$ENDHEX$$...') then
		messagebox("$$HEX4$$50d158c121ce15c8$$ENDHEX$$", "$$HEX12$$78c600adc1c0dcd07cb9200055d678c7200058d538c194c6$$ENDHEX$$!")
		return
	end if
	
	if ( st_tension_status.text= '$$HEX2$$00b330ae$$ENDHEX$$...') then
		messagebox("$$HEX4$$50d158c121ce15c8$$ENDHEX$$", "$$HEX14$$50d158c1200021ce15c812ac44c7200055d678c7200058d538c194c6$$ENDHEX$$! ( A->E $$HEX6$$1cc25cb8200085c725b82000$$ENDHEX$$)")
		return
	else
		
		if ( TRIM(sle_tension1.text) = '' OR TRIM(sle_tension2.text) = '' OR TRIM(sle_tension3.text) = '' OR TRIM(sle_tension4.text) = ''  )  then 
	
	         messagebox("$$HEX4$$50d158c121ce15c8$$ENDHEX$$", "$$HEX22$$50d158c121ce15c8200012ace4b474c72000a8ba50b42000e4b4b4c5200024c6c0c920004ac5b5c2c8b2e4b2$$ENDHEX$$, $$HEX7$$55d678c7200014bc8db7c8b2e4b2$$ENDHEX$$!")
	
        else
	
  	         wf_inspect_result()
	
        end if
		
	end if    

end if

end event

