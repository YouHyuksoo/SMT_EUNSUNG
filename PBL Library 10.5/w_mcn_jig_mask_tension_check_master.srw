global w_mcn_jig_mask_tension_check_master w_mcn_jig_mask_tension_check_master

type variables
string lvs_jig_lot_no
STRING lvs_clean_yn , lvs_jig_code , lvs_line_code , lvs_use_status , LVS_TENSION_CHECK_YN
Long lvl_row, lvl_time_start
end variables

forward prototypes
public function integer wf_inspect_result ()
end prototypes

public function integer wf_inspect_result ();//===============================================================
//
//===============================================================
if st_clean_status.text = 'OK' and  st_visual_status.text = 'OK' and  st_tension_status.text = 'OK' then 

				
				if  st_clean_status.text = 'OK' then 
					 lvs_clean_yn = 'Y'
				else
					lvs_clean_yn = 'N' 
				end if 
				
				f_insert()
				
				dw_1.object.jig_check_date[lvl_row] = f_sysdate()
				dw_1.object.jig_lot_no[lvl_row] = sle_barcode.text
				dw_1.object.jig_code[lvl_row] = lvs_jig_code
				dw_1.object.jig_check_sequence[lvl_row] = f_get_sequence('SEQ_JIG_CHECK_SEQUENCE')
				dw_1.object.clean_yn[lvl_row] = lvs_clean_yn
				dw_1.object.jig_check_status[lvl_row] = 'P' //PASS
				
				dw_1.object.tension_check1[lvl_row]  = Dec(sle_tension1.text )
				dw_1.object.tension_check2[lvl_row]  = Dec(sle_tension2.text )
				dw_1.object.tension_check3[lvl_row]  = Dec(sle_tension3.text )
				dw_1.object.tension_check4[lvl_row]  = Dec(sle_tension4.text )
				dw_1.object.tension_check5[lvl_row]  = Dec(sle_tension5.text )
				
				dw_1.object.tension_check1_ext[lvl_row]  = Dec(sle_tension1_ext.text )
				dw_1.object.tension_check2_ext[lvl_row]  = Dec(sle_tension2_ext.text )
				dw_1.object.tension_check3_ext[lvl_row]  = Dec(sle_tension3_ext.text )
				dw_1.object.tension_check4_ext[lvl_row]  = Dec(sle_tension4_ext.text )
				dw_1.object.tension_check5_ext[lvl_row]  = Dec(sle_tension5_ext.text )				
				dw_1.object.tension_check6_ext[lvl_row]  = Dec(sle_tension6_ext.text )				
				
				dw_1.object.break_value[lvl_row]  = Dec(em_break_value.text )
				dw_1.object.hit_value[lvl_row]  = Dec(em_hit_value.text )				
				dw_1.object.max_tension[lvl_row]    =  0
				
				if dw_1.update() < 0 then 
					rollback ;
					return -1
				else
					
					//$$HEX5$$acc0a9c600aca5b22000$$ENDHEX$$
					//$$HEX16$$7cb778c7200054cfdcb494b220008cd618c2200018b4c8c53cc7c0bb5cb82000$$ENDHEX$$* $$HEX6$$5cb8200008cd30ae54d62000$$ENDHEX$$
					update imcn_jig 
					     set use_status = 'U'  ,  last_inspect_date = sysdate , line_code = '*' , TENSION_CHECK_YN = 'Y'
					 where jig_lot_no = :lvs_jig_lot_no
					    and jig_type = 'M' 
					    and organization_id = :gvi_organization_id ; 
					
					if f_sql_check() < 0 then 
						return  -1
					end if 
					commit ;
					
					sle_tension1.text = ''
					sle_tension2.text = ''
					sle_tension3.text = ''
					sle_tension4.text = ''
					sle_tension5.text = ''
					
					sle_tension1_ext.text = ''
					sle_tension2_ext.text = ''
					sle_tension3_ext.text = ''
					sle_tension4_ext.text = ''
					sle_tension5_ext.text = ''					
					sle_tension6_ext.text = ''							
					
					sle_commnets.text = ''
					sle_barcode.text = ''
					sle_tension1.backcolor = rgb(255,255,255)
					sle_tension2.backcolor = rgb(255,255,255)
					sle_tension3.backcolor = rgb(255,255,255)
					sle_tension4.backcolor = rgb(255,255,255)
					sle_tension5.backcolor = rgb(255,255,255)
					
					sle_tension1_ext.backcolor = rgb(255,255,255)
					sle_tension2_ext.backcolor = rgb(255,255,255)
					sle_tension3_ext.backcolor = rgb(255,255,255)
					sle_tension4_ext.backcolor = rgb(255,255,255)
					sle_tension5_ext.backcolor = rgb(255,255,255)					
					sle_tension6_ext.backcolor = rgb(255,255,255)								
				
					st_tension_status.backcolor = 0
					st_visual_status.backcolor = 0
					st_clean_status.backcolor = 0
					
					st_clean_status.text = 'WAIT...'
					st_visual_status.text = 'WAIT...'	
					st_tension_status.text = 'WAIT...' 
					st_tension_ext_status.text = 'WAIT...' 					
					st_status.text = f_msg("$$HEX11$$15c8c1c0200098ccacb9200018b4c8c5b5c2c8b2e4b2$$ENDHEX$$",'S')
					sle_barcode.text = ''
					sle_barcode.setfocus( )
					f_play_sound("$$HEX2$$69d5a9ac$$ENDHEX$$.wav")
					
				end if 

else
				if  st_clean_status.text = 'OK' then 
					 lvs_clean_yn = 'Y'
				else
					lvs_clean_yn = 'N' 
				end if 
					
				//=============================================
				//
				//=============================================
				
				f_insert()
				
				dw_1.object.jig_check_date[lvl_row] = f_sysdate()
				dw_1.object.jig_lot_no[lvl_row] = sle_barcode.text
				dw_1.object.jig_code[lvl_row] = lvs_jig_code
				dw_1.object.jig_check_sequence[lvl_row] =  f_get_sequence('SEQ_JIG_CHECK_SEQUENCE')
				dw_1.object.clean_yn[lvl_row] = lvs_clean_yn
				dw_1.object.jig_check_status[lvl_row] = 'N'
				dw_1.object.comments[lvl_row] =sle_commnets.text
				
				dw_1.object.tension_check1[lvl_row]  = Dec(sle_tension1.text )
				dw_1.object.tension_check2[lvl_row]  = Dec(sle_tension2.text )
				dw_1.object.tension_check3[lvl_row]  = Dec(sle_tension3.text )
				dw_1.object.tension_check4[lvl_row]  = Dec(sle_tension4.text )
				dw_1.object.tension_check5[lvl_row]  = Dec(sle_tension5.text )
				
				dw_1.object.tension_check1_ext[lvl_row]  = Dec(sle_tension1_ext.text )
				dw_1.object.tension_check2_ext[lvl_row]  = Dec(sle_tension2_ext.text )
				dw_1.object.tension_check3_ext[lvl_row]  = Dec(sle_tension3_ext.text )
				dw_1.object.tension_check4_ext[lvl_row]  = Dec(sle_tension4_ext.text )
				dw_1.object.tension_check5_ext[lvl_row]  = Dec(sle_tension5_ext.text )				
				dw_1.object.tension_check6_ext[lvl_row]  = Dec(sle_tension6_ext.text )								
	
				
				dw_1.object.break_value[lvl_row]  = Dec(em_break_value.text )
				dw_1.object.hit_value[lvl_row]  = Dec(em_hit_value.text )
				
				
				dw_1.object.max_tension[lvl_row]    =  0
				
				if dw_1.update() < 0 then 
					rollback ;
				else
					
					//$$HEX5$$acc0a9c611c9c0c92000$$ENDHEX$$
					update imcn_jig set use_status = 'S' , last_inspect_date = sysdate ,  line_code = '*' ,  TENSION_CHECK_YN = 'Y', receipt_date = sysdate, issue_date = NULL
					where jig_lot_no = :lvs_jig_lot_no
						 and jig_type = 'M' 
						and organization_id = :gvi_organization_id ; 
					
					if f_sql_check() < 0 then 
						return -1
					end if 
					
					commit ;
					
					sle_tension1.text = ''
					sle_tension2.text = ''
					sle_tension3.text = ''
					sle_tension4.text = ''
					sle_tension5.text = ''
					
					sle_tension1_ext.text = ''
					sle_tension2_ext.text = ''
					sle_tension3_ext.text = ''
					sle_tension4_ext.text = ''
					sle_tension5_ext.text = ''					
					sle_tension6_ext.text = ''					
					
					sle_barcode.text = ''
					sle_tension1.backcolor = rgb(255,255,255)
					sle_tension2.backcolor = rgb(255,255,255)
					sle_tension3.backcolor = rgb(255,255,255)
					sle_tension4.backcolor = rgb(255,255,255)
					sle_tension5.backcolor = rgb(255,255,255)
					
					sle_tension1_ext.backcolor = rgb(255,255,255)
					sle_tension2_ext.backcolor = rgb(255,255,255)
					sle_tension3_ext.backcolor = rgb(255,255,255)
					sle_tension4_ext.backcolor = rgb(255,255,255)
					sle_tension5_ext.backcolor = rgb(255,255,255)					
					sle_tension6_ext.backcolor = rgb(255,255,255)								
					
					
					st_tension_status.backcolor = 0
					st_visual_status.backcolor = 0
					st_clean_status.backcolor = 0
					
					sle_commnets.text = ''
					st_clean_status.text = 'WAIT...'
					st_visual_status.text = 'WAIT...'	
					st_tension_status.text = 'WAIT...' 
					st_tension_ext_status.text = 'WAIT...' 
					st_status.text = f_msg("$$HEX11$$14bec9b7200098ccacb9200018b4c8c5b5c2c8b2e4b2$$ENDHEX$$",'S')
					sle_barcode.text = ''
					sle_barcode.setfocus( )
					f_play_sound("$$HEX3$$88bd69d5a9ac$$ENDHEX$$.wav")
				end if 

end if 


end function

