 column=(type=char(1) updatewhereclause=yes name=label_type dbname="im_item_receipt_barcode.label_type" dbalias="C.label_type" )
 column=(type=char(1) updatewhereclause=yes name=receipt_type dbname="im_item_receipt_barcode.receipt_type" dbalias="C.receipt_type" )
 column=(type=char(10) updatewhereclause=yes name=feeder_location_code dbname="id_item.feeder_location_code" dbalias=".feeder_location_code" )
