 column=(type=char(10) updatewhereclause=yes name=workstage_code dbname="id_item.workstage_code" dbalias=".workstage_code" )
 column=(type=char(20) updatewhereclause=yes name=location_address dbname="id_item.location_address" dbalias="B.location_address" )
 column=(type=char(20) updatewhereclause=yes name=location_code dbname="id_item.location_code" dbalias=".location_code" )
