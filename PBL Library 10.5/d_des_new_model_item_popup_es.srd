detail(height=76 color="536870912" )
table(column=(type=char(30) updatewhereclause=yes name=item_code dbname="ip_product_model_master.item_code" )
 column=(type=char(100) updatewhereclause=yes name=model_name dbname="ip_product_model_master.model_name" )
 column=(type=char(50) updatewhereclause=yes name=model_suffix dbname="ip_product_model_master.model_suffix" )
 column=(type=char(100) updatewhereclause=yes name=customer_name dbname="ip_product_model_master.customer_name" )
 column=(type=char(100) updatewhereclause=yes name=part_no dbname="ip_product_model_master.part_no" )
 retrieve="    
 select item_code, 
          model_name, 
          model_suffix, 
          customer_name, 
          part_no
  from ip_product_model_master
 where item_code       like :arg_item ||'%'
     and organization_id =   :arg_org_id
   order by 1 desc

" arguments=(("arg_item", string),("arg_org_id", number)) )
