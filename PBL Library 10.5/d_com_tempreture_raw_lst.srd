 column=(type=number updatewhereclause=yes name=max_temp_value dbname="imcn_machine.max_temp_value" dbalias=".max_temp_value" )
 column=(type=number updatewhereclause=yes name=min_humidity_value dbname="imcn_machine.min_humidity_value" dbalias=".min_humidity_value" )
 column=(type=number updatewhereclause=yes name=max_humidity_value dbname="imcn_machine.max_humidity_value" dbalias=".max_humidity_value" )
 retrieve="  SELECT ~"ICOM_TEMPERATURE_RAW~".~"ORGANIZATION_ID~",   
         ~"ICOM_TEMPERATURE_RAW~".~"GATHER_DATE~",   
         ~"ICOM_TEMPERATURE_RAW~".~"GW_ID~",   
         ~"ICOM_TEMPERATURE_RAW~".~"NODEID~",   
         ~"ICOM_TEMPERATURE_RAW~".~"LQI~",   
         ~"ICOM_TEMPERATURE_RAW~".~"CHILD_CNT~",   
         ~"ICOM_TEMPERATURE_RAW~".~"NODETYPE~",   
         ~"ICOM_TEMPERATURE_RAW~".~"BATT~",   
         ~"ICOM_TEMPERATURE_RAW~".~"ROOM_TEMPERATURE~",   
         ~"ICOM_TEMPERATURE_RAW~".~"HUMIDITY~",   
         ~"ICOM_TEMPERATURE_RAW~".~"DEW_POINT~",   
         ~"ICOM_TEMPERATURE_RAW~".~"SD4~",   
         ~"ICOM_TEMPERATURE_RAW~".~"ATTRIBUTE01~",   
         ~"ICOM_TEMPERATURE_RAW~".~"ATTRIBUTE02~",   
         ~"ICOM_TEMPERATURE_RAW~".~"ATTRIBUTE03~",   
         ~"ICOM_TEMPERATURE_RAW~".~"ATTRIBUTE04~",   
         ~"ICOM_TEMPERATURE_RAW~".~"ATTRIBUTE05~",   
         ~"ICOM_TEMPERATURE_RAW~".~"ENTER_BY~",   
         ~"ICOM_TEMPERATURE_RAW~".~"ENTER_DATE~",   
         ~"ICOM_TEMPERATURE_RAW~".~"LAST_MODIFY_BY~",   
         ~"ICOM_TEMPERATURE_RAW~".~"LAST_MODIFY_DATE~",   
         ~"IMCN_MACHINE~".~"MACHINE_NAME~",   
         ~"IMCN_MACHINE~".~"MIN_TEMP_VALUE~",   
         ~"IMCN_MACHINE~".~"MAX_TEMP_VALUE~",   
         ~"IMCN_MACHINE~".~"MIN_HUMIDITY_VALUE~",   
         ~"IMCN_MACHINE~".~"MAX_HUMIDITY_VALUE~"  
    FROM ~"ICOM_TEMPERATURE_RAW~",   
         ~"IMCN_MACHINE~"  
   WHERE ( icom_temperature_raw.nodeid = imcn_machine.machine_code (+)) and  
         ( ( UPPER(~"ICOM_TEMPERATURE_RAW~".~"NODEID~") = :arg_nodeid ) AND  
         ( ~"ICOM_TEMPERATURE_RAW~".~"GATHER_DATE~" >= :arg_dateset ) AND  
         ( ~"ICOM_TEMPERATURE_RAW~".~"GATHER_DATE~" < :arg_dateend+1 ) AND  
         ( ~"ICOM_TEMPERATURE_RAW~".~"ORGANIZATION_ID~" = :arg_org ) )    AND

         ( 
             ( 
                'NG' = :arg_ng AND (
                                                ~"IMCN_MACHINE~".~"MIN_TEMP_VALUE~"  > ~"ICOM_TEMPERATURE_RAW~".~"ROOM_TEMPERATURE~" OR
                                                ~"IMCN_MACHINE~".~"MAX_TEMP_VALUE~"  < ~"ICOM_TEMPERATURE_RAW~".~"ROOM_TEMPERATURE~" OR
                                                ~"IMCN_MACHINE~".~"MIN_HUMIDITY_VALUE~" > ~"ICOM_TEMPERATURE_RAW~".~"HUMIDITY~" OR
                                                ~"IMCN_MACHINE~".~"MAX_HUMIDITY_VALUE~" < ~"ICOM_TEMPERATURE_RAW~".~"HUMIDITY~"
                                             )
             )
             or
              'NG' <> :arg_ng
      
         )  

" arguments=(("arg_nodeid", string),("arg_dateset", datetime),("arg_dateend", datetime),("arg_org", number),("arg_ng", string))  sort="nodeid A gather_date D " )
