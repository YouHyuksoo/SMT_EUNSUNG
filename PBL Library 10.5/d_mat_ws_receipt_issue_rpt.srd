footer(height=0 color="536870912" )
detail(height=68 color="553648127~tif (  mod( getrow() , 2 ) = 0 , rgb(240,240,240) , rgb(255,255,255))" )
table(column=(type=char(1) updatewhereclause=yes name=rcv_iss_code dbname="id_item.rcv_iss_code" )
 column=(type=number updatewhereclause=yes name=receipt_issue_sequence dbname="id_item.receipt_issue_sequence" )
 column=(type=datetime updatewhereclause=yes name=receipt_issue_date dbname="id_item.receipt_issue_date" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=organization_id dbname="id_item.organization_id" )
 column=(type=char(1) updatewhereclause=yes name=receipt_issue_deficit dbname="id_item.receipt_issue_deficit" )
 column=(type=number updatewhereclause=yes name=qty dbname="id_item.qty" )
 column=(type=char(20) update=yes updatewhereclause=yes key=yes name=item_code dbname="id_item.item_code" )
 column=(type=char(300) updatewhereclause=yes name=item_name dbname="id_item.item_name" )
 column=(type=char(300) updatewhereclause=yes name=item_spec dbname="id_item.item_spec" )
 column=(type=char(3) updatewhereclause=yes name=item_uom dbname="id_item.item_uom" )
 column=(type=datetime updatewhereclause=yes name=enter_date dbname="id_item.enter_date" )
 column=(type=char(20) updatewhereclause=yes name=location_address dbname="id_item.location_address" )
 retrieve="SELECT A.RCV_ISS_CODE ,
			A.RECEIPT_ISSUE_SEQUENCE,   
			A.RECEIPT_ISSUE_DATE,   
			A.ORGANIZATION_ID,   
			A.RECEIPT_ISSUE_DEFICIT,   
			
			A.QTY,   
			A.ITEM_CODE  ,
			B.ITEM_NAME,
			B.ITEM_SPEC,
			B.ITEM_UOM   ,
			A.ENTER_DATE ,
			B.LOCATION_ADDRESS 
 FROM 
(

  SELECT 'R' RCV_ISS_CODE ,
         RECEIPT_SEQUENCE RECEIPT_ISSUE_SEQUENCE,   
         RECEIPT_DATE           RECEIPT_ISSUE_DATE,   
         ORGANIZATION_ID,   
         RECEIPT_DEFICIT        RECEIPT_ISSUE_DEFICIT,   
    
         RECEIPT_QTY               QTY,   
     
         ITEM_CODE  ,
		ENTER_DATE

    FROM IM_ITEM_WORKSTAGE_RECEIPT   
WHERE RECEIPT_DATE >=:ARG_DATESET
      AND RECEIPT_DATE < :ARG_DATEEND +1
      AND ITEM_CODE LIKE :ARG_ITEM
      AND ORGANIZATION_ID = :ARG_ORG

UNION  ALL

  SELECT  'I' RCV_ISS_CODE ,
         ISSUE_SEQUENCE  RECEIPT_ISSUE_SEQUENCE,   
         ISSUE_DATE                 RECEIPT_ISSUE_DATE,   
         ORGANIZATION_ID,   
         ISSUE_DEFICIT            RECEIPT_ISSUE_DEFICIT,   
   
         ISSUE_QTY                   QTY,   
 
         ITEM_CODE  ,
         ENTER_DATE 
  
    FROM IM_ITEM_WORKSTAGE_ISSUE  
 WHERE ISSUE_DATE >= :ARG_DATESET
      AND ISSUE_DATE <  :ARG_DATEEND  +1
      AND ITEM_CODE LIKE :ARG_ITEM
      AND ORGANIZATION_ID = :ARG_ORG 
)   A , ID_ITEM B 
WHERE A.ITEM_CODE = B.ITEM_CODE
  AND A.RCV_ISS_CODE LIKE :arg_deficit
" update="ID_ITEM" updatewhere=0 updatekeyinplace=no arguments=(("arg_dateset", datetime),("arg_dateend", datetime),("arg_item", string),("arg_lot_no", string),("arg_line_code", string),("arg_workstage_code", string),("arg_deficit", string),("arg_supplier_code", string),("arg_from_supplier_code", string),("arg_location_code", string),("arg_supplier_issue", string),("arg_issue_deficit", string),("arg_etc_line", stringlist),("arg_org", number),("arg_keyitem_yn", string),("arg_inventory_type", string))  sort="organization_id A enter_date A receipt_issue_date D receipt_issue_sequence D " )
