HA$PBExportHeader$f_user_role_check.srf
global type f_user_role_check from function_object
end type

forward prototypes
global function boolean f_user_role_check (string arg_menu_text, string arg_window_name)
end prototypes

global function boolean f_user_role_check (string arg_menu_text, string arg_window_name);

long li_check
string arg_win_name , lvs_open_yn	
arg_win_name = upper(arg_window_name)

//=========================================================
// $$HEX17$$54ba74b285ba6dce44c7200008c7c4b3b0c6200024c185ba3cc75cb82000f1b45db8$$ENDHEX$$
//=========================================================
IF GVS_LANGUAGE = 'C' THEN 
	
	UPDATE ISYS_WINDOW
			SET  WINDOW_DESCRIPTION_LOCAL  = :arg_menu_text
	WHERE WINDOW_NAME = :arg_win_name
		 AND ORGANIZATION_ID = :GVI_ORGANIZATION_ID ;
		 
ELSEIF GVS_LANGUAGE = 'E' THEN
	
	UPDATE ISYS_WINDOW
			SET WINDOW_DESCRIPTION_ENG  = :arg_menu_text
	WHERE WINDOW_NAME = :arg_win_name
		 AND ORGANIZATION_ID = :GVI_ORGANIZATION_ID ;
		 
ELSEIF GVS_LANGUAGE = 'K' THEN
	
	UPDATE ISYS_WINDOW
			SET  WINDOW_DESCRIPTION_KOR = :arg_menu_text
	WHERE WINDOW_NAME = :arg_win_name
		 AND ORGANIZATION_ID = :GVI_ORGANIZATION_ID ;	
		 
END IF
	 
IF F_SQL_CHECK() < 0 THEN 
	MESSAGEBOX("Error" , 'Menu Message Update Error' )
ELSE
	COMMIT ;
END IF


return true



