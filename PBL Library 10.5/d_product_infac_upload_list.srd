 retrieve="SELECT DT_IF, 
            CD_SL, 
            CD_ITEM, 
            YN_PROCESS, 
            DC_ERRORMSG, 
            QT_IM, 
            DTS_CREATE, 
            TRANSFER_DATE, 
            TRANSFER_YN
  FROM ESEAI_M107_TEMP
WHERE DT_IF                =      TO_CHAR( :ARG_DT_IF, 'YYYYMMDD')
    AND  CD_SL              LIKE  :ARG_CD_SL
    AND  CD_ITEM          LIKE  :ARG_CD_ITEM
    AND  TRANSFER_YN  LIKE :ARG_TRANSFER_YN
" update="ESEAI_M107_TEMP" updatewhere=1 updatekeyinplace=no arguments=(("ARG_DT_IF", datetime),("ARG_CD_SL", string),("ARG_CD_ITEM", string),("ARG_TRANSFER_YN", string))  sort="dt_if A dts_create A cd_sl A cd_item A " )
