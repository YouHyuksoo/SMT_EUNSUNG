header(height=128 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(10) updatewhereclause=yes name=line_code dbname="ip_product_run_card.line_code" )
 column=(type=datetime updatewhereclause=yes name=run_date dbname="ip_product_run_card.run_date" )
 column=(type=char(30) updatewhereclause=yes key=yes name=run_no dbname="ip_product_run_card.run_no" )
 column=(type=char(100) updatewhereclause=yes name=model_name dbname="ip_product_run_card.model_name" )
 column=(type=char(30) updatewhereclause=yes name=item_code dbname="ip_product_run_card.item_code" )
 column=(type=number updatewhereclause=yes name=lot_size dbname="ip_product_run_card.lot_size" )
 column=(type=number updatewhereclause=yes key=yes name=organization_id dbname="ip_product_run_card.organization_id" )
 retrieve="
   select line_code, run_date, run_no, model_name, item_code, lot_size, organization_id
        from ip_product_run_card
       where run_date = :arg_run_date
         and line_code like :arg_line_code
         and line_code in (
                            select line_code
                              from ip_product_line
                             where line_division   = 'D'
                               and organization_id = :arg_org
                          )
         and organization_id = :arg_org
       order by line_code, run_date, run_no
" update="ip_product_run_card" updatewhere=0 updatekeyinplace=no arguments=(("arg_run_date", datetime),("arg_line_code", string),("arg_org", number))  sort="run_no A " )
